#!/usr/bin/env bash
# Folder trust for the claude harness. Harness specific on purpose: the file it
# reads and the flag it sets belong to claude and to nothing else.
#
# Usage:
#   reeve-trust --check <repo-path>     exit 0 if trusted, 1 if not, 2 if unknown
#   reeve-trust --grant <repo-path>     record trust, after backing the file up
#   reeve-trust --root-for <repo-path>  print the trusted root it sits under,
#                                       exit 0 if one, 1 if none
#   reeve-trust --roots                 the trusted roots, as resolved, then each
#                                       skipped line as `skipped <line> (<why>)`
#   reeve-trust --list
#
# Why this exists. A directory claude has not been trusted for raises a full
# screen "Is this a project you created or one you trust?" dialog that no
# permission setting suppresses. A hand cannot answer it, so it sits there
# looking exactly like a hand that is thinking. Measured: trust resolves to the
# git REPOSITORY, not the directory, so every worktree of a trusted repository
# inherits it and every worktree of an untrusted one stalls.
#
# Granting is never automatic, save under a root the liege named. This writes
# to the liege's own global claude configuration, so it is a command they run
# knowingly, once per repository. Or once per root: config/trusted-roots in the
# reeve home lists absolute paths, one per line, `#` comments and blank lines
# ignored, and reeve-dispatch grants trust itself for a repository whose main
# working tree is that path or under it. No file, no roots. Compared on real
# paths, a whole path component at a time, so /a/b2 is not under /a/b.
# Measured on claude 2.1.308: claude itself does not honour a trusted ancestor,
# a repository under one still raises the dialog, so the grant is per repository
# either way.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"

CFG="${CLAUDE_CONFIG:-$HOME/.claude.json}"

# canon_path <dir> -> the directory's real path in its on-disk case. Symlinks
# and `..` are resolved, then each component is matched against its parent's
# listing, so a root typed /users/yong on case-insensitive APFS compares equal
# to the path git reports for a repository under /Users/yong.
canon_path() {
  python3 - "$1" <<'PY'
import os,sys
p=os.path.realpath(sys.argv[1])
if not os.path.isdir(p): sys.exit(1)
cur='/'
for comp in [c for c in p.split('/') if c]:
    try: names=os.listdir(cur)
    except OSError: names=[]
    if comp not in names:
        m=[n for n in names if n.casefold()==comp.casefold()]
        if len(m)==1: comp=m[0]
    cur=os.path.join(cur,comp)
print(cur)
PY
}

# trusted_roots_scan -> one line per usable line of config/trusted-roots:
# `root <real path>`, or `skipped <line> (<reason>)`. A line that cannot be
# compared honestly is skipped, and says why. A root that is / or the home
# directory, or any ancestor of it, is too broad: it would trust everything.
trusted_roots_scan() {
  local f line r home
  f=$(config_file trusted-roots)
  [ -f "$f" ] || return 0
  home=$(canon_path "${HOME:-/nonexistent-home}" 2>/dev/null) || home=''
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line#"${line%%[![:space:]]*}"}; line=${line%"${line##*[![:space:]]}"}
    case $line in ''|'#'*) continue ;; esac
    case $line in
      *[[:space:]]'#'*) printf 'skipped %s (inline comment: comments take a line of their own)\n' "$line"; continue ;;
      /*) ;;
      *) printf 'skipped %s (not an absolute path)\n' "$line"; continue ;;
    esac
    r=$(canon_path "$line" 2>/dev/null) || { printf 'skipped %s (not a directory)\n' "$line"; continue; }
    case $r in
      /) printf 'skipped %s (too broad: it is /)\n' "$line"; continue ;;
    esac
    if [ -n "$home" ]; then
      case $home in
        "$r"|"${r%/}"/*) printf 'skipped %s (too broad: it is the home directory or above it)\n' "$line"; continue ;;
      esac
    fi
    printf 'root %s\n' "$r"
  done < "$f"
}

# trusted_roots -> the usable roots only, one per line.
trusted_roots() { trusted_roots_scan | sed -n 's/^root //p'; }

mode=${1:-}; target=${2:-}
case $mode in
  --check|--grant|--root-for)
    [ -n "$target" ] || die "$mode needs a repository path"
    [ -d "$target" ] || die "no such directory: $target"
    # trust follows the repository, so resolve to its toplevel first. A linked
    # worktree's own --show-toplevel names that worktree, not the repository:
    # claude keys the trust dialog to the main working tree instead, the one
    # whose .git is a real directory. --git-common-dir always points at that
    # directory's .git, worktree or not, so its parent is the path claude
    # actually recorded.
    common=$(git -C "$target" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
    if [ -n "$common" ]; then
      target=$(cd "$(dirname "$common")" && pwd)
    else
      target=$(cd "$target" && pwd)
    fi
    ;;
  --list) ;;
  --roots) trusted_roots_scan | sed -e 's/^root //' ; exit 0 ;;
  *) print_help "$0"; exit 0 ;;
esac

if [ "$mode" = --root-for ]; then
  real=$(canon_path "$target") || exit 1
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    case $real in "$r"|"${r%/}"/*) printf '%s\n' "$r"; exit 0 ;; esac
  done <<ROOTS_EOF
$(trusted_roots)
ROOTS_EOF
  exit 1
fi

[ -f "$CFG" ] || { [ "$mode" = --check ] && exit 2; die "no claude config at $CFG"; }

case $mode in
  --list)
    python3 - "$CFG" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))
for p,v in sorted(d.get('projects',{}).items()):
    print(f"  {str(v.get('hasTrustDialogAccepted')):5}  {p}")
PY
    ;;

  --check)
    python3 - "$CFG" "$target" <<'PY'
import json,sys
cfg,repo=sys.argv[1],sys.argv[2]
try: d=json.load(open(cfg))
except Exception: sys.exit(2)
v=d.get('projects',{}).get(repo)
if v is None: sys.exit(1)
sys.exit(0 if v.get('hasTrustDialogAccepted') is True else 1)
PY
    rc=$?
    case $rc in
      0) info "trusted: $target" ;;
      1) printf 'NOT TRUSTED: %s\n' "$target" >&2
         printf 'Every hand dispatched into a worktree of this repository will stall on a\n' >&2
         printf 'folder trust dialog it cannot answer. Fix it once, either way:\n' >&2
         printf '  reeve-trust --grant %s\n' "$target" >&2
         printf '  or open the repository in claude yourself and accept the prompt\n' >&2 ;;
    esac
    exit $rc
    ;;

  --grant)
    # ~/.claude.json is read, edited and written back whole. Two grants at once
    # each start from the same file, and the second to land drops the first
    # repository's trust silently: the dispatch that depended on it then stalls
    # at a dialog no permission setting can suppress.
    TRUST_LOCK=$(lock_acquire trust) || exit 1
    trap 'lock_release "$TRUST_LOCK"' EXIT
    bak="$CFG.reeve-backup.$(date +%Y%m%d%H%M%S)"
    cp "$CFG" "$bak" || die "could not back up $CFG"
    # Written via a temp file and rename so an interrupted write cannot leave
    # the liege with a truncated claude configuration.
    python3 - "$CFG" "$target" "$bak" <<'PY' || die "grant failed; $CFG unchanged, backup at $bak"
import json,sys,os
cfg,repo,bak=sys.argv[1],sys.argv[2],sys.argv[3]
with open(cfg) as f: d=json.load(f)
projects=d.setdefault('projects',{})
entry=projects.setdefault(repo,{})
before=entry.get('hasTrustDialogAccepted')
entry['hasTrustDialogAccepted']=True
tmp=cfg+'.reeve.tmp'
with open(tmp,'w') as f: json.dump(d,f,indent=2)
os.replace(tmp,cfg)
print(f"  {repo}")
print(f"  hasTrustDialogAccepted: {before} -> True")
print(f"  backup: {bak}")
PY
    info "granted. hands can now work in worktrees of this repository"
    ;;
esac
