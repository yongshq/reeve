#!/usr/bin/env bash
# This reeve's short name, which labels every hand it sends out.
#
# Usage:
#   reeve-name               print this session's name, assigning one if it has none
#   reeve-name claim <Name>  take the name a handoff recorded, on resuming it
#   reeve-name set <Name>    the liege's rename
#
# A name comes from, in order: one already stored for this session, then
# $REEVE_NAME, then the session this same pane ran before /clear replaced it,
# then the first name in the pool no live reeve on this home holds. The pool is
# built in, or config/reeve-names, one per line. A name is letters and hyphens,
# a letter first, at most 12.
#
# claim, set and $REEVE_NAME all refuse a name a live reeve on another pane
# holds: two reeves under one name would label their hands alike. A holder is
# live while its heartbeat is fresh and its pane, if it recorded one, still
# runs a harness. On refusal, retry once the holder has gone rather than take a
# pool name silently; $REEVE_NAME just falls through to the pool, with a
# warning.
#
# Inside herdr or tmux, every form also labels the reeve's own workspace or
# window with the name, unless another live reeve already holds it, and never
# from inside a hand. A pane is its id plus its server's socket.
#
# The session id stays the identity everywhere. A name is what the liege reads.
#
# Exit: 0 named, 1 refused or no session id.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"

case ${1:-} in -h|--help) print_help "$0"; exit 0 ;; esac

# This session is doing something, so it is demonstrably still here. What the
# caretaker reads to tell a reeve that is gone from one that is merely quiet.
session_touch

s=$(reeve_session)
[ -n "$s" ] || die "this session has no id, so it cannot hold a name. set REEVE_SESSION to name a reeve on a harness that exports none"

# label_group <name>   label this reeve's own workspace or window with its
# name, the group its hands will open inside. Presentation only, so a backend
# that cannot is said once and ignored: the name is the answer here.
#
# Not from a hand: dispatch marks one with REEVE_HAND, and the workspace it sits
# in is its reeve's. Not outside a backend's own session either (no HERDR_ENV,
# no TMUX): there is no workspace of its own to label, and making one at every
# session start left an empty one behind each time. Dispatch makes it then.
label_group() {
  local bin b
  [ -z "${REEVE_HAND:-}" ] || return 0
  [ "${HERDR_ENV:-}" = 1 ] || [ -n "${TMUX:-}" ] || return 0
  bin=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  if ! b=$("$bin/reeve-backend" resolve 2>/dev/null); then
    warn "no backend resolved, so no workspace was labelled $1"
  elif ! reeve_group "$bin" "$b" "$1" >/dev/null; then
    warn "backend '$b' gave $1 no group, so its hands will open on their own"
  fi
}

cmd=${1:-}
case $cmd in
  '')
    n=$(reeve_name)
    [ -n "$n" ] || die "could not assign a name, check $(session_dir "$s")"
    label_group "$n"
    info "$n" ;;
  claim|set)
    want=${2:-}
    [ -n "$want" ] || die "which name? usage: reeve-name $cmd <Name>"
    valid_reeve_name "$want" \
      || die "bad name '$want': letters and hyphens, a letter first, at most 12"
    lk=$(lock_acquire names 15 "$(config_get lock-stale 10)") || exit 1
    trap 'lock_release "$lk"' EXIT
    if rival=$(name_live_elsewhere "$want" "$(reeve_pane)" "$s"); then
      # A holder that crashed lets go once its pane closes or falls back to a
      # shell, or its heartbeat is session-stale old. Retrying keeps the name;
      # running bare takes a new one for good, which is the liege's call.
      die "'$want' is held by live reeve $rival on another pane. if that reeve is gone, retry reeve-name $cmd $want once its pane is closed, or within $(config_get session-stale 900)s of its last heartbeat. a new name from the pool (reeve-name, bare) only if the liege agrees"
    fi
    # claim takes back a name a handoff recorded, so a group this session made
    # under another name is let go and claim finds the one its name kept. set
    # renames this reeve, so it keeps its group, relabelled now inside herdr or
    # tmux and at the next dispatch outside them, never a second one.
    [ "$cmd" = claim ] && [ "$(session_name "$s")" != "$want" ] && rm -f "$(session_dir "$s")"/group.*
    name_store "$s" "$want" || die "could not write $(session_dir "$s")/name"
    pane_store "$s"
    lock_release "$lk"; trap - EXIT
    # The workspace label follows the name now, not at the next dispatch.
    label_group "$want"
    info "$want" ;;
  *) die "unknown command '$cmd'. try: reeve-name, reeve-name claim <Name>, reeve-name set <Name>" ;;
esac
