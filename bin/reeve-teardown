#!/usr/bin/env bash
# Clean up a finished errand. Single owner of the landed-work test.
#
# Usage:
#   reeve-teardown <id> [--drop-branch] [--dismiss-only] [--dry-run]
#   reeve-teardown <id> --drop-proven [--dry-run]
#   reeve-teardown --prove-landed <holding> <branch>
#   reeve-teardown --delete-proven <holding> <branch>
#   reeve-teardown --sweep <holding> [--onto <branch>] [--dry-run]
#
# --sweep cleans up every finished errand of one holding whose branch has
# landed on the holding's default branch, a long-lived branch such as dev, or
# the --onto branch a land just went to: the copy and the branch, by this script's own teardown with
# --drop-branch, or with --drop-proven for a branch landed on the default under
# other commit ids. Only a branch an errand record owns (its dispatch's birth,
# nothing since dropped), never the default, main or dev, never an errand in
# flight, blocked or with a question open, never one whose finish its own reeve
# has not yet been told of, never a copy with uncommitted work: each of those is
# kept and said, one line each. A branch landed under other commit ids is only
# ever dropped under the proven-delete grant, which this machine records as the
# file config/proven-delete in the home; without it that branch is kept and
# said too. A record whose branch is gone is skipped without a word. --dry-run
# says what it would do and writes nothing. Run by bin/reeve-land after every
# land; safe to rerun.
#
# --drop-proven, under that same grant only, is a teardown for an errand whose
# branch landed under other commit ids while its own copy still holds it, the
# way a sibling rebased onto the default leaves its original. Every check of a
# teardown runs first, the copy must be clean, with nothing untracked, and sit
# exactly on the branch tip, and the proof must fail on nothing but that copy:
# then the session is freed, the copy removed with a plain `git worktree
# remove`, and the branch goes by --delete-proven, its proof asked again now
# that nothing holds it. Any other copy holding the branch is the liege's.
#
# --prove-landed changes nothing. It prints one verdict line, `proven:` (exit 0)
# or `not proven:` (exit 1), saying whether `git branch -D <branch>` would lose
# anything: the proof behind hard rule 3's standing proven-delete grant, so the
# reeve never assembles it by hand. See the block above prove_landed below.
#
# --delete-proven is the grant's delete, and the only one: the same proof, then
# `git branch -D`, then branchDropped= on every record that vouched for the
# branch. A later branch reusing the name never proves on them, as after any
# other delete: a record vouches for the ref its dispatch made, by that ref's
# reflog birth, never for the name. Not proven changes nothing and exits 1.
#
# Two separate jobs with different safety conditions. DISMISSING a finished
# hand's session loses nothing and happens as soon as it reports a terminal
# state. REMOVING its copy can lose commits, so that waits until the work has
# landed. --dismiss-only does the first and stops.
#
# Exit status: 0 done, 3 refused only because the branch has not landed yet (the
# ordinary keep), 1 any other refusal or error, 4 the errand's lock not taken.
#
# Refuses while the errand holds anything its base does not. That is narrower
# than "while work could still be lost", deliberately: it also refuses when some
# other ref would have kept the commits, because a copy whose record and reality
# disagree is the thing worth hearing about. A refusal is a stop-and-investigate
# result, never an obstacle to route around. There is deliberately no --force:
# if git or this script objects, something is there that you did not expect, and
# past that objection the work is unrecoverable.
#
# What it guarantees, mechanically. A copy is removed only when the work it
# holds has landed: its own HEAD, and its recorded branch if it has one, are
# each reachable from the recorded base, from the holding's default branch, or
# from one of its long-lived branches such as dev (never an errand's branch).
# Both facts are asked whenever they apply, never one or the other. And a copy
# that is there to remove holds no git operation stopped halfway and no refs of
# its own (check 2c). Nothing else is asked, and the rest of this block is what
# that leaves open.
#
# What it deliberately does not guarantee. These are chosen edges, not
# oversights, and the reason is the load-bearing half of each: a limit reported
# as a bug, or closed without reading why it was left, costs more than the
# limit does.
#
# - The HEAD reflog and ORIG_HEAD. Removing a copy destroys every root private
#   to it, and HEAD is only the cheapest to name. A commit held solely by the
#   copy's own reflog, after a commit and then a `reset --hard`, is lost. Left
#   open because the false-refusal rate is close to total: one `commit
#   --amend`, one `rebase -i`, one `reset --hard` leaves a non-ancestor in the
#   reflog, and every artificer does at least one. Requiring every reflog entry
#   to be landed would refuse nearly every copy forever, over work the hand
#   deliberately threw away, and a guard that noisy gets worked around. This
#   script has no --force, so that workaround would be worse than the hole.
#
# - In-progress rebase, merge, cherry-pick, revert and bisect state, and the
#   per-worktree ref namespaces refs/worktree, refs/bisect and refs/rewritten.
#   CLOSED, by check 2c, and listed here because it is the boundary of the
#   reflog entry above: these hold work in flight where the reflog holds work
#   thrown away, and a warden measured their false-refusal rate at zero over
#   every clean case in its state space. Each operation refuses in its own name
#   ("this copy has a rebase in progress"), which is actionable where "moved off
#   main" is not. ORIG_HEAD is not asked, for the reflog's reason. A copy whose
#   directory is gone is not asked either, since there is nothing to finish and
#   nothing to remove. --dismiss-only is never refused over it.
#
# - A copy git knows by a different path than the record does. Where the copy's
#   directory is absent the gate below asks git rather than reading that
#   absence as nothing at risk, but it asks about a path taken from the record,
#   so anything that makes the two differ (a `git worktree move`, a renamed
#   parent, a case-only difference) puts it back to skipping the check and
#   reporting a pass, leaving git's entry at the real path as the last root
#   holding those commits. Left open rather than fixed because nothing in the
#   household moves or renames a copy. Closing it means identifying a copy by
#   something the record cannot get wrong, or enumerating every worktree entry
#   in the repository and refusing over the ones no live errand claims.
#
# - The stack case, closed by ancestry only. An errand based on another
#   errand's branch records that branch as base=, and once the stack lands on
#   main that branch sits behind it, so the copy's commits are not reachable
#   from it. The holding's default branch (its base: in manors.md, else main)
#   is therefore asked as well, and reaching either counts as landed. It is
#   asked in addition to base=, never instead of it: a default that does not
#   resolve is skipped, which leaves the refusal exactly as it was. A base=
#   branch deleted once it landed, the order a stack is normally cleaned up in,
#   leaves the default as the only ref to ask, and it is asked alone: reachable
#   from refs/heads/<default> is landed whatever base= said. With neither
#   resolving it still refuses. One gap remains, failing closed: a stack that
#   landed by rebase or squash holds the same patches under other shas, and
#   patch equivalence decides nothing here (see the rewritten-base entry below).
#
# - A base that was rewritten under the errand. A rebase, an amend, a `reset
#   --hard` or a force-move on the base leaves work that DID land, under the
#   position the base held at the time, unreachable from the position it holds
#   now, and the invariant below fails on it exactly as on work that never
#   landed. That refusal stays, deliberately: this is the landed-work test, and
#   reachable from the recorded base is what landed means here. What is closed is
#   the DIAGNOSIS, which said the copy had moved off the base and sent the reader
#   to the branch= line. The copy had not moved. The base ref's own reflog is now
#   walked, bounded, and when an earlier position of it does contain the work the
#   refusal names that position, the operation that moved it and the base= line
#   to correct. This is the stack case's sibling, and one more costume of the
#   sentence below: the description that went stale is base=, and the copy it
#   accused stayed exactly where it was.
#   What that still does not catch, each left open because it fails closed onto
#   the original refusal at no cost: a base recorded as a sha or resolving to a
#   detached HEAD, neither of which has a reflog of its own; a reflog that
#   expired or was never kept, which is the normal state of a fresh clone; and a
#   move further back than the last few dozen entries. Patch equivalence is in
#   that message and nowhere near the gate: it guesses a rebase from a reset,
#   and two commits with the same patch are not the same commit.
#
# - Ignored files. A copy's ignored files are deleted with it, silently:
#   `git status --porcelain` does not list them and `git worktree remove` does
#   not object. Right for build output, and an accepted limit for a hand's local
#   env file, decided with the liege on 2026-10-03: a hand's env file only ever
#   comes from the original checkout, so removing the copy loses nothing.
#
# Every hole found in this file so far has been the same mistake in a new
# costume: the guard identifies a copy by the record's DESCRIPTION of it rather
# than by the copy's identity, so each hole is one more way for the description
# and the thing to diverge. A reader holding that sentence will recognise the
# seventh before it costs anything.
#
# `git worktree prune` was removed deliberately and must not be put back
# casually. `git worktree remove` clears its own entry, so the prune only ever
# reached OTHER errands' stale entries, and such an entry is the last root
# holding that copy's commits. The one cost was measured and is small: a stale
# entry blocks a later dispatch that wants the same path, and git names the fix
# itself, with "missing but already registered worktree; use 'add -f' to
# override, or 'prune' or 'remove' to clear".

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"
BIN=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# --prove-landed: may `git branch -D <branch>` run without losing anything.
#
# For a branch whose work landed under other commit ids (cherry-picked, or
# rebased and fast-forwarded), so `-d` refuses over ancestry while nothing is
# lost. Proven needs ALL of these, and anything git cannot answer is not proven:
#
# - an errand record names the branch for this holding: some state/<id>.meta,
#   torn down or not, whose branch= is the branch, whose repo= is the same
#   repository, and whose branchMade= is the birth of the ref there now. Dispatch
#   writes branchMade= right after its `worktree add -b`: branch_birth, the sha
#   and time of the branch's oldest reflog entry. A record vouches for that ref,
#   not for the name. Any delete, this script's or a plain `git branch -d` or
#   `-D` by hand, takes the reflog with it, so a later branch of the same name
#   is born again and matches no record. A rename or copy onto the name (`git
#   branch -M/-C`) leaves no birth at all, since reftable keeps the overwritten
#   ref's entries. branchDropped= (written by
#   --drop-branch and --delete-proven) still refuses a record outright. The
#   grant covers only branches the household's own errands created. The
#   liege's, one from a session outside the household, one only a brief names
#   (dispatch refuses a branch that already exists, so the name may be the
#   liege's), any later branch of a name an errand once made, or one no record
#   names is never proven, whatever git says, and goes to the liege. So is a
#   household branch whose reflog is gone or expired, or never kept: no birth
#   to compare is no proof.
# - the default branch exists as refs/heads/<default>, resolved the way
#   resolve_default below resolves it (the holding's base: in manors.md, else
#   main), a branch and only a branch, and never the branch being proved. Asked
#   by name, a missing default made `git cherry` exit 128 with no output, and a
#   tag named main on the branch tip made it print nothing at exit 0: both read
#   as "no + line".
# - no merge commit between the default and the branch. `git cherry` never
#   looks at merges, so what only a merge adds (a conflict resolved one way on
#   the branch, another way when it landed) passes as all `-`. Always a stop.
# - `git cherry` exits 0, prints at least one line, and every line is `-`.
#   Empty means the branch holds nothing the default lacks: nothing to prove,
#   and `reeve-teardown <id> --drop-branch` is the tool for it.
# - the branch is checked out in no copy. A copy holding it goes by this
#   script's own teardown or not at all, and its refusal goes to the liege.
#
# The limits left open. Accepted by the liege: patch ids ignore whitespace, so
# `-` is not byte equality. A commit that differs from its landed copy only in
# whitespace proves. Known: a branch deleted and recreated at the same sha within
# the same wall-clock second has the same birth, so the old record still vouches.
prove_landed() { # prove_landed <holding> <branch> -> one verdict line
  local holding=$1 br=$2 repo repo_p name='' h p f i rp default_ref default_sha
  local br_sha born at merges cherry total plus
  # What --delete-proven acts on, set only as far as the proof got: every
  # record that vouches for the branch, the repository, and the tip proved.
  PL_RECORDS=() PL_REPO='' PL_SHA='' PL_VERDICT=''
  no() { PL_VERDICT="not proven: $*"; printf '%s\n' "$PL_VERDICT"; return 1; }
  repo=$(resolve_holding_path "$holding") \
    || { no "'$holding' is not a registered holding or a git repository"; return; }
  repo_p=$(cd "$repo" && pwd -P)
  born=$(branch_birth "$repo" "$br")
  for f in "$REEVE_HOME_D"/state/*.meta; do
    [ -f "$f" ] || continue
    i=$(basename "$f" .meta)
    [ "$(meta_get "$i" branch '')" = "$br" ] || continue
    [ -n "$born" ] && [ "$(meta_get "$i" branchMade '')" = "$born" ] || continue
    [ -z "$(meta_get "$i" branchDropped '')" ] || continue
    rp=$(meta_get "$i" repo '')
    [ -n "$rp" ] && [ "$(cd "$rp" 2>/dev/null && pwd -P)" = "$repo_p" ] \
      && PL_RECORDS+=("$i")
  done
  [ "${#PL_RECORDS[@]}" -gt 0 ] || { no "no errand record names $br for $repo as the very ref its" \
                             "dispatch made (born ${born:-unknown, no reflog}) and nothing since" \
                             "dropped; the grant covers only branches the household's errands" \
                             "created, so bring it to the liege"
                          return; }
  # The default is the holding's base:, so a holding given by path is matched to
  # its manors.md line by that path. Unmatched, it is main, and a main that does
  # not exist is refused below rather than guessed at.
  if holding_line "$holding" >/dev/null; then name=$holding
  else
    for h in $(holding_names); do
      p=$(holding_field "$h" path '')
      [ -n "$p" ] && [ "$(cd "$p" 2>/dev/null && pwd -P)" = "$repo_p" ] \
        && { name=$h; break; }
    done
  fi
  default_ref=main
  [ -n "$name" ] && default_ref=$(holding_field "$name" base main)
  [ "$default_ref" = "$br" ] && { no "$br is the default branch of $repo itself"; return; }
  default_sha=$(git -C "$repo" rev-parse --verify --quiet "refs/heads/$default_ref^{commit}" \
                2>/dev/null) \
    || { no "no branch refs/heads/$default_ref in $repo to prove against (the holding's" \
              "base: in manors.md, else main)"; return; }
  br_sha=$(git -C "$repo" rev-parse --verify --quiet "refs/heads/$br^{commit}" 2>/dev/null) \
    || { no "no branch refs/heads/$br in $repo"; return; }
  # Every copy holding it, not the first: --drop-proven passes PL_ALLOW_AT, the
  # errand's own copy, and that one alone may stand. Anything else holding it
  # goes to the liege.
  while IFS= read -r at; do
    [ -n "$at" ] || continue
    [ -n "${PL_ALLOW_AT:-}" ] && [ "$at" = "$PL_ALLOW_AT" ] && continue
    no "$br is checked out at $at; that copy goes by reeve-teardown or not at all, and a" \
       "refusal there goes to the liege"; return
  done <<PL_AT_EOF
$(git -C "$repo" worktree list --porcelain 2>/dev/null \
  | PL_WANT="refs/heads/$br" awk '
      $1 == "worktree" { p = substr($0, 10); next }
      $1 == "branch" && $2 == ENVIRON["PL_WANT"] { print p }')
PL_AT_EOF
  merges=$(git -C "$repo" rev-list --merges "$default_sha..$br_sha" 2>/dev/null) \
    || { no "git could not list the merge commits on $br"; return; }
  [ -z "$merges" ] || { no "$br holds $(printf '%s\n' "$merges" | wc -l | tr -d ' ') merge" \
                           "commit(s) $default_ref lacks, which git cherry cannot see; bring it" \
                           "to the liege"; return; }
  cherry=$(git -C "$repo" cherry "$default_sha" "$br_sha" 2>/dev/null) \
    || { no "git cherry failed on $br against $default_ref"; return; }
  [ -n "$cherry" ] || { no "nothing to prove: $br holds no commit $default_ref lacks, so" \
                           "reeve-teardown ${PL_RECORDS[0]} --drop-branch is the tool, not this" \
                           "grant"; return; }
  total=$(printf '%s\n' "$cherry" | wc -l | tr -d ' ')
  plus=$(printf '%s\n' "$cherry" | grep -cv '^- ')
  [ "$plus" -eq 0 ] || { no "$plus of $total commit(s) on $br have no patch equivalent on" \
                            "$default_ref; bring it to the liege"; return; }
  PL_VERDICT="proven: all $total commit(s) on $br have a patch equivalent on $default_ref, no"
  PL_VERDICT="$PL_VERDICT merges, checked out nowhere: git -C $repo branch -D $br loses nothing"
  # Said of the errand's own copy, which --drop-proven removes before it deletes.
  [ -z "${PL_ALLOW_AT:-}" ] \
    || PL_VERDICT=${PL_VERDICT/checked out nowhere/checked out only in its own copy}
  printf '%s\n' "$PL_VERDICT"
  PL_REPO=$repo PL_SHA=$br_sha
}

# --delete-proven: the proof, then the delete, then the records. The delete
# takes the ref's reflog, so its birth already matches nothing; the records are
# marked branchDropped= as well, so each says what became of its branch, and a
# backend that kept a deleted branch's reflog still finds them refused. The tip
# is asked again just before the delete: a commit landing on the branch after
# the proof was never proved, and git branch -D would take it.
delete_proven() { # delete_proven <holding> <branch>
  local br=$2 i now
  PL_ALLOW_AT='' prove_landed "$1" "$br" || return 1
  [ "$(git -C "$PL_REPO" rev-parse --verify --quiet "refs/heads/$br^{commit}" 2>/dev/null)" \
    = "$PL_SHA" ] || { printf 'not deleted: %s moved after the proof; prove it again\n' "$br"
                       return 1; }
  git -C "$PL_REPO" branch -D "$br" >/dev/null \
    || { printf 'not deleted: git refused to delete %s in %s\n' "$br" "$PL_REPO"; return 1; }
  now=$(date +%Y-%m-%dT%H:%M:%S)
  for i in "${PL_RECORDS[@]}"; do
    meta_set "$i" branchDropped "$now" \
      || { printf 'deleted, unmarked: %s is gone but record %s could not be marked' "$br" "$i"
           printf ' branchDropped=, so a branch reusing the name would prove on it\n'
           return 1; }
  done
  printf 'deleted: %s in %s, was %s; marked dropped on %s\n' "$br" "$PL_REPO" "$PL_SHA" \
    "${PL_RECORDS[*]}"
}

# --sweep: what a land leaves behind, cleaned in the same step. A land used to
# end at the fast-forward, and every errand of a chain (an original and the
# mends based on it) kept its branch, and often its copy, until the liege
# cleaned up by hand. Each errand still goes through the one landed-work test,
# this script's own teardown, so nothing here decides what is safe to remove.
# What it adds is the choice of which errands to put to it, one line each.
sweep() { # sweep <holding> <dry yes|no> [<onto>]
  local holding=$1 dry=$2 onto=${3:-} repo repo_p name='' h p f i rp br wt st open landed out rc
  local why own me dflag default_ref ids=() owned='' n_clean=0 n_drop=0 n_kept=0
  kept() { # kept <id> <branch> <why...>
    local a=$1 b=$2; shift 2
    printf 'kept: %s %s: %s\n' "$a" "$b" "$*"; n_kept=$((n_kept + 1))
  }
  repo=$(resolve_holding_path "$holding") \
    || die "'$holding' is not a registered holding or a git repository"
  repo_p=$(cd "$repo" && pwd -P)
  if holding_line "$holding" >/dev/null; then name=$holding
  else
    for h in $(holding_names); do
      p=$(holding_field "$h" path '')
      [ -n "$p" ] && [ "$(cd "$p" 2>/dev/null && pwd -P)" = "$repo_p" ] && { name=$h; break; }
    done
  fi
  default_ref=$(holding_default "$name")
  git -C "$repo" rev-parse --verify --quiet "refs/heads/$default_ref^{commit}" >/dev/null 2>&1 \
    || die "no branch refs/heads/$default_ref in $repo to sweep against (the holding's base: in" \
           "manors.md, else main)"
  [ -z "$onto" ] || git -C "$repo" rev-parse --verify --quiet "refs/heads/$onto^{commit}" \
                      >/dev/null 2>&1 || die "no branch refs/heads/$onto in $repo to sweep against"
  me=$(reeve_session)
  for f in "$REEVE_HOME_D"/state/*.meta; do
    [ -f "$f" ] || continue
    i=$(basename "$f" .meta)
    rp=$(meta_get "$i" repo '')
    [ -n "$rp" ] && [ "$(cd "$rp" 2>/dev/null && pwd -P)" = "$repo_p" ] || continue
    ids+=("$i")
    branch_owned "$i" && owned="$owned$(meta_get "$i" branch '')
"
  done
  for i in ${ids[@]+"${ids[@]}"}; do
    br=$(meta_get "$i" branch '')
    [ -n "$br" ] && [ -z "$(meta_get "$i" branchDropped '')" ] || continue
    git -C "$repo" rev-parse --verify --quiet "refs/heads/$br^{commit}" >/dev/null 2>&1 || continue
    case " main master dev develop $default_ref $onto " in *" $br "*) continue ;; esac
    # Landed by ancestry, on the default, a long-lived branch such as dev or the
    # branch a land just went to, or under other commit ids on the default, the
    # one ref the proof asks.
    # Unlanded is the ordinary wait for the liege, not something kept, so it is
    # not said here.
    if branch_landed_long "$repo" "$br" "$name" \
       || { [ -n "$onto" ] && branch_landed "$repo" "$br" "$onto"; }; then landed=ancestor
    else
      out=$(git -C "$repo" cherry "refs/heads/$default_ref" "refs/heads/$br" 2>/dev/null) || out=''
      [ -n "$out" ] && [ "$(printf '%s\n' "$out" | grep -cv '^- ')" = 0 ] || continue
      landed=patch
    fi
    # Another record of this holding owning the name speaks for it.
    if ! branch_owned "$i"; then
      lines_has "$br" "$owned" \
        || kept "$i" "$br" "not provably the ref its dispatch made, so it is the liege's"
      continue
    fi
    st=$(status_field "$i" state)
    open=$(status_field "$i" open); open=${open:-0}
    if [ "$open" -gt 0 ]; then kept "$i" "$br" "$open question(s) never answered"; continue; fi
    case $st in
      done|failed) ;;
      blocked|needs-decision) kept "$i" "$br" "it is $st"; continue ;;
      *) [ -n "$(meta_get "$i" tornDown '')" ] \
           || { kept "$i" "$br" "still in flight (last reported: ${st:-nothing yet})"; continue; } ;;
    esac
    # Another reeve's finish not yet reported to it: torn down, it would drop
    # out of that reeve's watch before its report was made, so the report is
    # lost rather than late. The sentry's own test, wake_owed.
    own=$(meta_get "$i" session '')
    if [ -z "$(meta_get "$i" tornDown '')" ] && [ -n "$own" ] && [ "$own" != "$me" ] \
       && wake_owed "$i"; then
      kept "$i" "$br" "its finish not yet reported to its reeve"; continue
    fi
    if [ -n "$(meta_get "$i" keep '')" ] && [ -n "$(meta_get "$i" target '')" ]; then
      kept "$i" "$br" "dispatched to be kept for debugging, its session still up"; continue
    fi
    wt=$(meta_get "$i" worktree '')
    if [ -n "$wt" ] && [ -d "$wt" ] && [ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]; then
      kept "$i" "$br" "uncommitted work in its copy at $wt"; continue
    fi
    if [ "$landed" = ancestor ]; then
      if [ "$dry" = yes ]; then
        printf 'would clean: %s\nwould drop: %s\n' "$i" "$br"; continue
      fi
      out=$("$BIN/reeve-teardown" "$i" --drop-branch ${onto:+--onto "$onto"} 2>&1); rc=$?
      if [ "$rc" != 0 ]; then
        why=$(printf '%s\n' "$out" | sed -n '/REFUSED/{n;s/^ *//p;q;}')
        kept "$i" "$br" "cleanup refused: ${why:-exit $rc}"; continue
      fi
      printf 'cleaned: %s\n' "$i"; n_clean=$((n_clean + 1))
      if git -C "$repo" rev-parse --verify --quiet "refs/heads/$br" >/dev/null 2>&1; then
        kept "$i" "$br" "git refused to delete it"
      else printf 'dropped: %s\n' "$br"; n_drop=$((n_drop + 1)); fi
    else
      # The proven route, hard rule 3's, and only under its grant. --drop-proven
      # runs the proof, and its own copy holding the branch is the one holder it
      # removes first; any other is kept and said.
      if ! proven_delete_granted; then
        kept "$i" "$br" "landed under other commit ids; the proven-delete grant is not recorded" \
                        "on this machine"
        continue
      fi
      dflag=''; [ "$dry" = no ] || dflag=--dry-run
      out=$("$BIN/reeve-teardown" "$i" --drop-proven $dflag 2>&1); rc=$?
      if [ "$rc" != 0 ]; then
        why=$(printf '%s\n' "$out" | sed -n '/REFUSED/{n;s/^ *//p;q;}')
        kept "$i" "$br" "${why:-cleanup refused: exit $rc}"; continue
      fi
      if [ "$dry" = yes ]; then
        printf 'would clean: %s\nwould drop: %s (landed under other commit ids)\n' "$i" "$br"
        continue
      fi
      printf 'cleaned: %s\n' "$i"; n_clean=$((n_clean + 1))
      printf 'dropped: %s (landed under other commit ids)\n' "$br"; n_drop=$((n_drop + 1))
    fi
  done
  if [ "$dry" = yes ]; then printf 'dry run, nothing changed\n'
  else printf 'swept %s: %s cleaned, %s dropped, %s kept\n' "$repo" "$n_clean" "$n_drop" "$n_kept"; fi
}

case ${1:-} in
  -h|--help) print_help "$0"; exit 0 ;;
  --prove-landed)
    [ $# -eq 3 ] || die "usage: reeve-teardown --prove-landed <holding> <branch>"
    prove_landed "$2" "$3"; exit ;;
  --delete-proven)
    [ $# -eq 3 ] || die "usage: reeve-teardown --delete-proven <holding> <branch>"
    delete_proven "$2" "$3"; exit ;;
  --sweep)
    sw_use="usage: reeve-teardown --sweep <holding> [--onto <branch>] [--dry-run]"
    [ $# -ge 2 ] || die "$sw_use"
    sw_at=$2 sw_dry=no sw_onto=''; shift 2
    while [ $# -gt 0 ]; do
      case $1 in
        --dry-run) sw_dry=yes; shift ;;
        --onto) [ -n "${2:-}" ] || die "$sw_use"; sw_onto=$2; shift 2 ;;
        *) die "$sw_use" ;;
      esac
    done
    sweep "$sw_at" "$sw_dry" "$sw_onto"
    exit ;;
esac
id=${1:-}; shift 2>/dev/null || :
drop_branch=no dry=no dismiss_only=no drop_proven=no onto=''
while [ $# -gt 0 ]; do
  case $1 in
    --drop-branch) drop_branch=yes; shift ;;
    --onto) [ -n "${2:-}" ] || die "--onto takes a branch"; onto=$2; shift 2 ;;
    --drop-proven) drop_proven=yes; shift ;;
    --dismiss-only) dismiss_only=yes; shift ;;
    --dry-run) dry=yes; shift ;;
    -h|--help) print_help "$0"; exit 0 ;;
    *) die "unknown option '$1'" ;;
  esac
done
require_id "$id"
[ -f "$(meta_file "$id")" ] || die "no errand '$id'"
[ "$drop_proven" = no ] || { [ "$drop_branch" = no ] && [ "$dismiss_only" = no ]; } \
  || die "--drop-proven takes no --drop-branch or --dismiss-only"
# Asked before anything is freed: without the grant this mode has nothing to do.
[ "$drop_proven" = no ] || proven_delete_granted \
  || die "--drop-proven deletes under the proven-delete grant, and it is not recorded on this" \
         "machine ($(config_file proven-delete) is absent)"

# One errand, one teardown at a time. A foreground watch and a caretaker can
# both decide the same hand is finished in the same instant, and two concurrent
# `git worktree remove` / `git branch -d` runs against one repository leave the
# loser reading a git error that looks exactly like the landed-work guard
# refusing. A refusal here has to mean what it says, so the two are serialised
# and the second finds the work already done.
# Exit 4, distinct from the 1 or 3 a refusal uses: not taking the lock decides
# nothing about this errand, and a caller that cannot tell the two apart records
# a decision that was never made.
ERRAND_LOCK=$(lock_acquire "errand-$id" 15) || exit 4
trap 'lock_release "$ERRAND_LOCK"' EXIT

run() { if [ "$dry" = yes ]; then printf '  would run: %s\n' "$*"; else "$@"; fi; }
dismiss=no; dismissed=no
# Set by require_base when base= did not resolve and the default branch was
# asked alone, so every refusal after that point says the base was missing
# rather than reading as though it had been asked.
base_missing_note=''
# Exit 1 for every refusal but one. A branch that simply has not landed yet, the
# routine end of every artificer errand, exits 3 (refuse_rc=3 on that call), so a
# caller can tell the ordinary keep from a refusal worth investigating without
# reading the English. Still a refusal, and still non-zero.
refuse_rc=1
refuse() {
  printf 'reeve: REFUSED to tear down %s\n' "$id" >&2; printf '  %s\n' "$@" >&2
  [ -z "$base_missing_note" ] || printf '%s\n' "$base_missing_note" | sed 's/^/  /' >&2
  exit "$refuse_rc"
}

repo=$(meta_get "$id" repo '')
wt=$(meta_get "$id" worktree '')
br=$(meta_get "$id" branch '')
base=$(meta_get "$id" base main)
holding=$(meta_get "$id" holding '')
writes=$(meta_get "$id" writes yes)
target=$(meta_get "$id" target '')
backend=$(meta_get "$id" backend herdr)
# A hall dispatch killed outright mid launch, which runs no trap, leaves its new
# session under `launching=` alone. It is an endpoint like `target=`: refused on
# while it reads alive, closed on a teardown. herdr never writes it.
launching=$(meta_get "$id" launching '')
[ "$launching" != "$target" ] || launching=''
# --onto names a landing place, so never an errand's branch: one that does not
# exist here, or that an errand record of this repository names as branch=, is
# refused. main, master, dev, develop and the default are never an errand's, as
# bin/reeve-land and the sweep read them.
if [ -n "$onto" ]; then
  git -C "$repo" rev-parse --verify --quiet "refs/heads/$onto^{commit}" >/dev/null 2>&1 \
    || refuse "--onto $onto is not a branch in $repo."
  o_default=main
  [ -n "$holding" ] && o_default=$(holding_field "$holding" base main)
  case $onto in
    main|master|dev|develop|"$o_default") ;;
    *) for f in "$REEVE_HOME_D"/state/*.meta; do
         [ -f "$f" ] || continue
         r=$(basename "$f" .meta)
         [ "$(meta_get "$r" branch '')" = "$onto" ] || continue
         [ "$(cd "$(meta_get "$r" repo '')" 2>/dev/null && pwd -P)" = "$(cd "$repo" && pwd -P)" ] \
           && refuse "--onto $onto is errand $r's branch, not a place work lands."
       done ;;
  esac
fi

# 1. the hand must not still be WORKING.
#
# A hand that has reported a terminal state is finished even though its harness
# is still sitting at a prompt: agents do not exit themselves. Refusing on a
# live process alone would mean every completed errand needs a human to close a
# pane before it can be cleaned up, which is exactly the babysitting this
# household exists to remove. So the REPORTED state decides, and the process
# state only decides when the report does not.
reported=$(status_field "$id" state)
open_q=$(status_field "$id" open); open_q=${open_q:-0}
endpoint_check() { # endpoint_check <endpoint>: refuse while a hand works there
  local ep=$1 st
  st=$("$BIN/reeve-backend" call agent_state "$ep" --backend "$backend" 2>/dev/null || echo unreadable)
  case $st in
    alive)
      case "$reported" in
        done|failed)
          if [ "$open_q" -gt 0 ]; then
            refuse "the hand reported $reported but $open_q question(s) were never answered." "That is a divergence, not a finished errand. Run: reeve-status $id"
          fi
          # Decide only. The actual dismissal happens in the removal section
          # below, AFTER every landed-work check has passed. Announcing it here
          # printed "dismissing its session" and then refused on unlanded work,
          # so the message described something that never happened.
          dismiss=yes ;;
        *)
          refuse "a hand is still working at $ep (last reported: ${reported:-nothing yet})." "Let it finish, or stop it deliberately, then tear down." ;;
      esac ;;
    unreadable)
      refuse "the state of the endpoint at $ep cannot be read." "Investigate before removing anything: this script cannot tell a working hand from a dead one right now." ;;
  esac
}
[ -z "$target" ] || endpoint_check "$target"
[ -z "$launching" ] || endpoint_check "$launching"

# 1b. Dismiss the finished hand's session NOW, before the removal checks.
# A hand that has reported a terminal state with nothing open is done working;
# its agent is just idling at a prompt holding a pane. Freeing it loses nothing,
# because the status file and any report are already on disk. Doing this after
# the landed-work checks meant an artificer with an unlanded branch kept its
# session alive forever, which is the opposite of cleaning up.
if [ "$dismiss" = yes ] && [ -n "$target" ]; then
  info "dismissing the hand's session, it reported $reported"
  run "$BIN/reeve-backend" call kill "$target" --backend "$backend" \
    || warn "could not close the endpoint $target, continuing"
  [ "$dry" = yes ] || meta_set "$id" target ''
  dismissed=yes
  target=''
fi
if [ "$dismiss" = yes ] && [ -n "$launching" ]; then
  info "dismissing the hand's session at $launching, it reported $reported"
  run "$BIN/reeve-backend" call kill "$launching" --backend "$backend" \
    || warn "could not close the endpoint $launching, continuing"
  [ "$dry" = yes ] || meta_set "$id" launching ''
  dismissed=yes
  launching=''
fi

if [ "$dismiss_only" = yes ]; then
  [ "$dismissed" = yes ] && info "session freed. The copy and branch are untouched." \
                         || info "nothing to dismiss"
  exit 0
fi

# 2. an open decision means nobody ever answered the question. This still has
# work to do for an errand whose session is already gone.
open=$open_q
if [ "$open" -gt 0 ]; then
  refuse "$open question(s) from this errand were never answered." "Run: reeve-status $id" "Tearing down now discards the work that question was blocking."
fi

# 2b. the recorded permission must be one this script knows.
#
# `writes` decides which landed-work check applies, so a label this script does
# not recognise is a copy it cannot reason about: it cannot tell whether the
# thing was allowed to commit, and therefore cannot tell which proof of safety
# to demand. That is the same position as a base that does not resolve, and it
# gets the same answer. Checked here rather than before the --dismiss-only exit
# because freeing a pane loses nothing whatever the label says.
case $writes in
  yes|no|home) ;;
  *) refuse "the recorded permission 'writes=$writes' is not one of yes, no or home." \
       "That label decides which landed-work check this copy has to pass, so an unknown one" \
       "leaves the script unable to say what would be safe. Correct the writes= line in" \
       "$(meta_file "$id")." ;;
esac

# 2c. no git operation stopped halfway in the copy.
#
# A rebase, merge, cherry-pick or revert that stopped on a conflict or a
# `break`, and a bisect left running, keep their state in the copy's own git
# directory, and removing the copy deletes it. A stopped rebase leaves the tree
# clean, so check 3 does not see it and `git worktree remove` does not object
# either. HEAD covers the commits already replayed, at best: the original branch
# position, the todo list and every commit not yet replayed go with the copy,
# without a word. That is work in flight, not work thrown away, so it refuses in
# the operation's own name. Asked before check 3 because a conflicted merge is
# dirty as well, and "commit them or discard them" is the wrong advice for it:
# finishing or aborting the operation is the right one.
#
# The per-worktree ref namespaces are asked here too. refs/worktree and
# refs/rewritten belong to this copy alone and are deleted with it, nothing in
# the household creates them, so when one is there something put it there.
# refs/bisect is the bisect's own and is reported as one.
#
# Removal only. --dismiss-only has exited above, because freeing a session keeps
# the copy and everything in it. A copy whose directory is gone has no operation
# to finish here and nothing to remove, so it is left to check 4 as before.
copy_git_path() { # copy_git_path <name> -> that path in the copy's own git dir
  local p
  # --git-path resolves per worktree: a linked copy's MERGE_HEAD lives under
  # .git/worktrees/<name>/, never in the shared directory. It can print a path
  # relative to the copy, so that is anchored to it.
  p=$(git -C "$wt" rev-parse --git-path "$1" 2>/dev/null) || return 1
  case $p in /*) ;; *) p="$wt/$p" ;; esac
  printf '%s\n' "$p"
}
copy_operation() { # -> rebase|am|merge|cherry-pick|revert|bisect, or nothing
  local p
  if p=$(copy_git_path rebase-merge) && [ -d "$p" ]; then echo rebase; return; fi
  # `git am` keeps its state in the same directory and marks it, and naming it a
  # rebase would send the reader to the wrong --abort.
  if p=$(copy_git_path rebase-apply) && [ -d "$p" ]; then
    if [ -e "$p/applying" ]; then echo am; else echo rebase; fi; return
  fi
  if p=$(copy_git_path MERGE_HEAD) && [ -e "$p" ]; then echo merge; return; fi
  if p=$(copy_git_path CHERRY_PICK_HEAD) && [ -e "$p" ]; then echo cherry-pick; return; fi
  if p=$(copy_git_path REVERT_HEAD) && [ -e "$p" ]; then echo revert; return; fi
  # A multi-commit pick or revert whose conflict was resolved and committed has
  # no *_HEAD left, a clean tree, and the rest of its list still to apply. Only
  # the sequencer says so, and its todo says which of the two it is.
  if p=$(copy_git_path sequencer) && [ -d "$p" ]; then
    case $(sed -n '1s/[[:space:]].*//p' "$p/todo" 2>/dev/null) in
      revert) echo revert ;;
      *) echo cherry-pick ;;
    esac
    return
  fi
  if { p=$(copy_git_path BISECT_START) && [ -e "$p" ]; } \
     || { p=$(copy_git_path BISECT_LOG) && [ -e "$p" ]; } \
     || [ -n "$(git -C "$wt" for-each-ref --format='%(refname)' refs/bisect 2>/dev/null)" ]
  then echo bisect; return; fi
}
if [ "$writes" != home ] && [ -n "$wt" ] && [ -d "$wt" ]; then
  op=$(copy_operation)
  if [ -n "$op" ]; then
    case $op in
      bisect) how="git -C '$wt' bisect reset" ;;
      *)      how="git -C '$wt' $op --continue, or git -C '$wt' $op --abort" ;;
    esac
    case $op in am) a=an ;; *) a=a ;; esac
    refuse "this copy has $a $op in progress: finish or abort it in $wt first." \
           "Run $how, then tear down again." \
           "Removing the copy now deletes that $op's state with it, and its tree can look clean."
  fi
  own_refs=$(git -C "$wt" for-each-ref --format='%(refname)' refs/worktree refs/rewritten \
             2>/dev/null)
  if [ -n "$own_refs" ]; then
    refuse "this copy holds refs of its own, which are deleted with it:" \
           "$(printf '%s' "$own_refs" | head -5 | sed 's/^/    /')" \
           "Give what they hold a branch, or delete them deliberately yourself in $wt, then tear" \
           "down again. This script will not."
  fi
fi

# 3. nothing uncommitted in the copy
if [ "$writes" != home ] && [ -n "$wt" ] && [ -d "$wt" ]; then
  dirty=$(git -C "$wt" status --porcelain 2>/dev/null)
  if [ -n "$dirty" ]; then
    refuse "the copy at $wt has uncommitted changes:" "$(printf '%s' "$dirty" | head -5 | sed 's/^/    /')" "Commit them on $br, or discard them deliberately yourself. This script will not."
  fi
fi

# The landed-work invariant below compares against the recorded base, and it is
# only as trustworthy as that comparison. It therefore refuses when the
# comparison cannot be made: a verification that cannot run is a refusal, never
# a pass. This is not hypothetical tidiness. `rev-list --count` used to fall back
# to 0 on failure, and 0 reads as "nothing unlanded", so a base that no longer
# resolved was indistinguishable from a fully landed branch and the copy was
# removed with its commits still on it.
#
# Resolved on first use rather than up front, so an errand whose checks never
# consult the base is not refused over a base it does not use.
#
# Empty base_sha after this returns means base= did not resolve and the default
# branch is the only ref asked. Every reader of base_sha below handles that.
base_sha='' base_resolved=no
require_base() {
  [ "$base_resolved" = yes ] && return 0
  # Deliberate fail-closed guard, not dead code: the invariant below calls this
  # before it touches git, so an errand with no repository recorded is told why
  # the test stopped instead of being shown a raw fatal: from git afterwards.
  [ -n "$repo" ] || refuse "no repository is recorded for this errand." \
    "The landed-work test has nothing to compare against, so it stops. Check the repo= line in" \
    "$(meta_file "$id")."
  base_sha=$(git -C "$repo" rev-parse --verify --quiet "$base^{commit}" 2>/dev/null) || base_sha=''
  resolve_default
  base_resolved=yes
  [ -n "$base_sha" ] && return 0
  # A base= that no longer resolves is usually a stacked errand's lower branch,
  # deleted once the stack landed. The default branch is then asked alone, by
  # ancestry only, and that is not a guessed replacement: work reachable from
  # refs/heads/<default> has landed whatever base= said, so it can only pass
  # landed work. Falling back to HEAD, or to any revision that merely resolves,
  # would be the fail-open this guard exists to stop, and resolve_default takes
  # only a branch for that reason. No default, no question to ask: refuse.
  if [ -n "$default_sha" ]; then
    base_missing_note="The recorded base '$base' does not name a commit in $repo, so only
$default_ref was asked. If the work belongs somewhere else, correct the
base= line in $(meta_file "$id") to the branch the work actually landed on."
    return 0
  fi
  refuse "the recorded base '$base' does not name a commit in $repo." \
    "Without it this script cannot tell landed work from unlanded work, so it refuses rather than" \
    "assume the work is safe. Usually that base has itself landed and been deleted." \
    "Correct the base= line in $(meta_file "$id") to the branch the work actually landed on," \
    "then tear down again."
}

# The holding's default branch, the second place work counts as landed. An
# errand stacked on another errand's branch records that branch as base=, and
# once the whole stack lands on main the recorded branch sits behind it for
# good: the copy's commits are on main and on nothing base= can reach. Resolved
# the way bin/reeve-brief picks a base when it is given none, the holding's
# base: in manors.md, else main.
#
# An addition to the base, never a replacement for it, and that is the whole of
# why this is not the fallback require_base refuses to make: work reachable from
# the default branch has landed whatever base= says, so asking it can only turn
# a refusal over landed work into a pass. A default that does not resolve is not
# asked at all, which leaves every check exactly as it was without it. Set by
# require_base, which asks it alone only when base= itself does not resolve.
#
# A branch, and only a branch: refs/heads/<default>. Any revision would let a
# misconfigured base: line pass unlanded work, because a tag, a sha or a tag
# named main shadowing the branch can each sit on the copy's own commit. The
# errand's own branch is never a landing place for it either.
#
# The holding's other long-lived branches are asked too, the third place: main,
# master, dev and develop, each that exists and no errand record names as its
# branch= (long_lived_branches in bin/reeve-lib.sh), the branches the liege
# lands on. Work fast-forwarded onto dev has landed there whatever base= says.
# --onto <branch>, from the sweep after a land, adds the branch that land went
# to, validated below as never an errand's branch. An errand's branch is never
# one of these, so the strict reading holds: a landing place, not any ref that
# happens to keep the commits.
default_ref='' default_sha='' landed_refs='' also_refs='' also_shas=''
resolve_default() {
  default_ref=main
  [ -n "$holding" ] && default_ref=$(holding_field "$holding" base main)
  default_sha=$(git -C "$repo" rev-parse --verify --quiet "refs/heads/$default_ref^{commit}" \
                2>/dev/null) || default_sha=''
  # The same ref asks nothing new, and naming it twice in a refusal reads as a
  # second check that never ran. Compared by name, not by commit: a default
  # sitting on the same commit as a stacked base= is still a second ref, and
  # the reader of the refusal needs to see it was asked.
  [ "$default_ref" = "$base" ] && default_sha=''
  [ -n "$br" ] && [ "$default_ref" = "$br" ] && default_sha=''
  landed_refs=$base
  [ -n "$default_sha" ] && landed_refs="$base or $default_ref"
  [ -n "$base_sha" ] || landed_refs=$default_ref
  local n sha
  also_refs='' also_shas=''
  for n in $(long_lived_branches "$repo" "$holding") $onto; do
    case " $base $default_ref $br $also_refs " in *" $n "*) continue ;; esac
    sha=$(git -C "$repo" rev-parse --verify --quiet "refs/heads/$n^{commit}" 2>/dev/null) || continue
    also_refs="${also_refs:+$also_refs }$n" also_shas="${also_shas:+$also_shas }$sha"
    landed_refs="$landed_refs or $n"
  done
  return 0
}

# landed_on <sha> -> 0 when the recorded base or the default branch holds it.
# Non-zero on an error exactly as on unlanded work, like the --is-ancestor it
# wraps, so a question git cannot answer is a refusal. Either may be empty, a
# base= that did not resolve or a default that did not, and an empty one is not
# asked: require_base has refused before both can be.
landed_on() {
  [ -n "$base_sha" ] && git -C "$repo" merge-base --is-ancestor "$1" "$base_sha" 2>/dev/null \
    && return 0
  [ -n "$default_sha" ] && git -C "$repo" merge-base --is-ancestor "$1" "$default_sha" 2>/dev/null \
    && return 0
  local sha
  for sha in $also_shas; do
    git -C "$repo" merge-base --is-ancestor "$1" "$sha" 2>/dev/null && return 0
  done
  return 1
}

# A base that moved out from under the errand.
#
# `base=` is a DESCRIPTION of where this errand's work was meant to land, and it
# goes stale the same way every other line in the record does. A rebase, an
# amend, a `reset --hard` or a force-move on the base leaves work that DID land,
# under the position the base held at the time, unreachable from the position it
# holds now. Both facts below then fail, and both used to report that as the copy
# having moved off the base. The copy never moved. Saying it did sent the reader
# to the branch= line, or to "find out where that work belongs", when the line
# that actually went stale is base=.
#
# Git keeps the record that separates them: the base ref's own reflog still holds
# the positions it used to have, so an earlier position that DOES contain this
# work names the moment the base was rewritten and says which operation did it.
#
# Diagnosis only, and that boundary is the whole safety story. This changes what
# a refusal SAYS, never whether there is one: removal still requires
# reachability from base_sha exactly as before, because a rewritten base is a
# reason to say something true and actionable, never a reason to delete a copy.
# Uncertainty therefore costs nothing and is always answered the same way. A base
# recorded as a sha, a detached HEAD, a ref whose reflog is absent or expired, a
# repository git cannot read: each returns "cannot tell" and leaves the original
# refusal exactly as it was.
BASE_REFLOG_DEPTH=40
base_was='' base_was_at='' base_was_when='' base_last_move=''
base_moved_off() { # base_moved_off <sha> -> 0 if an earlier base position holds it
  base_was='' base_was_at='' base_was_when='' base_last_move=''
  local ref log old sel what
  # A base= that did not resolve has no position now and no reflog to walk.
  [ -n "$base_sha" ] || return 1
  ref=$(git -C "$repo" rev-parse --symbolic-full-name "$base" 2>/dev/null) || return 1
  # A sha, a detached HEAD and anything git cannot resolve all print nothing
  # here, and none of them has a reflog of its own to walk.
  case $ref in refs/*) ;; *) return 1 ;; esac
  # Bounded, because a long-lived main has thousands of entries and this asks git
  # a reachability question per entry. Past the bound the answer is "cannot
  # tell", which is the refusal that was already going to be printed.
  log=$(git -C "$repo" reflog show --format='%H%x09%gd%x09%gs' -n "$BASE_REFLOG_DEPTH" "$ref" \
        2>/dev/null) || return 1
  [ -n "$log" ] || return 1
  # Entry 0 is the move that put the base where it is, which is the one the
  # reader has to recognise: "reset: moving to HEAD~1" names the mistake where
  # the position it landed on only dates it.
  base_last_move=$(printf '%s\n' "$log" | head -1 | cut -f3)
  while IFS=$'\t' read -r old sel what; do
    [ -n "$old" ] || continue
    # Skipped on the sha rather than on the entry number, because a ref returns
    # to a position it held before often enough (a reset and a re-merge) that
    # skipping entry 0 alone would leave the current position in the walk, where
    # the caller has already found it does not contain this work.
    [ "$old" = "$base_sha" ] && continue
    if git -C "$repo" merge-base --is-ancestor "$1" "$old" 2>/dev/null; then
      base_was=$old base_was_at=$sel base_was_when=$what
      return 0
    fi
  done <<< "$log"
  return 1
}

# Set by check 4b to the recorded branch when the copy is sitting off it. Getting
# that far with a branch recorded means 4a already proved that branch landed, so
# the record and the copy disagree as well, and the summary below has to say so
# instead of asserting that nothing this errand holds has moved. Empty everywhere
# else, which includes every call from 4a: there the copy has not been looked at.
copy_off_landed_branch=''

# One refusal for both facts below, because the diagnosis does not depend on
# which of them noticed: the thing is where it always was, and the base is not.
refuse_base_moved() { # refuse_base_moved <subject> <sha> [extra line...]
  local subject=$1 sha=$2 cherry guess='' msg
  shift 2
  # What the walk proves is that the base HAS HELD a position containing this
  # work, and that is all it is allowed to say. It never compares that position
  # against when the errand went out, so a base force-moved before the errand
  # existed reaches here too, and "moved after this errand went out" dated a move
  # this script cannot date.
  msg=("$subject is not on $base. $base has held a position that does contain that work:")
  msg+=("$base_was ($base_was_at, $base_was_when).")
  msg+=("It is at $base_sha now, and its most recent move was: ${base_last_move:-not recorded}.")
  # The diagnosis is about base= alone, but it is not the only ref that was
  # asked, and a refusal that names one reads as though the other never ran.
  [ -n "$default_sha" ] && msg+=("($default_ref was asked too and does not hold it.)")
  # Patch equivalence tells a rebase from a reset, and nothing else. It is in the
  # message and nowhere near the gate deliberately: two commits with the same
  # patch are not the same commit, so here it never decides anything and is always
  # labelled as the guess it is. The one place it decides is --prove-landed, a
  # branch delete under the liege's standing grant, behind its own guards, and the
  # message says so, so this text and hard rule 3 never disagree.
  cherry=$(git -C "$repo" cherry "$base_sha" "$sha" 2>/dev/null) || cherry=''
  case $cherry in
    ''|*+*) ;;
    *) guess=yes ;;
  esac
  if [ -n "$guess" ]; then
    msg+=("Every commit it holds already has an equivalent on $base by patch text, so this looks")
    msg+=("like a rebase rather than a reset. That is a guess for you to confirm, never a reason to")
    msg+=("remove this copy. Deleting a branch on that proof is the liege's standing grant under")
    msg+=("hard rule 3 alone, and only once reeve-teardown --prove-landed says proven.")
  fi
  while [ $# -gt 0 ]; do msg+=("$1"); shift; done
  if [ -n "$copy_off_landed_branch" ]; then
    # Both records are stale at once here, and the one about the copy is the one
    # this diagnosis used to swallow: it is the whole of what the non-moved
    # refusal below says, and the base having moved does not make it any less
    # true. Saying only that the base moved sends the reader to base=, which is
    # not the line that is wrong in this case, or not the only one.
    msg+=("So base= is not the only line that went stale: $base has moved, and the copy is off")
    msg+=("$copy_off_landed_branch, which did land. The record and the copy disagree, so that")
    msg+=("branch says nothing about what this copy holds.")
  else
    msg+=("So nothing this errand holds has moved: $base has, and the base= line is what went stale.")
  fi
  # The advice below ends in a removal, and correcting base= to a position the
  # base no longer holds is the one way to reach it over a commit that nothing
  # else keeps. So it comes BEFORE that advice rather than tenth of ten lines: a
  # ref costs nothing, is the difference between a decision and a loss, and is
  # worth nothing at all if it is read after the edit it protects against.
  msg+=("Before you act on any of this: if nothing but this errand still holds that work, give it")
  msg+=("a ref, with git -C $repo branch <name> $sha.")
  msg+=("Then, which move it was decides the fix. A rebase or an amend: the work is on $base")
  msg+=("already under other shas, so correct the base= line in $(meta_file "$id") to $base_was,")
  msg+=("the position it did land on, then tear down again. A reset or a force-move: it was taken")
  msg+=("back off $base deliberately, so land it again instead. Nothing is removed until one is")
  msg+=("true.")
  refuse "${msg[@]}"
}

# 4. the landed-work invariant, asked of every copy in the same way.
#
# One question: is everything this errand holds already landed on the base. In
# practice two facts, and BOTH are checked whenever they apply, never one or the
# other. That is the whole fix. The old shape asked about the recorded branch OR
# about the copy's HEAD, chosen by whether branch= was empty, so the RECORD
# decided which check ran and every copy whose record and whose actual shape
# disagreed fell through the gap between them. Three commits closed three holes
# that way, each keying the test on a proxy for danger rather than on danger:
# whether a count came back, then the writes label, then whether branch= was
# empty. A proxy is a lossy summary of the thing it stands for, so each fix
# missed the sibling case its new proxy also could not express.
#
# "Landed" is the strict reading, deliberately: reachable from the RECORDED
# BASE or the holding's DEFAULT BRANCH, the two places this errand's work is
# meant to end up, not from any ref that happens to survive the removal. That is
# the test this script's header claims to own. Conflating it with the looser
# "the commits stay reachable somehow" is where the holes came from, so the
# loose reading is not implemented and is not argued for anywhere below. A copy
# whose record and reality disagree therefore refuses, even when some other
# branch would have kept its commits: the disagreement is the thing worth
# hearing about.
#
# Reachability, not equality. A copy that committed nothing is an ancestor of
# its base, and stays one when unrelated work lands there afterwards, so asking
# whether HEAD equals the base refused the cleanup of every scout and warden the
# moment anything landed on main.

# Paths as git prints them in `worktree list`, which is physically: on macOS
# /var is a symlink to /private/var, so comparing that output against a recorded
# worktree= literally never matches. The directory may be gone, which is the
# case this exists for, so it resolves the deepest ancestor that is still there
# and re-attaches what had to be stripped to reach it.
phys_path() { # phys_path <path> -> the same path with its real ancestors
  local p=$1 tail='' head
  while :; do
    if head=$(cd -P "$p" 2>/dev/null && pwd); then
      [ "$head" = / ] && head=''
      printf '%s%s\n' "$head" "$tail"; return 0
    fi
    case $p in
      */?*) tail="/${p##*/}$tail"; p=${p%/*}; [ -n "$p" ] || p=/ ;;
      *)    printf '%s%s\n' "$p" "$tail"; return 0 ;;
    esac
  done
}

# One field of git's own record of the copy at worktree=. `worktree list
# --porcelain` prints a `worktree <path>` line and then that copy's other
# fields, so the value wanted is the first <field> line after the matching path.
# Empty when git holds no entry for that path, which includes a repo= naming
# nothing git can read: a copy git has never heard of is one this script has to
# treat as never created.
#
# The path and the field go through the environment, not through `awk -v`, which
# backslash-escapes the values it is handed: a worktree path holding a backslash
# would quietly stop matching, and a lookup that misses is a check that skips,
# which is the failure this whole block exists to remove.
copy_record() { # copy_record <field> -> the value, or empty
  [ -n "$repo" ] && [ -n "$wt" ] || return 0
  git -C "$repo" worktree list --porcelain 2>/dev/null \
    | CR_WANT="$(phys_path "$wt")" CR_FIELD="$1" awk '
        $1 == "worktree" { here = (substr($0, 10) == ENVIRON["CR_WANT"]); next }
        here && $1 == ENVIRON["CR_FIELD"] { print $2; exit }'
}

# Whether there is a copy to ask about at all. `[ -d "$wt" ]` used to be the
# whole answer, and it is right for only one of the two things it was asked. For
# the REMOVAL it means "there is nothing to delete", which is true. For this
# CHECK it was read as "there is nothing at risk", which is false: a directory
# that is not there is either a copy that was never created, which holds
# nothing, or a copy that was deleted out of band with commits on it, which
# holds everything, and the filesystem cannot tell those apart. Skipping the
# check on the second reported a pass over an unreachable commit, which the
# `git worktree prune` at the end of this script then destroyed on the next
# teardown in the same repository.
#
# Git can tell them apart: its admin entry under .git/worktrees/ outlives the
# directory and still names that copy's HEAD, so there is something to compare
# even when there is nothing to look at. Refusing on the missing directory alone
# is not the answer and never was, because bin/reeve-brief records worktree=
# before bin/reeve-dispatch creates it: every errand spends that window with a
# recorded copy that does not exist and genuinely nothing at risk.
#
# copy_examined below says which of the two the check actually looked at, and
# the removal reads that rather than deriving its own opinion from the
# filesystem a second time.
copy_at_risk=no
copy_head=''
copy_examined=no
if [ "$writes" != home ] && [ -n "$wt" ]; then
  if [ -d "$wt" ]; then
    copy_at_risk=yes
  else
    copy_head=$(copy_record HEAD)
    [ -n "$copy_head" ] && copy_at_risk=yes
  fi
fi

# --drop-proven: the landed-work test below asks ancestry, and a branch landed
# under other commit ids fails it however safe it is to remove. This mode asks
# the proof instead, the grant's own, with one holder allowed to stand: this
# errand's own copy, clean (checks 2c and 3 above, and nothing untracked) and
# sitting exactly on the tip the proof covered, so removing it loses nothing the
# proof did not. Then the copy goes, and the branch by --delete-proven, which
# proves again with nothing holding it. The session, if any, was freed at 1b.
if [ "$drop_proven" = yes ]; then
  [ -n "$br" ] || refuse "this errand records no branch, so there is nothing to prove."
  ph=$repo
  [ -n "$holding" ] && holding_line "$holding" >/dev/null && ph=$holding
  own_copy=''
  if [ "$writes" != home ] && [ -n "$wt" ] && [ -d "$wt" ]; then
    [ -z "$(git -C "$wt" status --porcelain --untracked-files=all 2>/dev/null)" ] \
      || refuse "the copy at $wt holds untracked files, which go with it."
    own_copy=$(phys_path "$wt")
  fi
  PL_ALLOW_AT=$own_copy prove_landed "$ph" "$br" >/dev/null || refuse "$PL_VERDICT"
  vouched=no
  for r in "${PL_RECORDS[@]}"; do [ "$r" = "$id" ] && vouched=yes; done
  [ "$vouched" = yes ] || refuse "this errand's record does not vouch for $br, so it is the liege's."
  if [ -n "$own_copy" ]; then
    head_now=$(git -C "$wt" rev-parse --verify --quiet HEAD 2>/dev/null) || head_now=''
    [ "$head_now" = "$PL_SHA" ] \
      || refuse "the copy at $wt is at ${head_now:-no readable HEAD}, not on the tip of $br the" \
                "proof covered ($PL_SHA), so removing it could lose what the proof never saw."
  fi
  [ -z "$target" ] || run "$BIN/reeve-backend" call kill "$target" --backend "$backend" \
    || warn "could not close the endpoint $target, continuing"
  [ -z "$launching" ] || run "$BIN/reeve-backend" call kill "$launching" --backend "$backend" \
    || warn "could not close the endpoint $launching, continuing"
  if [ -n "$own_copy" ]; then
    run git -C "$repo" worktree remove "$wt" || refuse "git refused to remove the worktree at $wt." \
      "That refusal is the safety net. Do not add --force; find out what git objected to."
    [ "$dry" = yes ] || rmdir "$(dirname "$wt")" 2>/dev/null || :
  fi
  if [ "$dry" = yes ]; then
    printf '  would run: reeve-teardown --delete-proven %s %s\n' "$ph" "$br"
    info "dry run, nothing changed"; exit 0
  fi
  delete_proven "$ph" "$br" || refuse "the copy is removed, but the branch was not deleted:" \
                                      "${PL_VERDICT:-see above}"
  meta_set "$id" tornDown "$(date +%Y-%m-%dT%H:%M:%S)"
  meta_set "$id" target ''
  [ -z "$launching" ] || meta_set "$id" launching ''
  info "torn down $id"
  [ -f "$(report_file "$id")" ] && info "  report kept: $(report_file "$id")"
  info "  record kept: $(meta_file "$id")"
  exit 0
fi

if [ -n "$br" ] || [ "$copy_at_risk" = yes ]; then
  # The repository is not tested in this condition. Doing so short circuited the
  # whole check before require_base could apply its own guard, so a bad repo=
  # printed "landed-work checks passed" and then a raw fatal: from git further
  # down. The helper owns that message; let it speak.
  require_base

  # 4a. the recorded branch, if there is one, must exist and be landed. Asked
  # first because it is the fact that can name the commits it refuses over,
  # which is the more useful refusal when both facts would fail.
  if [ -n "$br" ]; then
    # A recorded branch that does not resolve is a check that cannot run, not a
    # branch with nothing on it. Skipping it silently reported a pass.
    br_sha=$(git -C "$repo" rev-parse --verify --quiet "refs/heads/$br^{commit}" 2>/dev/null) \
      || br_sha=''
    [ -n "$br_sha" ] || refuse "the recorded branch '$br' does not exist in $repo." \
      "The landed-work test has nothing to compare against, so it stops rather than assume the" \
      "work is safe. Correct the branch= line in $(meta_file "$id"), or find out whether that" \
      "branch was deleted before its commits landed."
    if ! landed_on "$br_sha"; then
      # Asked before the count, because "rebase or merge it first" is advice the
      # reader cannot act on when the branch already did land and the base was
      # rewritten afterwards. Same refusal either way, different diagnosis.
      base_moved_off "$br_sha" && refuse_base_moved "$br" "$br_sha"
      # Counted for the message only, never to decide. --is-ancestor has already
      # decided, and it is non-zero on an error exactly as on unlanded work, so
      # a count that does not come back can no longer read as "nothing unlanded"
      # the way the old fallback to 0 did. Counted against every ref landed_on
      # asked, so the number is the commits that neither of them holds.
      # Both are unquoted on purpose: each is a sha or empty, and empty drops out.
      ahead=$(git -C "$repo" rev-list --count "$br_sha" --not $base_sha $default_sha $also_shas \
              2>/dev/null) \
        || ahead=''
      unlanded=$(git -C "$repo" log --oneline "$br_sha" --not $base_sha $default_sha $also_shas \
                 2>/dev/null \
                 | head -5 | sed 's/^/    /')
      not_on="$base does not have"
      [ -n "$default_sha" ] && not_on="neither $base nor $default_ref has"
      [ -n "$base_sha" ] || not_on="$default_ref does not have"
      [ -z "$also_refs" ] || not_on="$not_on, nor $(printf '%s' "$also_refs" | sed 's/ /, nor /g')"
      # Unless the base did not resolve: that is a record to correct, not the
      # ordinary keep, so it stays a 1.
      [ -n "$base_missing_note" ] || refuse_rc=3
      refuse "$br has ${ahead:-unlanded} commit(s) that $not_on." \
             "$unlanded" \
             "Rebase or merge it first. Removing the copy now leaves the branch, but this is the" \
             "point at which work gets forgotten, so it stops here."
    fi
  fi

  # 4b. the copy's own HEAD, whatever it is or is not sitting on. A branch in
  # the meta file is a claim ABOUT the copy, not an observation OF it, so it is
  # never a substitute for asking the copy itself. The question put to it is the
  # same strict one: is that HEAD on the recorded base, or on the default branch
  # a stacked base lands on. Not whether some other ref would have kept it alive
  # through the removal, which is the loose reading this script does not
  # implement.
  # A steward is excluded by writes=home: it works in the reeve's home, and that
  # same label keeps the removal section below off any path it records anyway.
  if [ "$copy_at_risk" = yes ]; then
    if [ -d "$wt" ]; then
      copy_examined=directory
      head_now=$(git -C "$wt" rev-parse HEAD 2>/dev/null) || head_now=''
      on_branch=$(git -C "$wt" symbolic-ref --short -q HEAD 2>/dev/null) || on_branch=''
    else
      # Nothing to look at, and something to check anyway: the gate above only
      # set copy_at_risk when git still held a HEAD for this path. Asking git is
      # the whole difference between this and reporting a pass over a commit no
      # ref holds.
      copy_examined=record
      head_now=$copy_head
      on_branch=$(copy_record branch); on_branch=${on_branch#refs/heads/}
    fi
    # Fail-closed, and reachable: a worktree= naming a plain directory, or a
    # copy whose worktree admin data was already pruned, both arrive here.
    [ -n "$head_now" ] || refuse "the copy at $wt has no readable HEAD." \
      "This check cannot tell whether that copy committed anything, so it stops rather than" \
      "assume it did not. Look at the copy before removing it."
    # --is-ancestor is non-zero for "not an ancestor" and for "not a commit in
    # this repository" alike, so a repo= naming the wrong repository was
    # diagnosed below as a record/copy disagreement and sent the reader to the
    # branch= line. Separate them here and name the line that is actually wrong.
    git -C "$repo" cat-file -e "$head_now^{commit}" 2>/dev/null \
      || refuse "the copy at $wt is not a copy of $repo." \
           "Its HEAD ($head_now) is not a commit in that repository at all, so there is nothing" \
           "to compare and the test stops rather than read the failure as unlanded work." \
           "Correct the repo= line in $(meta_file "$id")."
    if ! landed_on "$head_now"; then
      # Where the work is, not merely that it is somewhere: the branch a copy
      # sits on is the one fact that finds it again, and a detached copy has
      # none, so this says so rather than leaving the sha to stand alone.
      holds="detached at $head_now"
      [ -n "$on_branch" ] && holds="on $on_branch, at $head_now"
      # Asked before all three, because each of them describes the COPY as the
      # thing that is out of place, and one of the ways to arrive here is the
      # base having moved instead. Two of those three facts survive that
      # rediagnosis rather than being replaced by it, because the base having
      # moved does not make either one less true: git's entry under
      # .git/worktrees/ is still the last root holding that commit, and a copy
      # sitting off a branch that DID land is still a record and a copy that
      # disagree. Both were swallowed by the new diagnosis, and the second one
      # left the reader pointed at base= when that was not the line that went
      # stale, or not the only one.
      [ -n "$br" ] && copy_off_landed_branch=$br
      if base_moved_off "$head_now"; then
        if [ "$copy_examined" = record ]; then
          refuse_base_moved "the copy recorded at $wt ($holds)" "$head_now" \
            "Its directory is not there either, so this is git's own record of the copy rather" \
            "than the copy itself: the entry under .git/worktrees/ still names that HEAD, and it" \
            "is the last root holding that commit until the next 'git worktree prune' in $repo."
        else
          refuse_base_moved "the copy at $wt ($holds)" "$head_now"
        fi
      fi
      if [ "$copy_examined" = record ]; then
        refuse "the copy recorded at $wt holds work that is not on $landed_refs ($holds)." \
               "Its directory is not there, so this is git's own record of the copy rather than" \
               "the copy itself: the entry under .git/worktrees/ still names that HEAD, and the" \
               "next 'git worktree prune' in $repo discards it and the commit with it." \
               "Give that commit a ref (git -C $repo branch <name> $head_now) or land it, then" \
               "tear down again."
      elif [ -n "$br" ]; then
        refuse "the copy at $wt has moved off $landed_refs ($holds)." \
               "$br is landed, but the copy is not on it: the record and the copy disagree, so" \
               "that branch says nothing about what this copy holds. Find out where that work" \
               "belongs, or correct the branch= line in $(meta_file "$id"), then tear down again."
      else
        refuse "the copy at $wt has moved off $landed_refs ($holds)." \
               "It holds work that has not landed on $landed_refs, and this errand records no branch," \
               "so the test has nothing else to ask. Look at the copy before removing it."
      fi
    fi
  fi
fi

info "landed-work checks passed for $id"

# --- removal ---------------------------------------------------------------
if [ -n "$target" ]; then
  run "$BIN/reeve-backend" call kill "$target" --backend "$backend" || warn "could not close the endpoint $target, continuing"
fi
if [ -n "$launching" ]; then
  run "$BIN/reeve-backend" call kill "$launching" --backend "$backend" || warn "could not close the endpoint $launching, continuing"
fi
# The check above and this removal are two decisions that want different answers
# to the same question, asked at different times, so they are deliberately not
# folded into one shared condition. What they must not do is derive that answer
# twice: `[ "$writes" != home ] && [ -n "$wt" ] && [ -d "$wt" ]` stood here as
# well as at the gate, and the one term that can change in between, the
# directory, made them disagree inside a single run. Always in the same
# direction, because the check runs first: check skipped, removal performed, and
# a copy created in that window was removed with its commits on it.
#
# So this asks the check what it did rather than the filesystem what it holds.
# `directory` is the only answer that permits a removal: `record` means the
# check had to read git's entry because the directory was gone, which is also
# the state in which there is nothing to remove.
if [ "$copy_examined" = directory ] && [ -d "$wt" ]; then
  # No --force, ever. A clean merged worktree removes without it, so needing it
  # means git found something unexpected, and that refusal is the safety net.
  run git -C "$repo" worktree remove "$wt" || refuse "git refused to remove the worktree at $wt." "That refusal is the safety net. Do not add --force; find out what git objected to."
  # Deliberately no `git worktree prune` here. It never did anything for this
  # errand: `worktree remove` deletes the admin entry under .git/worktrees/
  # itself, and a remove that fails refuses above instead. What the prune did
  # reach was every OTHER stale entry in the shared repository, and such an
  # entry is the last root holding the commits of a copy whose directory went
  # missing. So this script destroyed, on one errand's cleanup, exactly the work
  # another errand's cleanup now refuses over. Pruning is not this errand's
  # business and never was.
  # rmdir, never rm -r: it removes the shared <repo>.worktrees parent only when
  # this was the last errand in it, and refuses silently if a sibling remains
  [ "$dry" = yes ] || rmdir "$(dirname "$wt")" 2>/dev/null || :
fi
if [ "$drop_branch" = yes ] && [ -n "$br" ]; then
  # -d only, never -D. -d refuses an unmerged branch, which is the whole point.
  # Once gone, the name is free for anyone to reuse. The reflog went with the
  # ref, so a reuse is born again and matches no branchMade=; the record is
  # marked branchDropped= too, which `--prove-landed` refuses outright.
  # -d asks whether the branch is merged into the holding's HEAD. A land onto a
  # branch checked out nowhere leaves HEAD elsewhere, so -d refused landed work
  # there. The default, else the base, whichever holds it, is then made the
  # branch's upstream, the ref -d asks instead: still -d, still refusing anything
  # not on it. Never over an upstream the branch already has, never on a branch
  # some copy has checked out, since -d refuses that anyway and the upstream
  # would outlive the refusal; and taken back off if -d refuses all the same.
  up='' up_set=no
  if ! git -C "$repo" merge-base --is-ancestor "refs/heads/$br" HEAD 2>/dev/null \
     && [ -z "$(git -C "$repo" for-each-ref --format='%(upstream)' "refs/heads/$br" 2>/dev/null)" ] \
     && [ -z "$(git -C "$repo" worktree list --porcelain 2>/dev/null \
                | TD_W="branch refs/heads/$br" awk '$0 == ENVIRON["TD_W"]')" ]; then
    if [ -n "$default_ref" ] && branch_landed "$repo" "$br" "$default_ref"; then up=$default_ref
    elif branch_landed "$repo" "$br" "$base"; then up=$base
    else
      for n in $also_refs; do branch_landed "$repo" "$br" "$n" && { up=$n; break; }; done
    fi
  fi
  if [ -n "$up" ]; then
    if run git -C "$repo" branch -q --set-upstream-to="$up" "$br"; then up_set=yes
    else warn "could not point '$br' at $up for the delete"; fi
  fi
  if run git -C "$repo" branch -d "$br"; then
    [ "$dry" = yes ] || meta_set "$id" branchDropped "$(date +%Y-%m-%dT%H:%M:%S)"
  else
    [ "$up_set" = no ] || [ "$dry" = yes ] \
      || git -C "$repo" branch -q --unset-upstream "$br" 2>/dev/null || :
    warn "git refused to delete '$br' (it is not merged). Leaving it."
  fi
fi

if [ "$dry" = yes ]; then info "dry run, nothing changed"; exit 0; fi
meta_set "$id" tornDown "$(date +%Y-%m-%dT%H:%M:%S)"
meta_set "$id" target ''
[ -z "$launching" ] || meta_set "$id" launching ''
info "torn down $id"
[ -f "$(report_file "$id")" ] && info "  report kept: $(report_file "$id")"
info "  record kept: $(meta_file "$id")"
