#!/usr/bin/env bash
# Clean up a finished errand. Single owner of the landed-work test.
#
# Usage:
#   reeve-teardown <id> [--drop-branch] [--dismiss-only] [--dry-run]
#
# Two separate jobs with different safety conditions. DISMISSING a finished
# hand's session loses nothing and happens as soon as it reports a terminal
# state. REMOVING its copy can lose commits, so that waits until the work has
# landed. --dismiss-only does the first and stops.
#
# Refuses while the errand holds anything its base does not. That is narrower
# than "while work could still be lost", deliberately: it also refuses when some
# other ref would have kept the commits, because a copy whose record and reality
# disagree is the thing worth hearing about. A refusal is a stop-and-investigate
# result, never an obstacle to route around. There is deliberately no --force:
# if git or this script objects, something is there that you did not expect, and
# past that objection the work is unrecoverable.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"
BIN=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

id=${1:-}; shift 2>/dev/null || :
drop_branch=no dry=no dismiss_only=no
while [ $# -gt 0 ]; do
  case $1 in
    --drop-branch) drop_branch=yes; shift ;;
    --dismiss-only) dismiss_only=yes; shift ;;
    --dry-run) dry=yes; shift ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option '$1'" ;;
  esac
done
require_id "$id"
[ -f "$(meta_file "$id")" ] || die "no errand '$id'"

run() { if [ "$dry" = yes ]; then printf '  would run: %s\n' "$*"; else "$@"; fi; }
dismiss=no; dismissed=no
refuse() { printf 'reeve: REFUSED to tear down %s\n' "$id" >&2; printf '  %s\n' "$@" >&2; exit 1; }

repo=$(meta_get "$id" repo '')
wt=$(meta_get "$id" worktree '')
br=$(meta_get "$id" branch '')
base=$(meta_get "$id" base main)
writes=$(meta_get "$id" writes yes)
target=$(meta_get "$id" target '')
backend=$(meta_get "$id" backend herdr)

# 1. the hand must not still be WORKING.
#
# A hand that has reported a terminal state is finished even though its harness
# is still sitting at a prompt: agents do not exit themselves. Refusing on a
# live process alone would mean every completed errand needs a human to close a
# pane before it can be cleaned up, which is exactly the babysitting this
# household exists to remove. So the REPORTED state decides, and the process
# state only decides when the report does not.
reported=$(status_field "$id" state)
open_q=$(status_field "$id" open); open_q=${open_q:-0}
if [ -n "$target" ]; then
  st=$("$BIN/reeve-backend" call agent_state "$target" --backend "$backend" 2>/dev/null || echo unreadable)
  case $st in
    alive)
      case "$reported" in
        done|failed)
          if [ "$open_q" -gt 0 ]; then
            refuse "the hand reported $reported but $open_q question(s) were never answered." "That is a divergence, not a finished errand. Run: reeve-status $id"
          fi
          # Decide only. The actual dismissal happens in the removal section
          # below, AFTER every landed-work check has passed. Announcing it here
          # printed "dismissing its session" and then refused on unlanded work,
          # so the message described something that never happened.
          dismiss=yes ;;
        *)
          refuse "a hand is still working at $target (last reported: ${reported:-nothing yet})." "Let it finish, or stop it deliberately, then tear down." ;;
      esac ;;
    unreadable)
      refuse "the state of the endpoint at $target cannot be read." "Investigate before removing anything: this script cannot tell a working hand from a dead one right now." ;;
  esac
fi

# 1b. Dismiss the finished hand's session NOW, before the removal checks.
# A hand that has reported a terminal state with nothing open is done working;
# its agent is just idling at a prompt holding a pane. Freeing it loses nothing,
# because the status file and any report are already on disk. Doing this after
# the landed-work checks meant an artificer with an unlanded branch kept its
# session alive forever, which is the opposite of cleaning up.
if [ "$dismiss" = yes ] && [ -n "$target" ]; then
  info "dismissing the hand's session, it reported $reported"
  run "$BIN/reeve-backend" call kill "$target" --backend "$backend" \
    || warn "could not close the endpoint $target, continuing"
  [ "$dry" = yes ] || meta_set "$id" target ''
  dismissed=yes
  target=''
fi

if [ "$dismiss_only" = yes ]; then
  [ "$dismissed" = yes ] && info "session freed. The copy and branch are untouched." \
                         || info "nothing to dismiss"
  exit 0
fi

# 2. an open decision means nobody ever answered the question. This still has
# work to do for an errand whose session is already gone.
open=$open_q
if [ "$open" -gt 0 ]; then
  refuse "$open question(s) from this errand were never answered." "Run: reeve-status $id" "Tearing down now discards the work that question was blocking."
fi

# 2b. the recorded permission must be one this script knows.
#
# `writes` decides which landed-work check applies, so a label this script does
# not recognise is a copy it cannot reason about: it cannot tell whether the
# thing was allowed to commit, and therefore cannot tell which proof of safety
# to demand. That is the same position as a base that does not resolve, and it
# gets the same answer. Checked here rather than before the --dismiss-only exit
# because freeing a pane loses nothing whatever the label says.
case $writes in
  yes|no|home) ;;
  *) refuse "the recorded permission 'writes=$writes' is not one of yes, no or home." \
       "That label decides which landed-work check this copy has to pass, so an unknown one" \
       "leaves the script unable to say what would be safe. Correct the writes= line in" \
       "$(meta_file "$id")." ;;
esac

# 3. nothing uncommitted in the copy
if [ "$writes" != home ] && [ -n "$wt" ] && [ -d "$wt" ]; then
  dirty=$(git -C "$wt" status --porcelain 2>/dev/null)
  if [ -n "$dirty" ]; then
    refuse "the copy at $wt has uncommitted changes:" "$(printf '%s' "$dirty" | head -5 | sed 's/^/    /')" "Commit them on $br, or discard them deliberately yourself. This script will not."
  fi
fi

# The landed-work invariant below compares against the recorded base, and it is
# only as trustworthy as that comparison. It therefore refuses when the
# comparison cannot be made: a verification that cannot run is a refusal, never
# a pass. This is not hypothetical tidiness. `rev-list --count` used to fall back
# to 0 on failure, and 0 reads as "nothing unlanded", so a base that no longer
# resolved was indistinguishable from a fully landed branch and the copy was
# removed with its commits still on it.
#
# Resolved on first use rather than up front, so an errand whose checks never
# consult the base is not refused over a base it does not use.
base_sha=''
require_base() {
  [ -n "$base_sha" ] && return 0
  # Deliberate fail-closed guard, not dead code: the invariant below calls this
  # before it touches git, so an errand with no repository recorded is told why
  # the test stopped instead of being shown a raw fatal: from git afterwards.
  [ -n "$repo" ] || refuse "no repository is recorded for this errand." \
    "The landed-work test has nothing to compare against, so it stops. Check the repo= line in" \
    "$(meta_file "$id")."
  base_sha=$(git -C "$repo" rev-parse --verify --quiet "$base^{commit}" 2>/dev/null) || base_sha=''
  [ -n "$base_sha" ] && return 0
  # No guessing a replacement. Falling back to main, to HEAD or to the default
  # branch is the same fail-open wearing a friendlier face.
  refuse "the recorded base '$base' does not name a commit in $repo." \
    "Without it this script cannot tell landed work from unlanded work, so it refuses rather than" \
    "assume the work is safe. Usually that base has itself landed and been deleted." \
    "Correct the base= line in $(meta_file "$id") to the branch the work actually landed on," \
    "then tear down again."
}

# 4. the landed-work invariant, asked of every copy in the same way.
#
# One question: is everything this errand holds already landed on the base. In
# practice two facts, and BOTH are checked whenever they apply, never one or the
# other. That is the whole fix. The old shape asked about the recorded branch OR
# about the copy's HEAD, chosen by whether branch= was empty, so the RECORD
# decided which check ran and every copy whose record and whose actual shape
# disagreed fell through the gap between them. Three commits closed three holes
# that way, each keying the test on a proxy for danger rather than on danger:
# whether a count came back, then the writes label, then whether branch= was
# empty. A proxy is a lossy summary of the thing it stands for, so each fix
# missed the sibling case its new proxy also could not express.
#
# "Landed" is the strict reading, deliberately: reachable from the RECORDED
# BASE, not from any ref that happens to survive the removal. That is the test
# this script's header claims to own. Conflating it with the looser "the commits
# stay reachable somehow" is where the holes came from, so the loose reading is
# not implemented and is not argued for anywhere below. A copy whose record and
# reality disagree therefore refuses, even when some other branch would have
# kept its commits: the disagreement is the thing worth hearing about.
#
# Reachability, not equality. A copy that committed nothing is an ancestor of
# its base, and stays one when unrelated work lands there afterwards, so asking
# whether HEAD equals the base refused the cleanup of every scout and warden the
# moment anything landed on main.

# Paths as git prints them in `worktree list`, which is physically: on macOS
# /var is a symlink to /private/var, so comparing that output against a recorded
# worktree= literally never matches. The directory may be gone, which is the
# case this exists for, so it resolves the deepest ancestor that is still there
# and re-attaches what had to be stripped to reach it.
phys_path() { # phys_path <path> -> the same path with its real ancestors
  local p=$1 tail='' head
  while :; do
    if head=$(cd -P "$p" 2>/dev/null && pwd); then
      [ "$head" = / ] && head=''
      printf '%s%s\n' "$head" "$tail"; return 0
    fi
    case $p in
      */?*) tail="/${p##*/}$tail"; p=${p%/*}; [ -n "$p" ] || p=/ ;;
      *)    printf '%s%s\n' "$p" "$tail"; return 0 ;;
    esac
  done
}

# One field of git's own record of the copy at worktree=. `worktree list
# --porcelain` prints a `worktree <path>` line and then that copy's other
# fields, so the value wanted is the first <field> line after the matching path.
# Empty when git holds no entry for that path, which includes a repo= naming
# nothing git can read: a copy git has never heard of is one this script has to
# treat as never created.
#
# The path and the field go through the environment, not through `awk -v`, which
# backslash-escapes the values it is handed: a worktree path holding a backslash
# would quietly stop matching, and a lookup that misses is a check that skips,
# which is the failure this whole block exists to remove.
copy_record() { # copy_record <field> -> the value, or empty
  [ -n "$repo" ] && [ -n "$wt" ] || return 0
  git -C "$repo" worktree list --porcelain 2>/dev/null \
    | CR_WANT="$(phys_path "$wt")" CR_FIELD="$1" awk '
        $1 == "worktree" { here = (substr($0, 10) == ENVIRON["CR_WANT"]); next }
        here && $1 == ENVIRON["CR_FIELD"] { print $2; exit }'
}

# Whether there is a copy to ask about at all. `[ -d "$wt" ]` used to be the
# whole answer, and it is right for only one of the two things it was asked. For
# the REMOVAL it means "there is nothing to delete", which is true. For this
# CHECK it was read as "there is nothing at risk", which is false: a directory
# that is not there is either a copy that was never created, which holds
# nothing, or a copy that was deleted out of band with commits on it, which
# holds everything, and the filesystem cannot tell those apart. Skipping the
# check on the second reported a pass over an unreachable commit, which the
# `git worktree prune` at the end of this script then destroyed on the next
# teardown in the same repository.
#
# Git can tell them apart: its admin entry under .git/worktrees/ outlives the
# directory and still names that copy's HEAD, so there is something to compare
# even when there is nothing to look at. Refusing on the missing directory alone
# is not the answer and never was, because bin/reeve-brief records worktree=
# before bin/reeve-dispatch creates it: every errand spends that window with a
# recorded copy that does not exist and genuinely nothing at risk.
#
# copy_examined below says which of the two the check actually looked at, and
# the removal reads that rather than deriving its own opinion from the
# filesystem a second time.
copy_at_risk=no
copy_head=''
copy_examined=no
if [ "$writes" != home ] && [ -n "$wt" ]; then
  if [ -d "$wt" ]; then
    copy_at_risk=yes
  else
    copy_head=$(copy_record HEAD)
    [ -n "$copy_head" ] && copy_at_risk=yes
  fi
fi

if [ -n "$br" ] || [ "$copy_at_risk" = yes ]; then
  # The repository is not tested in this condition. Doing so short circuited the
  # whole check before require_base could apply its own guard, so a bad repo=
  # printed "landed-work checks passed" and then a raw fatal: from git further
  # down. The helper owns that message; let it speak.
  require_base

  # 4a. the recorded branch, if there is one, must exist and be landed. Asked
  # first because it is the fact that can name the commits it refuses over,
  # which is the more useful refusal when both facts would fail.
  if [ -n "$br" ]; then
    # A recorded branch that does not resolve is a check that cannot run, not a
    # branch with nothing on it. Skipping it silently reported a pass.
    br_sha=$(git -C "$repo" rev-parse --verify --quiet "refs/heads/$br^{commit}" 2>/dev/null) \
      || br_sha=''
    [ -n "$br_sha" ] || refuse "the recorded branch '$br' does not exist in $repo." \
      "The landed-work test has nothing to compare against, so it stops rather than assume the" \
      "work is safe. Correct the branch= line in $(meta_file "$id"), or find out whether that" \
      "branch was deleted before its commits landed."
    if ! git -C "$repo" merge-base --is-ancestor "$br_sha" "$base_sha" 2>/dev/null; then
      # Counted for the message only, never to decide. --is-ancestor has already
      # decided, and it is non-zero on an error exactly as on unlanded work, so
      # a count that does not come back can no longer read as "nothing unlanded"
      # the way the old fallback to 0 did.
      ahead=$(git -C "$repo" rev-list --count "$base_sha..$br_sha" 2>/dev/null) || ahead=''
      unlanded=$(git -C "$repo" log --oneline "$base_sha..$br_sha" 2>/dev/null \
                 | head -5 | sed 's/^/    /')
      refuse "$br has ${ahead:-unlanded} commit(s) that $base does not have." \
             "$unlanded" \
             "Rebase or merge it first. Removing the copy now leaves the branch, but this is the" \
             "point at which work gets forgotten, so it stops here."
    fi
  fi

  # 4b. the copy's own HEAD, whatever it is or is not sitting on. A branch in
  # the meta file is a claim ABOUT the copy, not an observation OF it, so it is
  # never a substitute for asking the copy itself. The question put to it is the
  # same strict one: is that HEAD on the recorded base. Not whether some other
  # ref would have kept it alive through the removal, which is the loose reading
  # this script does not implement.
  # A steward is excluded by writes=home: it works in the reeve's home, and that
  # same label keeps the removal section below off any path it records anyway.
  if [ "$copy_at_risk" = yes ]; then
    if [ -d "$wt" ]; then
      copy_examined=directory
      head_now=$(git -C "$wt" rev-parse HEAD 2>/dev/null) || head_now=''
      on_branch=$(git -C "$wt" symbolic-ref --short -q HEAD 2>/dev/null) || on_branch=''
    else
      # Nothing to look at, and something to check anyway: the gate above only
      # set copy_at_risk when git still held a HEAD for this path. Asking git is
      # the whole difference between this and reporting a pass over a commit no
      # ref holds.
      copy_examined=record
      head_now=$copy_head
      on_branch=$(copy_record branch); on_branch=${on_branch#refs/heads/}
    fi
    # Fail-closed, and reachable: a worktree= naming a plain directory, or a
    # copy whose worktree admin data was already pruned, both arrive here.
    [ -n "$head_now" ] || refuse "the copy at $wt has no readable HEAD." \
      "This check cannot tell whether that copy committed anything, so it stops rather than" \
      "assume it did not. Look at the copy before removing it."
    # --is-ancestor is non-zero for "not an ancestor" and for "not a commit in
    # this repository" alike, so a repo= naming the wrong repository was
    # diagnosed below as a record/copy disagreement and sent the reader to the
    # branch= line. Separate them here and name the line that is actually wrong.
    git -C "$repo" cat-file -e "$head_now^{commit}" 2>/dev/null \
      || refuse "the copy at $wt is not a copy of $repo." \
           "Its HEAD ($head_now) is not a commit in that repository at all, so there is nothing" \
           "to compare and the test stops rather than read the failure as unlanded work." \
           "Correct the repo= line in $(meta_file "$id")."
    if ! git -C "$repo" merge-base --is-ancestor "$head_now" "$base_sha" 2>/dev/null; then
      # Where the work is, not merely that it is somewhere: the branch a copy
      # sits on is the one fact that finds it again, and a detached copy has
      # none, so this says so rather than leaving the sha to stand alone.
      holds="detached at $head_now"
      [ -n "$on_branch" ] && holds="on $on_branch, at $head_now"
      if [ "$copy_examined" = record ]; then
        refuse "the copy recorded at $wt holds work that is not on $base ($holds)." \
               "Its directory is not there, so this is git's own record of the copy rather than" \
               "the copy itself: the entry under .git/worktrees/ still names that HEAD, and the" \
               "next 'git worktree prune' in $repo discards it and the commit with it." \
               "Give that commit a ref (git -C $repo branch <name> $head_now) or land it, then" \
               "tear down again."
      elif [ -n "$br" ]; then
        refuse "the copy at $wt has moved off $base ($holds)." \
               "$br is landed, but the copy is not on it: the record and the copy disagree, so" \
               "that branch says nothing about what this copy holds. Find out where that work" \
               "belongs, or correct the branch= line in $(meta_file "$id"), then tear down again."
      else
        refuse "the copy at $wt has moved off $base ($holds)." \
               "It holds work that has not landed on $base, and this errand records no branch," \
               "so the test has nothing else to ask. Look at the copy before removing it."
      fi
    fi
  fi
fi

info "landed-work checks passed for $id"

# --- removal ---------------------------------------------------------------
if [ -n "$target" ]; then
  run "$BIN/reeve-backend" call kill "$target" --backend "$backend" || warn "could not close the endpoint $target, continuing"
fi
# The check above and this removal are two decisions that want different answers
# to the same question, asked at different times, so they are deliberately not
# folded into one shared condition. What they must not do is derive that answer
# twice: `[ "$writes" != home ] && [ -n "$wt" ] && [ -d "$wt" ]` stood here as
# well as at the gate, and the one term that can change in between, the
# directory, made them disagree inside a single run. Always in the same
# direction, because the check runs first: check skipped, removal performed, and
# a copy created in that window was removed with its commits on it.
#
# So this asks the check what it did rather than the filesystem what it holds.
# `directory` is the only answer that permits a removal: `record` means the
# check had to read git's entry because the directory was gone, which is also
# the state in which there is nothing to remove.
if [ "$copy_examined" = directory ] && [ -d "$wt" ]; then
  # No --force, ever. A clean merged worktree removes without it, so needing it
  # means git found something unexpected, and that refusal is the safety net.
  run git -C "$repo" worktree remove "$wt" || refuse "git refused to remove the worktree at $wt." "That refusal is the safety net. Do not add --force; find out what git objected to."
  # Deliberately no `git worktree prune` here. It never did anything for this
  # errand: `worktree remove` deletes the admin entry under .git/worktrees/
  # itself, and a remove that fails refuses above instead. What the prune did
  # reach was every OTHER stale entry in the shared repository, and such an
  # entry is the last root holding the commits of a copy whose directory went
  # missing. So this script destroyed, on one errand's cleanup, exactly the work
  # another errand's cleanup now refuses over. Pruning is not this errand's
  # business and never was.
  # rmdir, never rm -r: it removes the shared <repo>.worktrees parent only when
  # this was the last errand in it, and refuses silently if a sibling remains
  [ "$dry" = yes ] || rmdir "$(dirname "$wt")" 2>/dev/null || :
fi
if [ "$drop_branch" = yes ] && [ -n "$br" ]; then
  # -d only, never -D. -d refuses an unmerged branch, which is the whole point.
  run git -C "$repo" branch -d "$br" || warn "git refused to delete '$br' (it is not merged). Leaving it."
fi

if [ "$dry" = yes ]; then info "dry run, nothing changed"; exit 0; fi
meta_set "$id" tornDown "$(date +%Y-%m-%dT%H:%M:%S)"
meta_set "$id" target ''
info "torn down $id"
[ -f "$(report_file "$id")" ] && info "  report kept: $(report_file "$id")"
info "  record kept: $(meta_file "$id")"
