#!/usr/bin/env bash
# A Claude Code Stop hook: send a reeve back when it ends its turn with an
# errand of its own in flight and no watch running, the AGENTS.md section 6
# rule. Without a watch nothing tells it the hand finished, or that a question
# answered in the hand's own session was answered.
#
# Usage, from hooks/hooks.json (the plugin) and .claude/settings.json (a session
# started inside the clone), never by hand:
#   bin/reeve-watch-guard < <Stop hook input JSON>
#
# Acts only on a reeve, by bin/reeve-format-guard's test: REEVE_HAND unset, and
# the hook's session_id has a name record under $REEVE_HOME/state/sessions/<sid>/name.
# Every other session, a hand or a stranger, exits 0 with nothing said at all.
#
# In flight: an errand whose record names this session as its owner, that went
# out (target= or dispatched=, live_errands' test in bin/reeve-sentry) and was
# not torn down, and whose reconciled state is not done or failed. So working,
# waiting, idle, wedged, blocked and an open question all count, a divergence
# included, and a finished hand does not. An errand with no recorded owner is
# not this reeve's to answer for.
#
# Not in flight, because no watch could wait on it: an errand whose hand's
# session is gone (agent_state dead or missing, the sentry's `stale:`). The
# sentry says that once per gone session, so a watch started after it keeps
# running over the rest, and the rest are still checked: one send-back, never a
# loop. Where the sentry cannot record it said (its gone latch unwritten and
# state/ not writable), every watch repeats it and exits at once, and that
# counts as started for the whole session.
#
# A watch is running when this session's watch marker is live (watch_live_for),
# or the marker of a session that this one succeeded after /clear: a watch
# started before the /clear follows its successor and moves its marker within
# one poll.
#
# Counts as started, though no marker is up yet:
#   - the turn's last reeve-sentry run, read from transcript_path, when it went
#     to the background and no notification of its exit (a task notification
#     naming its tool call) was delivered into the turn since, as a
#     queued_command attachment or a user entry. That covers only the moment
#     before a fresh watch writes its marker. A notification only enqueued or
#     dequeued has not reached the reeve: it arrives as the next turn, which
#     wakes the reeve anyway, so it passes. A run the turn saw finish, in the
#     foreground or by a delivered notification, is a watch that has stopped,
#     so the marker alone decides; a watch that at once repeats a line already
#     reported costs one send-back, never a loop. A run is a Bash tool call
#     whose command runs it, not as --caretaker, --once or --help. The turn is
#     everything since the last real user prompt, as for
#     bin/reeve-format-guard, so a watch from an earlier turn does not count.
#   - a wake spool holding lines it cannot give up (the sentry's
#     `undeliverable:`), since every watch would exit on it at once.
#
# When it sends the reeve back it prints
#   {"hookSpecificOutput":{"hookEventName":"Stop","additionalContext":"..."}}
# with one line naming the errands and telling it to start reeve-sentry in the
# background before ending the turn. Claude Code continues the turn.
#
# Never wedges a session:
#   - stop_hook_active true means this turn was already sent back once, by this
#     hook or another, so it passes. One correction per turn, never a loop.
#   - a claim per turn, keyed by the prompt that opened it, so two copies of
#     this hook on one stop (plugin and project settings) send back once, and a
#     later stop in the same turn passes even without stop_hook_active.
#   - anything it cannot read or parse passes, with one note on stderr.
#
# Exit: always 0. The decision is the JSON on stdout.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"

case ${1:-} in -h|--help) print_help "$0"; exit 0 ;; esac

BIN=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# Fail open, said once. Only ever reached once the session is known a reeve's.
pass() { [ -n "${1:-}" ] && printf 'reeve-watch-guard: %s, not checked\n' "$1" >&2; exit 0; }

[ -z "${REEVE_HAND:-}" ] || exit 0
input=$(cat) || exit 0

sid=$(hook_session "$input")
[ -n "$sid" ] && [ -n "$(session_name "$sid")" ] || exit 0

# Owned, sent out, not torn down, not finished. The reconciled state, never the
# last line: status_field is the one reader.
# One grep over every record narrows to the ones naming this session at all;
# meta_get, which reads the first session= line, still decides.
candidates() {
  local f i
  grep -l -x -F -e "session=$sid" -- "$REEVE_HOME_D/state"/*.meta 2>/dev/null |
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    i=$(basename "$f" .meta)
    [ "$(meta_get "$i" session '')" = "$sid" ] || continue
    [ -n "$(meta_get "$i" target '')" ] || [ -n "$(meta_get "$i" dispatched '')" ] || continue
    [ -z "$(meta_get "$i" tornDown '')" ] || continue
    case $(status_field "$i" state) in done|failed) continue ;; esac
    printf '%s\n' "$i"
  done
}

# This session's own marker, or a predecessor's that has not followed yet.
watching() {
  local f s
  watch_live_for "$sid" && return 0
  for f in "$REEVE_HOME_D/state"/.sentry.watch-*; do
    [ -f "$f" ] || continue
    s=${f##*/.sentry.watch-}
    [ "$s" != "$sid" ] && [ "$(session_follow "$s")" = "$sid" ] || continue
    marker_alive "$(marker_read "$f")" && return 0
  done
  return 1
}

# Lines in the spool that wake_deliver could not claim: every watch would print
# `undeliverable:` and exit.
spool_stuck() {
  local d; d=$(wake_dir "$sid")
  [ -n "$(wake_pending "$sid")" ] && [ ! -w "$d" ]
}

# The marker first: a reeve with a watch running reads no errand record.
watching && exit 0
spool_stuck && exit 0
ids=$(candidates)
[ -n "$ids" ] || exit 0

command -v python3 >/dev/null 2>&1 || pass 'python3 not on PATH'

# One python pass, one field per line: session id, whether a stop hook is
# already active, whether this turn left a watch starting, then the turn's
# claim key.
out=$(printf '%s' "$input" | python3 -c '
import hashlib, json, re, sys

def is_prompt(e):
    # bin/reeve-format-guard: a tool result and Claude Code meta entries are
    # part of the turn they sit in, anything else a user entry is opens one.
    if e.get("isMeta"):
        return False
    c = (e.get("message") or {}).get("content")
    if isinstance(c, list) and c and all(
            isinstance(b, dict) and b.get("type") == "tool_result" for b in c):
        return False
    return True

# reeve-sentry at a command position: the start, or after ; & | ( or a
# newline, past any VAR=value assignments and the usual wrappers. Its own
# arguments run to the end of that command.
SENTRY = re.compile(
    r"(?:^|[;&|(\n]|\$\()\s*"
    r"(?:[A-Za-z_][A-Za-z0-9_]*=\S*\s+|(?:nohup|exec|command|env|bash|sh|timeout\s+\S+)\s+)*"
    r"(?:\S*/)?reeve-sentry(?=$|[\s;&|)\"\x27])([^;&|\n)]*)")
NOT_A_WATCH = re.compile(r"(?:^|\s)(?:--caretaker|--once|-h|--help)(?=$|\s)")

# A heredoc body is data, not commands: a brief written with cat <<EOF that
# names the sentry on a line of its own runs nothing.
HEREDOC = re.compile(r"(?<!<)<<(?!<)(-?)\s*([\"\x27]?)([A-Za-z_][A-Za-z0-9_]*)\2")

def unheredoc(cmd):
    kept, ends, held = [], [], []
    for line in cmd.split("\n"):
        if ends:
            held.append(line)
            strip, word = ends[0]
            if (line.lstrip("\t") if strip else line) == word:
                ends.pop(0)
                if not ends:
                    held = []
            continue
        kept.append(line)
        ends = [(m.group(1) == "-", m.group(3)) for m in HEREDOC.finditer(line)]
    # No terminator by the end: a <<WORD bash did not take for a heredoc, or
    # whose real word runs longer than the one read here. Its lines are
    # commands after all, so they are kept.
    return "\n".join(kept + held)

def runs_watch(b):
    # Only what a Bash call runs: a Write whose content names the sentry is not
    # a watch.
    if not isinstance(b, dict) or b.get("type") != "tool_use" or b.get("name") != "Bash":
        return False
    cmd = (b.get("input") or {}).get("command")
    if not isinstance(cmd, str):
        return False
    for m in SENTRY.finditer(unheredoc(cmd)):
        if not NOT_A_WATCH.search(m.group(1)):
            return True
    return False

def turn(path):
    entries = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                entries.append((line, json.loads(line)))
    start, marker = 0, "n%d" % len(entries)
    for n in range(len(entries) - 1, -1, -1):
        e = entries[n][1]
        if isinstance(e, dict) and e.get("type") == "user" and is_prompt(e):
            if isinstance(e.get("uuid"), str) and e["uuid"]:
                marker = "u" + e["uuid"]
            start = n + 1
            break
    # The last watch of the turn, and where it sits.
    last, at = None, -1
    for n in range(start, len(entries)):
        e = entries[n][1]
        if not isinstance(e, dict) or e.get("type") != "assistant":
            continue
        for b in (e.get("message") or {}).get("content") or []:
            if runs_watch(b):
                last, at = b, n
    if last is None or (last.get("input") or {}).get("run_in_background") is not True:
        return False, marker
    tid = last.get("id")
    if not isinstance(tid, str) or not tid:
        return False, marker
    # Its exit, delivered into this turn: a notification queued into it as an
    # attachment, or a user entry. A queue-operation line is written the
    # moment the watch exits, before the reeve has seen anything, and its
    # notification then arrives as the next turn and wakes the reeve anyway.
    tag = "<tool-use-id>%s</tool-use-id>" % tid
    for line, e in entries[at + 1:]:
        if tag not in line or not isinstance(e, dict):
            continue
        kind = e.get("type")
        if kind == "user" or (kind == "attachment" and
                              (e.get("attachment") or {}).get("type") == "queued_command"):
            return False, marker
    return True, marker

h = json.loads(sys.stdin.read())
if not isinstance(h, dict):
    raise ValueError("hook input is not an object")
sid = h.get("session_id")
if not isinstance(sid, str) or not sid:
    raise ValueError("no session_id")
active = h.get("stop_hook_active") is True
print(sid)
print("1" if active else "0")
if active:
    sys.exit(0)
path = h.get("transcript_path")
if not isinstance(path, str) or not path:
    raise ValueError("no transcript_path")
ran, marker = turn(path)
print("1" if ran else "0")
print(hashlib.sha1((sid + "\0" + marker).encode("utf-8")).hexdigest())
' 2>/dev/null) || pass 'could not parse the hook input or transcript'

psid=$(printf '%s\n' "$out" | sed -n 1p)
active=$(printf '%s\n' "$out" | sed -n 2p)
ran=$(printf '%s\n' "$out" | sed -n 3p)
key=$(printf '%s\n' "$out" | sed -n 4p)

[ "$active" = 0 ] || exit 0
[ "$psid" = "$sid" ] || pass 'session id read two ways disagrees'
[ "$ran" = 0 ] || exit 0

# A gone session's `stale:` that no watch can record as said: every watch says
# it again and exits at once, which the sentry warns about, and AGENTS.md
# section 6 counts that repeat as started. Recorded, a watch stays quiet over it.
gone_stuck() {
  local latch
  latch=$(stale_latch "$1" "$(stale_mark "$1")" gone) && [ "${latch#* }" = yes ] && return 1
  [ ! -w "$REEVE_HOME_D/state" ]
}

# The costly half last: one backend call per errand still standing. A session
# that is gone is the sentry's `stale:`, not work a watch could wait on. One
# that cannot be read is not proof of anything, so it stays in flight.
left=''
while IFS= read -r i; do
  [ -n "$i" ] || continue
  if errand_session "$i" "$BIN"; then
    case $live in dead|missing) gone_stuck "$i" && exit 0; continue ;; esac
  fi
  left="$left${left:+, }$i"
done <<EOS
$ids
EOS
[ -n "$left" ] || exit 0

# One correction per turn, however many copies of this hook run on it. A claim
# is a directory, so exactly one copy creates it. Keyed by the turn, so claims
# older than an hour are a past turn's and go first.
d=$(session_dir "$sid")
mkdir -p "$d" 2>/dev/null || pass 'session record not writable'
now=$(date +%s)
for c in "$d"/watch-guard.*; do
  [ -d "$c" ] || continue
  m=$(file_mtime "$c") || continue
  [ $((now - m)) -le 3600 ] || rmdir "$c" 2>/dev/null
done
case $key in ''|*[!0-9a-f]*) pass 'no turn hash' ;; esac
mkdir "$d/watch-guard.$key" 2>/dev/null || exit 0

reason="In flight with no watch running: $left. Start reeve-sentry in the background now, before ending this turn (AGENTS.md section 6), or nothing tells you when they finish or are answered in their own session."
python3 -c 'import json, sys; print(json.dumps({"hookSpecificOutput": {"hookEventName": "Stop", "additionalContext": sys.argv[1]}}))' "$reason" \
  || pass 'could not write the correction'
