#!/usr/bin/env bash
# A Claude Code Stop hook: send a reeve back when its turn is missing the report
# shape of AGENTS.md section 8.
#
# Usage, from hooks/hooks.json (the plugin) and .claude/settings.json (a session
# started inside the clone), never by hand:
#   bin/reeve-format-guard < <Stop hook input JSON>
#
# Acts only on a reeve: REEVE_HAND unset, and the hook's session_id has a name
# record under $REEVE_HOME/state/sessions/<sid>/name. Both are settled before
# anything else runs, python3 and the transcript included, so every other
# session, a hand or a stranger, exits 0 with nothing said at all.
#
# A reeve's turn must carry both a "Done this session" heading and a "Next
# action" line, in their bold markdown forms (a colon or full stop inside the
# bold is fine, and a `#` heading also counts). Missing either, it prints
#   {"hookSpecificOutput":{"hookEventName":"Stop","additionalContext":"..."}}
# naming what is missing. Claude Code continues the turn so the reeve can fix
# the reply, and shows it as hook feedback rather than a hook error: a quiet
# correction, not an alarm in front of the liege.
#
# The turn is every assistant text since the last real user prompt, read from
# transcript_path: back to the last user entry that is neither a tool result
# nor Claude Code's own meta entry. The hook's last_assistant_message is added
# when the transcript does not already end with it, and stands alone when the
# transcript cannot be read. So a reeve that writes the full report, starts a
# watch, then closes on "Watch started." is not sent back. Fenced and indented
# code blocks are removed first, so a quoted template does not count.
#
# Never wedges a session:
#   - stop_hook_active true means this turn was already sent back once, so it
#     passes, whatever the reply says. One correction per turn, never a loop.
#   - anything it cannot read or parse passes, with one note on stderr.
#   - a session with both the plugin and the clone's project settings runs this
#     twice on the same stop, because Claude Code deduplicates settings files
#     but keeps a plugin's copy separate. The first to claim the stop sends the
#     reeve back, the other passes, so the reeve gets one reason. The claim is
#     keyed by the turn (its prompt's transcript entry) and the turn's text,
#     so an identical reply in a later turn is checked afresh.
#
# Exit: always 0. The decision is the JSON on stdout.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"

case ${1:-} in -h|--help) print_help "$0"; exit 0 ;; esac

# Fail open, said once. Only ever reached once the session is known a reeve's.
pass() { [ -n "${1:-}" ] && printf 'reeve-format-guard: %s, not checked\n' "$1" >&2; exit 0; }

[ -z "${REEVE_HAND:-}" ] || exit 0
input=$(cat) || exit 0

# Only a reeve: a session that holds a reeve name. The id is lifted from the
# raw input by text alone (hook_session), so a stranger costs no python and no
# transcript read; python checks it against the parsed input below.
# reeve_session's own rule decides what a usable id is; anything else is a
# stranger's.
sid=$(hook_session "$input")
[ -n "$sid" ] && [ -n "$(session_name "$sid")" ] || exit 0

command -v python3 >/dev/null 2>&1 || pass 'python3 not on PATH'

# One python pass reads everything, one field per line: session id, whether a
# stop hook is already active, then what the turn lacks, then the claim key.
# The reply itself never crosses into the shell.
out=$(printf '%s' "$input" | python3 -c '
import hashlib, json, re, sys

def text_of(content):
    if isinstance(content, str):
        return [content]
    out = []
    for b in content or []:
        if isinstance(b, dict) and b.get("type") == "text" and isinstance(b.get("text"), str):
            out.append(b["text"])
    return out

def is_prompt(e):
    # A real user prompt opens a turn. A tool result and Claude Code meta
    # entries are part of the turn they sit in.
    if e.get("isMeta"):
        return False
    c = (e.get("message") or {}).get("content")
    if isinstance(c, list) and c and all(
            isinstance(b, dict) and b.get("type") == "tool_result" for b in c):
        return False
    return True

def turn(path):
    # Every assistant text of the turn, one item per entry, and the turn
    # marker: the uuid of the prompt that opened it, else the entry count.
    entries = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                entries.append(json.loads(line))
    texts, marker = [], "n%d" % len(entries)
    for e in reversed(entries):
        if not isinstance(e, dict):
            continue
        kind = e.get("type")
        if kind == "user" and is_prompt(e):
            if isinstance(e.get("uuid"), str) and e["uuid"]:
                marker = "u" + e["uuid"]
            break
        if kind == "assistant":
            texts = ["\n".join(text_of((e.get("message") or {}).get("content")))] + texts
    return texts, marker

FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})")

def strip_code(text):
    # Drop fenced blocks (an unclosed fence runs to the end) and indented
    # blocks (four spaces or a tab, opened only after a blank line).
    out, fence, blank, indented = [], None, True, False
    for line in text.split("\n"):
        if fence:
            m = FENCE.match(line)
            if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence) \
                    and not line[m.end():].strip():
                fence = None
            continue
        m = FENCE.match(line)
        if m and not (m.group(1)[0] == "`" and "`" in line[m.end():]):
            fence, indented = m.group(1), False
            continue
        if line.strip() and re.match(r"^( {4}|\t)", line) and (blank or indented):
            indented = True
            continue
        if line.strip():
            indented = False
        blank = not line.strip()
        out.append(line)
    return "\n".join(out)

h = json.loads(sys.stdin.read())
if not isinstance(h, dict):
    raise ValueError("hook input is not an object")
sid = h.get("session_id")
if not isinstance(sid, str) or not sid:
    raise ValueError("no session_id")
active = h.get("stop_hook_active") is True
print(sid)
print("1" if active else "0")
if active:
    sys.exit(0)

texts, marker = [], ""
path = h.get("transcript_path")
if isinstance(path, str) and path:
    try:
        texts, marker = turn(path)
    except (OSError, ValueError):
        texts, marker = [], ""
last = h.get("last_assistant_message")
if isinstance(last, str) and last.strip() \
        and not "\n".join(texts).rstrip().endswith(last.strip()):
    texts.append(last)
reply = "\n".join(strip_code(t) for t in texts)
if not "\n".join(texts).strip():
    raise ValueError("no assistant text found")

missing = []
if not re.search(r"^[ \t]*(\*\*Done this session\b[^*\n]*\*\*|#{1,6}[ \t]+Done this session\b)", reply, re.M):
    missing.append("Done this session")
if not re.search(r"^[ \t]*(\*\*Next action\b[^*\n]*\*\*|#{1,6}[ \t]+Next action\b)", reply, re.M):
    missing.append("Next action")
print(" and ".join("**%s**" % m for m in missing))
print(hashlib.sha1((marker + "\0" + reply).encode("utf-8")).hexdigest())
' 2>/dev/null) || pass 'could not parse the hook input or transcript'

psid=$(printf '%s\n' "$out" | sed -n 1p)
active=$(printf '%s\n' "$out" | sed -n 2p)
missing=$(printf '%s\n' "$out" | sed -n 3p)
key=$(printf '%s\n' "$out" | sed -n 4p)

[ "$active" = 0 ] || exit 0
[ "$psid" = "$sid" ] || pass 'session id read two ways disagrees'
[ -n "$missing" ] || exit 0

# One correction per stop, however many copies of this hook run on it. A claim
# is a directory, so exactly one copy creates it. Claims older than two minutes
# are cleared first: the copies of one stop run together, so an older claim is
# a past stop's, and the key already tells one turn from the next.
d=$(session_dir "$sid")
now=$(date +%s)
for c in "$d"/format-guard.*; do
  [ -d "$c" ] || continue
  m=$(file_mtime "$c") || continue
  [ $((now - m)) -le 120 ] || rmdir "$c" 2>/dev/null
done
case $key in ''|*[!0-9a-f]*) pass 'no turn hash' ;; esac
mkdir "$d/format-guard.$key" 2>/dev/null || exit 0

reason="Reply is missing $missing. A reeve's reply to the liege takes the report shape of AGENTS.md section 8: a **Done this session** block (\`- nothing yet\` when nothing has finished), then the live blocks, closing with **Waiting on you** if anything waits and a **Next action.** line. Rewrite the reply in that shape."
python3 -c 'import json, sys; print(json.dumps({"hookSpecificOutput": {"hookEventName": "Stop", "additionalContext": sys.argv[1]}}))' "$reason" \
  || pass 'could not write the correction'
