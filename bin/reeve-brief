#!/usr/bin/env bash
# Write an errand brief. Single owner of the brief format.
#
# Usage:
#   reeve-brief <id> <holding> --office <office> [--type feat] [--base main]
#                              [--harness NAME] [--manor NAME]
#
# Writes $REEVE_HOME/errands/<id>/brief.md with two unfilled seams, {INTENT} and
# {SPEC}, then stops. The reeve fills them in. reeve-dispatch refuses to launch
# while either is still present, so a half written brief cannot reach a hand.
#
# Refuses to overwrite an existing brief: a relaunch must use the brief that is
# already there, or the hand and the record disagree about the job.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"

case ${1:-} in -h|--help) print_help "$0"; exit 0 ;; esac
id=${1:-}; holding=${2:-}
shift 2 2>/dev/null || :
office='' type='' base='' harness='' manor=''
while [ $# -gt 0 ]; do
  case $1 in
    --office)  office=${2:-}; shift 2 ;;
    --type)    type=${2:-}; shift 2 ;;
    --base)    base=${2:-}; shift 2 ;;
    --harness) harness=${2:-}; shift 2 ;;
    --manor)   manor=${2:-}; shift 2 ;;
    -h|--help) print_help "$0"; exit 0 ;;
    *) die "unknown option '$1'" ;;
  esac
done

require_id "$id"
[ -n "$holding" ] || die "no holding given. a holding is a repo: a registered name, or a path"
[ -n "$office" ]  || die "no --office given. one of: $(office_names | tr '\n' ' ')"

# The office becomes a component of the worktree path below, so assert
# membership in the real list rather than the existence of a file. A bare
# `-f offices/$office.md` test follows `..` happily: `--office ../README` finds
# offices/../README.md and the composed path then escapes <repo>.worktrees
# entirely. office_names excludes README, which is exactly the file that
# defeats an existence check.
lines_has "$office" "$(office_names)" \
  || die "no such office '$office'. offices are: $(office_names | tr '\n' ' ')"
office_file="$REEVE_ROOT_D/offices/$office.md"

home_ensure >/dev/null
brief=$(brief_file "$id")
[ -e "$brief" ] && die "brief already exists at $brief. a relaunch reuses it; delete the errand deliberately if you really mean to start over"

repo=$(resolve_holding_path "$holding") \
  || die "cannot resolve holding '$holding' to a git repository. register it with reeve-survey, or give an absolute path"

[ -n "$manor" ] || manor=$(holding_field "$holding" manor "$(basename "$repo")")
[ -n "$base" ]  || base=$(holding_field "$holding" base 'main')
instructions=$(holding_field "$holding" instructions '')
setup_cmd=$(holding_field "$holding" setup '')
test_cmd=$(holding_field "$holding" test '')

# Branch policy by office. Offices that write code get a branch; offices that
# only read get a detached worktree, so an investigation never litters the
# branch list with something nobody will ever merge.
case $office in
  artificer) writes=yes; [ -n "$type" ] || type=feat ;;
  scribe)    writes=yes; [ -n "$type" ] || type=docs ;;
  steward)   writes=home; type='' ;;
  scout|warden) writes=no; type='' ;;
  *)         writes=yes; [ -n "$type" ] || type=chore ;;
esac

branch=''
[ "$writes" = yes ] && branch="$type/$id"

# One local copy per errand, named after the office that occupies it, so a
# listing of <repo>.worktrees says who is working where. Flat: <office>-<id>,
# never <office>/<id>, because a slash would make a directory per role and the
# household's convention is a single flat folder name.
#
# The steward is the one office with no copy at all: reeve-dispatch runs it in
# the reeve's home, so it records no worktree path rather than one that is never
# created.
if [ "$writes" = home ]; then
  worktree=''
  copy=$REEVE_HOME_D
  copy_cell="none, you work in \`$copy\`"
else
  worktree="$(dirname "$repo")/$(basename "$repo").worktrees/$office-$id"
  copy=$worktree
  copy_cell="\`$worktree\`"
fi

status=$(status_file "$id")
report=$(report_file "$id")
mkdir -p "$(errand_dir "$id")"

# ---- the brief ------------------------------------------------------------
#
# Wrapper text is written for a hand to parse, not for a human to enjoy:
# fragments, lists, imperatives. Every instruction, guard, path and refusal
# condition is load bearing and stays exact; only the wording is terse.
{
cat <<HEAD
# Errand $id

You are a hand of the reeve: one errand, alone. Nobody is watching this pane, nobody will answer
you, so never wait for input.

| | |
|---|---|
| errand | \`$id\` |
| office | \`$office\` |
| manor | $manor |
| holding | \`$repo\` |
| your copy | $copy_cell |
| branch | ${branch:-none, detached at \`$base\`} |
| base | \`$base\` |
| status file | \`$status\` |

## Task

### Intent: the liege's own words, verbatim

{INTENT}

Your acceptance criteria: quoted, not paraphrased, so a reviewer checks the work against what was
asked, not against your reading of it.

### Spec

{SPEC}

HEAD

cat <<'PREC'
## One conflict to settle first

Your personal or global instruction file almost certainly says: stop at each milestone, summarise,
ask a human what next. That is for a watched session. **This is not one.** A question asked in chat
reaches nobody and you would wait forever.

For this errand only, that is replaced by the Reporting section below: raise questions as a
`needs-decision` line in your status file, then keep working or stop as it says. The rest of that
file applies in full, git conduct and writing style especially.

PREC

if [ "$writes" = home ]; then
cat <<HOME_ISO
## Before you touch anything

No local copy of any repository. You work in the reeve's home at \`$copy\`, and write nowhere else.
Confirm it exists:

\`\`\`sh
ls "$copy"
\`\`\`

If it does not, stop at once, append

\`\`\`
blocked: the reeve's home is not where the brief says it is
\`\`\`

to \`$status\`, and do nothing else.
HOME_ISO
else
cat <<'ISO'
## Before you touch anything

Confirm you are in your own copy, not the household's primary checkout:

```sh
pwd -P
git rev-parse --show-toplevel
```
ISO

cat <<ISO2

Both must print \`$worktree\`. If either prints \`$repo\`, stop at once, append

\`\`\`
blocked: launched in the primary checkout, not an isolated copy
\`\`\`

to \`$status\`, and do nothing else. Editing the primary checkout would corrupt work the liege may
have in progress.

## Setup

A fresh git worktree: ignored files did not come with it, so no installed dependencies, no build
output, no \`.env\`. Not broken, just not set up yet. Install with the repository's own package
manager before concluding anything is wrong.
ISO2
fi

if [ -n "$instructions" ]; then
cat <<INSTR

Read \`$repo/$instructions\` first: this repository's own instruction file, outranking your
instincts about style, structure and tooling. Note the filename. It is not always discovered
automatically, so read it explicitly.
INSTR
else
cat <<'INSTR'

Find this repository's own instruction file (`AGENTS.md`, `AGENT.md`, `CLAUDE.md`, `README`) and
read it first. It outranks your instincts about style, structure and tooling.
INSTR
fi

if [ -n "$setup_cmd" ] || [ -n "$test_cmd" ]; then
cat <<'CMDS'

Commands this holding declares:

CMDS
[ -n "$setup_cmd" ] && printf -- '- setup: `%s`  (already run for you before launch)\n' "$setup_cmd"
[ -n "$test_cmd" ]  && printf -- '- test: `%s`  (use this to validate your own work)\n' "$test_cmd"
fi

# Headings are demoted one level so the inlined office sits under the brief's
# hierarchy instead of starting a second H1 halfway down the page.
cat <<ROLE

$(sed 's/^#/##/' "$office_file")

## Reporting

One line appended to \`$status\` at each real change of state, nothing more. Every append wakes the
reeve, so report sparingly: constant chatter gets ignored, which defeats the point.

\`\`\`
working: <what you are doing now>
needs-decision [key=<short-slug>]: <the question, answerable without reading your diff>
blocked: <what is in the way, and what would unblock it>
done: <what landed, and anything you deliberately left alone>
failed: <why, and what you tried>
\`\`\`

Rules:

- **Open with one \`working:\` line**, so the reeve knows you launched.
- **\`needs-decision\` is a real stop.** Ask, then wait, or work on something unrelated inside this
  errand. Never guess and carry on: a wrong guess costs more than a wait. Always give it a short
  \`key=\` slug, which is how the answer is matched back to the question.
- **Never write \`resolved\`.** Only the reeve closes a decision, after the liege answers.
- **One \`done:\`, at the end, only if true.** Done with a question still open is a divergence and
  will be caught.
- Append, never rewrite. A log, not a status field.
- **After \`done:\`, stop.** No tidying, no looking for more work. The reeve cleans up after you.

## Hard rules

1. Write only inside \`$copy\`. Never the primary checkout, never another errand's copy, never
   anywhere else on disk.
ROLE

if [ "$writes" = yes ]; then
cat <<COMMIT
2. Commit on \`$branch\` and nothing else. **Never push. Never open a pull request. Never touch
   \`$base\`. Never rebase or merge.** This errand authorised commits on this branch only;
   everything outward facing stays the liege's decision.
3. Commit messages are subject and body only, commitlint style subject. **No co-author trailer, no
   attribution footer, no tool advertisement.** No em dashes or en dashes anywhere.
COMMIT
elif [ "$writes" = home ]; then
cat <<'COMMIT'
2. Write only under the reeve's home. No repository, no worktree, no commits at all.
3. No em dashes or en dashes anywhere.
COMMIT
else
cat <<COMMIT
2. **Write nothing in the repository.** No edits, no commits, no branch, not even a formatting fix.
   Your one output file is \`$report\`. The copy is there so you can read and run things safely,
   not change them.
3. \`git status --porcelain\` in your copy must be empty when you finish. No em dashes or en dashes
   anywhere.
COMMIT
fi

cat <<TAIL
4. Stay inside the intent above. A second problem, a tempting refactor, a missing test outside this
   errand: name it in your \`done:\` line and leave it alone. Other hands are in this repository
   right now, and uninvited changes become someone else's merge conflict.
5. Cannot finish: say so with \`blocked:\` or \`failed:\` and stop. A truthful stop beats a hopeful
   guess.

Your done is defined in the office section above. Meet it exactly, then append your \`done:\` line.
Never call work finished that you have not verified.
TAIL
} > "$brief"

meta_write "$id" \
  "office=$office" \
  "holding=$holding" \
  "repo=$repo" \
  "manor=$manor" \
  "worktree=$worktree" \
  "branch=$branch" \
  "base=$base" \
  "writes=$writes" \
  "harness=$harness" \
  "created=$(today)"

info "brief written: $brief"
info "seams to fill: {INTENT} and {SPEC}"
info "then: reeve-dispatch $id"
