#!/usr/bin/env bash
# Report an errand's real state. Single reader of the status log.
#
# Usage:
#   reeve-status <id>            one errand, in full
#   reeve-status                 the errands this session owns
#   reeve-status --all           every errand the home knows about
#   reeve-status --orphans       errands whose owning session is provably gone
#   reeve-status <id> --raw      the reconciled key=value form, for scripts
#   reeve-status --no-wake       list without delivering anything
#
# One home is shared by every reeve on this machine, so a bare listing is this
# session's own work and --all is the machine's. An errand with no recorded
# owner shows in both, because nothing can be proved about it and hiding it
# would strand it where no reeve would ever look.
#
# The status log is append only and every append is a wake event, not the
# current state. Never read its last line and call that the state: that is what
# this script exists to prevent.
#
# A listing also delivers any wake a caretaker took over while this reeve had
# nothing watching, above the table, once only, and on STDERR: the table is this
# command's answer and a reeve filters it, while a notification is not part of
# that answer and must not be inside the stream being filtered. bin/reeve-sentry
# is what WAKES a reeve; this is what a reeve reads when it looks of its own
# accord, and a reeve that dispatched and then sat idle does the second long
# before the first.
#
# That delivery is for a reeve reading its own fleet, so anything that runs this
# to answer some OTHER question passes --no-wake. Without it a wake is consumed
# by a script that had no way to report it: bin/reeve-handoff drained the whole
# spool into a table it then filtered the signals back out of, at the one moment
# a reeve is about to be reset and that spool is about to become unreadable by
# anybody, and bin/reeve-doctor spent one while printing an errand table.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"

# This session is doing something, so it is demonstrably still here. What the
# caretaker reads to tell a reeve that is gone from one that is merely quiet.
session_touch
BIN=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

all=no raw=no orphans=no nowake=no id=''
while [ $# -gt 0 ]; do
  case $1 in
    --all) all=yes; shift ;;
    --orphans) orphans=yes; all=yes; shift ;;
    --raw) raw=yes; shift ;;
    --no-wake) nowake=yes; shift ;;
    -h|--help) print_help "$0"; exit 0 ;;
    *) id=$1; shift ;;
  esac
done

# A threshold that is not a number turns its half of the staleness check off
# rather than firing on every row, which is the safe direction and also a silent
# one, so the command a reeve reads of its own accord says so.
stale_config_warn

errand_ids() {
  local mine own; mine=$(reeve_session)
  ls "$REEVE_HOME_D/state"/*.meta 2>/dev/null | while read -r f; do
    i=$(basename "$f" .meta)
    own=$(meta_get "$i" session '')
    if [ "$orphans" = yes ]; then
      # Provably gone, never merely unaccounted for. An owner that never
      # reported is `unknown`, and listing those as orphans would invite
      # cleaning up the errands of every reeve that simply has not watched yet.
      [ -n "$own" ] && [ "$(session_state "$own")" = dead ] || continue
    elif [ "$all" != yes ]; then
      [ "$own" = "$mine" ] || [ -z "$own" ] || continue
    fi
    printf '%s\n' "$i"
  done
}

# meta_get hands back its fallback only when the key is ABSENT, and reeve-brief
# writes several keys present and empty for dispatch to fill in later. To a
# reader of a cell those two are the same thing, an unknown, so anything printed
# for a human goes through here rather than through meta_get directly.
meta_show() {
  local v; v=$(meta_get "$1" "$2" '')
  printf '%s\n' "${v:-${3:-?}}"
}

# --- the ticket -------------------------------------------------------------
# One errand is one holding, one copy, one branch, so a tracker item spanning
# three repositories is three errands and the key they share is the only record
# that they are one piece of work. It is stored in whatever case the liege
# typed, and two errands on one ticket may disagree about it, so grouping
# matches on the lowercased key while every label keeps a spelling as given.

ticket_key() {  # the group's identity: lowercased, empty when there is none
  meta_get "$1" ticket '' | tr '[:upper:]' '[:lower:]'
}

ticket_label() {  # ticket_label <key> <id>...   the header line for one group
  local key=$1 shown='' title='' i
  shift
  # First spelling and first title in id order, which is the order these arrive
  # in: a title is optional, so the row carrying the key need not carry one.
  for i in "$@"; do
    [ -n "$shown" ] || shown=$(meta_get "$i" ticket '')
    [ -n "$title" ] || title=$(meta_get "$i" ticket_title '')
  done
  if [ -n "$title" ]; then printf 'ticket %s: %s\n' "${shown:-$key}" "$title"
  else                     printf 'ticket %s\n' "${shown:-$key}"; fi
}

live_state() { # live_state <id> [long]
  local i=$1 tgt bk st attn stale
  tgt=$(meta_get "$i" target '')
  # `target=` is emptied when a session is freed, so on its own it cannot tell a
  # dispatch that ended from one that never happened: both look identical here,
  # which is how nearly every errand in the home came to read never-dispatched.
  # The dispatched stamp is what separates them, and the tornDown stamp, written
  # by reeve-teardown and read the same way in reeve-handoff, says whether the
  # copy went with the session or is still on disk.
  if [ -z "$tgt" ]; then
    if [ -z "$(meta_get "$i" dispatched '')" ]; then printf 'never-dispatched\n'
    elif [ -n "$(meta_get "$i" tornDown '')" ]; then printf 'torn-down\n'
    else printf 'session-gone\n'; fi
    return
  fi
  bk=$(meta_get "$i" backend herdr)
  st=$("$BIN/reeve-backend" call agent_state "$tgt" --backend "$bk" 2>/dev/null) || st=unreadable
  # Two facts, because they are two questions. `alive` alone once covered a hand
  # suspended at a permission dialog with nothing at all happening in it, so the
  # second word is what separates a session getting on with it from one waiting
  # for an answer nobody knows it wants. Only asked of a live session: for a dead
  # or unreadable one there is nothing to be waiting.
  if [ "$st" = alive ]; then
    attn=$("$BIN/reeve-backend" call attention_state "$tgt" --backend "$bk" 2>/dev/null) || attn=unknown
    # A third fact, and the one the other two hid for twenty two hours: settled
    # with `working:` as the last word, long past any real turn, is not a hand
    # between steps. stale_probe in bin/reeve-lib.sh owns the rule. The table
    # cell takes the place of `settled`, which stale already implies, because the
    # column is sixteen wide; the single errand form keeps both and says why.
    if stale=$(stale_probe "$i" "$(status_field "$i" state)" "${attn:-unknown}" "$tgt" "$bk" "$BIN"); then
      if [ "${2:-}" = long ]; then
        case ${stale#* } in
          error) printf '%s/%s, stale: silent %s after an API error\n' "$st" "$attn" "$(silence_say "${stale%% *}")" ;;
          *)     printf '%s/%s, stale: silent %s\n' "$st" "$attn" "$(silence_say "${stale%% *}")" ;;
        esac
      else
        printf '%s/stale %s\n' "$st" "$(silence_short "${stale%% *}")"
      fi
      return
    fi
    printf '%s/%s\n' "$st" "${attn:-unknown}"
  else
    printf '%s\n' "$st"
  fi
}

# What the errand actually spends, and who decided it. The origin is the point:
# an errand running cheap is fine when an office chose it and a mistake when a
# flag did, and the two are indistinguishable from the value alone.
#
# A harness with an empty flag template for an axis drops it silently, so this
# says dropped rather than letting the recorded value imply it applied. Derived
# here from the harness file rather than stored at dispatch: one fact, one
# record, read back through the same file that decides it.
tier_line() {
  local i=$1 h out='' axis val from note
  h=$(meta_get "$i" harness '')
  for axis in model effort; do
    val=$(meta_get "$i" "$axis" '')
    # An errand dispatched before origins were recorded has the value but not
    # its origin, and back then a value could only have come from a flag.
    if [ -n "$val" ]; then from=$(meta_get "$i" "${axis}_from" flag)
    else                  from=$(meta_get "$i" "${axis}_from" harness); fi
    note=''
    if [ -n "$val" ] && [ -n "$h" ] \
       && [ -z "$("$BIN/reeve-harness" get "$h" "${axis}_flag" '' 2>/dev/null)" ]; then
      note="dropped: $h has no ${axis}_flag"
    fi
    out="$out, $axis $(tier_say "$val" "$from" "$note")"
  done
  printf '%s\n' "${out#, }"
}

one() {
  local i=$1 rec st open div last
  rec=$(status_reconcile "$i")
  st=$(printf  '%s\n' "$rec" | grep -m1 '^state='      | sed 's/^state=//')
  open=$(printf '%s\n' "$rec" | grep -m1 '^open='       | sed 's/^open=//')
  div=$(printf  '%s\n' "$rec" | grep -m1 '^divergence=' | sed 's/^divergence=//')
  last=$(printf '%s\n' "$rec" | grep -m1 '^last='       | sed 's/^last=//')

  printf 'errand    %s\n' "$i"
  printf 'office    %s on %s via %s\n' "$(meta_show "$i" office)" "$(meta_show "$i" harness)" "$(meta_show "$i" backend)"
  printf 'tier      %s\n' "$(tier_line "$i")"
  printf 'holding   %s\n' "$(meta_show "$i" repo)"
  # No line at all when there is no ticket: an errand that belongs to nothing
  # should not say so on a line of its own. Title and url are optional labels
  # and each appears only if it is there.
  local tk tt tu
  tk=$(meta_get "$i" ticket '')
  if [ -n "$tk" ]; then
    tt=$(meta_get "$i" ticket_title '')
    tu=$(meta_get "$i" ticket_url '')
    [ -n "$tt" ] && tk="$tk ($tt)"
    [ -n "$tu" ] && tk="$tk $tu"
    printf 'ticket    %s\n' "$tk"
  fi
  local c; c=$(meta_get "$i" cwd "$(meta_get "$i" worktree '?')"); printf 'copy      %s\n' "${c:-?}"
  local br; br=$(meta_get "$i" branch '')
  printf 'branch    %s\n' "${br:-none, detached at $(meta_show "$i" base)}"
  printf 'reported  %s\n' "$st"
  printf 'process   %s\n' "$(live_state "$i" long)"
  [ -n "$last" ] && printf 'last said %s\n' "$last"

  if [ "${open:-0}" -gt 0 ]; then
    printf '\n%s open decision(s), waiting on the liege:\n' "$open"
    printf '%s\n' "$rec" | sed -n 's/^decision=//p' | while IFS="$(printf '\t')" read -r k q; do
      printf '  [%s] %s\n' "$k" "$q"
    done
    printf '\nanswer one with:  reeve-answer %s <key> "<the answer>"\n' "$i"
  fi
  if [ "$div" = yes ]; then
    printf '\nDIVERGENCE: this errand reached a terminal state with a question still open.\n'
    printf 'Do not treat it as finished. The hand either guessed or gave up.\n'
  fi

  # A branch with commits that the base does not have is unlanded work. Say so
  # plainly, because that is what makes teardown refuse later.
  if [ -n "$br" ]; then
    local repo ahead dirty wt base
    repo=$(meta_get "$i" repo ''); wt=$(meta_get "$i" worktree '')
    # Counted against the same base that gets printed, and an empty base falls
    # back to the same default an absent one does: otherwise the range reads
    # `..branch`, which counts the branch's whole history as unlanded work.
    base=$(meta_show "$i" base main)
    if [ -n "$repo" ] && git -C "$repo" rev-parse --verify --quiet "refs/heads/$br" >/dev/null 2>&1; then
      ahead=$(git -C "$repo" rev-list --count "$base..$br" 2>/dev/null || echo '?')
      printf 'commits   %s ahead of %s, not pushed\n' "$ahead" "$base"
    fi
    if [ -n "$wt" ] && [ -d "$wt" ]; then
      dirty=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      [ "${dirty:-0}" -gt 0 ] && printf 'uncommitted %s file(s) still dirty in the copy\n' "$dirty"
    fi
  fi
}

# One row, in the only layout there is. Grouped and ungrouped rows print
# through here so a ticket can never give an errand a different shape.
table_row() {
  local i=$1 o
  o=$(status_field "$i" open); o=${o:-0}
  printf '%-24s %-11s %-16s %-16s %s\n' \
    "$i" "$(meta_show "$i" office)" "$(status_field "$i" state)" "$(live_state "$i")" \
    "$([ "$o" -gt 0 ] && printf '%s waiting' "$o" || printf '-')"
}

if [ "$all" = yes ] || [ -z "$id" ]; then
  # Reports a caretaker took over while this reeve had nothing watching, handed
  # over before the table and never after: the errand each one is about has
  # usually been cleaned up already, so the row it would appear in says nothing
  # about the fact that nobody was ever told. Each one is removed once its line
  # has actually been written and never before, which is the difference between a
  # trimmed listing costing a signal and costing nothing: `reeve-status --all |
  # head -1` used to print the first, destroy the second on the write that
  # failed, and leave the third.
  #
  # ON STDERR, which is the half of that promise the order of the two steps
  # cannot keep. A trim is a write that fails and the entry survives it, but a
  # filter is a write that SUCCEEDS into something that discards the line:
  # `reeve-status --all | grep '^kept'` consumed all three and the reeve saw
  # none, and because delivering marks the errand reported that was the whole
  # report, permanently. The table is this command's answer and a filter is the
  # reeve's business; a notification is not part of that answer and does not
  # belong in the stream being filtered. Out here it reaches the terminal whatever
  # the pipeline does with stdout. `2>&1` or `2>/dev/null` still spends it, and
  # AGENTS.md says so.
  #
  # Here as well as in bin/reeve-sentry because the sentry is what wakes a reeve
  # and this is what a reeve reads when it looks of its own accord. A reeve that
  # dispatched and then sat idle does the second long before the first.
  #
  # --orphans too, deliberately: it is the command for finding work nobody is
  # watching, which is exactly what a pending wake is.
  if [ "$nowake" != yes ]; then
    wrc=0
    while :; do wake_deliver >&2 || { wrc=$?; break; }; done
    # An unwritable spool used to be indistinguishable from an empty one, so a
    # listing showed no notifications and said nothing about why.
    [ "$wrc" = 2 ] && warn "a pending notification cannot be delivered, check $(wake_dir "$(reeve_session)")"
  fi
  ids=$(errand_ids)
  if [ -z "$ids" ]; then
    if [ "$orphans" = yes ]; then info "no orphaned errands: every owner is alive or unaccounted for"
    elif [ "$all" = yes ]; then info "no errands in $REEVE_HOME_D"
    else info "no errands of this session's in $REEVE_HOME_D. --all lists the whole home"
    fi
    exit 0
  fi
  printf '%-24s %-11s %-16s %-16s %s\n' ERRAND OFFICE REPORTED PROCESS OPEN

  # <key>TAB<id> per errand, key empty when there is no ticket, sorted once.
  # That single sort settles both orders the view needs, tickets by key
  # ascending and rows by id inside a ticket, and it puts every ungrouped row
  # first, where an empty key sorts, so the two blocks split with no second
  # pass over the metadata.
  TAB=$(printf '\t')
  index=$(printf '%s\n' "$ids" | while read -r i; do
    [ -n "$i" ] || continue
    printf '%s\t%s\n' "$(ticket_key "$i")" "$i"
  done | LC_ALL=C sort)
  grouped=$(printf '%s\n' "$index" | grep -v "^$TAB") || :
  loose=$(printf '%s\n' "$index" | grep "^$TAB" | cut -f2) || :

  first=yes
  printf '%s\n' "$grouped" | cut -f1 | uniq | while read -r key; do
    [ -n "$key" ] || continue
    # No awk here, and the key never becomes part of a program. `awk -v k=$key`
    # expands escape sequences in the assignment, so a key holding `\t` arrived
    # as a tab, matched no row, and the whole group vanished from the table with
    # no error at all. A tracker's key shape is not ours to constrain, so the
    # filter has to be one with no escape layer: the rows are already sorted, so
    # reading them back through the same tab that wrote them compares the key as
    # the bytes it is.
    gids=$(printf '%s\n' "$grouped" | while IFS="$TAB" read -r k2 i2; do
      if [ "$k2" = "$key" ]; then printf '%s\n' "$i2"; fi
    done)
    # A blank line between groups, and before the ungrouped block below, so
    # neither is read as part of the ticket above it. Before each group rather
    # than after, because after one means a blank line at the end of the whole
    # table whenever nothing follows the last group.
    [ "$first" = yes ] || printf '\n'
    first=no
    ticket_label "$key" $gids
    for i in $gids; do table_row "$i"; done
  done

  # The other half of that separator: the loop above runs in a subshell, so what
  # it knows about the last group does not reach here. Both sides being non
  # empty is the same question asked from the outside.
  [ -n "$grouped" ] && [ -n "$loose" ] && printf '\n'

  printf '%s\n' "$loose" | while read -r i; do
    [ -n "$i" ] || continue
    table_row "$i"
  done
  exit 0
fi

require_id "$id"
[ -f "$(meta_file "$id")" ] || die "no errand '$id' in $REEVE_HOME_D"
if [ "$raw" = yes ]; then status_reconcile "$id"; else one "$id"; fi
