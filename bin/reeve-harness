#!/usr/bin/env bash
# Harness dispatcher. The only thing that reads harnesses/<name>.toml.
#
# Usage:
#   reeve-harness resolve [--harness N] [--office O]
#   reeve-harness list
#   reeve-harness check <name>                 exit 0 only if installed and verified
#   reeve-harness render <name> <brief-abs-path> --settings <path> [--model M] [--effort E]
#   reeve-harness detect                       which harness reeve is itself running under
#   reeve-harness get <name> <key>             read one declared key, for inspection

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"

harness_file() { printf '%s/harnesses/%s.toml\n' "$REEVE_ROOT_D" "$1"; }
harness_known() { ls "$REEVE_ROOT_D/harnesses"/*.toml 2>/dev/null | while read -r f; do basename "$f" .toml; done; }

# --- flat TOML reader -------------------------------------------------------
# Handles exactly what harnesses/README.md promises: a flat table of scalars and
# string arrays. Written in shell on purpose so starting a hand needs neither
# python nor jq. Anything richer is a documentation error, not a parser bug.

h_get() {
  # h_get <name> <key> [fallback]   scalars unquoted, arrays one item per line
  local f raw
  f=$(harness_file "$1")
  [ -f "$f" ] || die "no harness file for '$1' at $f"
  raw=$(sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$f" | head -1)
  if [ -z "$raw" ]; then printf '%s\n' "${3:-}"; return; fi
  case $raw in
    '['*)
      raw=${raw#'['}; raw=${raw%']'}   # quoted: a bare [ is an unterminated glob bracket
      # split on commas that separate quoted items, then unquote each
      # NOTE the `|| [ -n "$item" ]`: read returns non-zero on a final line with
      # no trailing newline, so without it the LAST array item is silently lost
      # and a single-item array parses as empty.
      printf '%s\n' "$raw" | tr ',' '\n' | while IFS= read -r item || [ -n "$item" ]; do
        item=$(printf '%s' "$item" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        [ -n "$item" ] || continue
        item=${item#\"}; item=${item%\"}
        printf '%s\n' "$item" | sed 's/\\"/"/g'
      done ;;
    '"'*)
      raw=${raw#\"}; raw=${raw%\"}
      printf '%s\n' "$raw" | sed 's/\\"/"/g' ;;
    *)
      printf '%s\n' "$raw" ;;
  esac
}

# --- the pointer prompt -----------------------------------------------------
# Single owner of the launch wording. Every harness gets the identical sentence,
# which is what makes an office behave the same under codex as under claude.
# The brief itself is never placed on the command line: see harnesses/README.md.

pointer_text() {
  printf '%s' "Read the file $1 and follow it exactly. It is your complete instructions for this task. You are working unattended: no human will answer you, so never wait for input. Report progress by appending status lines exactly as the file describes."
}

shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# --- resolution -------------------------------------------------------------

harness_resolve() {
  local want=${1:-} office=${2:-}
  [ -n "$want" ] || want=${REEVE_HARNESS:-}
  [ -n "$want" ] || { [ -n "$office" ] && want=$(config_get "harness-$office" ''); }
  [ -n "$want" ] || want=$(config_get harness '')
  [ -n "$want" ] || want=claude
  lines_has "$want" "$(harness_known)" \
    || die "unknown harness '$want'. known: $(harness_known | tr '\n' ' ')"
  printf '%s\n' "$want"
}

harness_installed() { command -v "$(h_get "$1" bin "$1")" >/dev/null 2>&1; }
harness_verified()  { [ "$(h_get "$1" verified false)" = "true" ]; }

harness_check() {
  local n=$1
  harness_installed "$n" || {
    printf 'refused: harness %s is not installed (%s is not on PATH)\n' "$n" "$(h_get "$n" bin "$n")" >&2
    printf 'install it, then run: reeve-doctor\n' >&2
    return 1; }
  harness_verified "$n" || {
    printf 'refused: harness %s is installed but not verified\n' "$n" >&2
    printf 'source of its flags: %s\n' "$(h_get "$n" source 'unrecorded')" >&2
    printf 'verify it by running one scout errand through it, see harnesses/README.md\n' >&2
    printf 'to try it anyway, pass --allow-unverified\n' >&2
    return 1; }
  return 0
}

harness_render() {
  local n=$1 brief=$2 model=${3:-} effort=${4:-} settings_path=${5:-}
  [ -n "$brief" ] || die "render needs an absolute brief path"
  case $brief in /*) ;; *) die "brief path must be absolute, got '$brief'" ;; esac

  local bin launch mode pflag perm mflag eflag line prompt dirs sep settings mcp
  bin=$(h_get "$n" bin "$n")
  launch=$(h_get "$n" launch '')
  [ -n "$launch" ] || die "harness '$n' declares no launch template"
  mode=$(h_get "$n" prompt_mode argv)
  pflag=$(h_get "$n" prompt_flag '')
  perm=$(h_get "$n" perm_flag '')

  mflag=''
  if [ -n "$model" ]; then
    mflag=$(h_get "$n" model_flag '')
    [ -n "$mflag" ] && mflag=$(printf '%s' "$mflag" | sed "s|{model}|$model|g")
  fi
  eflag=''
  if [ -n "$effort" ]; then
    eflag=$(h_get "$n" effort_flag '')
    [ -n "$eflag" ] && eflag=$(printf '%s' "$eflag" | sed "s|{effort}|$effort|g")
  fi

  # Shut off every MCP tool the machine would otherwise lend the hand, whether
  # from an MCP configuration file or from a built-in integration. Unconditional,
  # like perm_flag and unlike model_flag: there is no value to substitute and no
  # errand that wants them, so a harness either declares the flags or has none.
  # A hand suspended in an MCP consent dialog cannot append `blocked:`, so this
  # is the one class of stall the status file could never surface.
  mcp=$(h_get "$n" mcp_flag '')

  # Grant tool access to the errand directory. A hand's working copy is its cwd,
  # but the brief, the status file and the report all live in the errand
  # directory, and a harness that sandboxes tool access to the cwd will stop
  # dead on the first read. Verified: claude on acceptEdits refuses a read
  # outside the working directory, so without this grant every hand hangs on a
  # permission prompt at its very first action.
  dirs=$(h_get "$n" dirs_flag '')
  [ -n "$dirs" ] && dirs=$(printf '%s' "$dirs" | sed "s|{dir}|$(dirname "$brief")|g")

  # Per-errand permissions, rendered by reeve-dispatch from the office's own
  # settings file. A harness that declares settings_flag but gets no path is a
  # dispatch bug, not something to paper over: without it the hand stalls on the
  # first tool call its office needs.
  settings=$(h_get "$n" settings_flag '')
  if [ -n "$settings" ]; then
    [ -n "$settings_path" ] || die "harness '$n' needs a settings file but none was given"
    settings=$(printf '%s' "$settings" | sed "s|{settings}|$settings_path|g")
  fi

  prompt=$(shq "$(pointer_text "$brief")")
  sep=''
  case $mode in
    argv)
      # A "--" before the positional prompt ends option parsing, which makes the
      # prompt immune to being swallowed by a preceding variadic flag such as
      # --add-dir or --allowedTools. Declared per harness because not every CLI
      # honours it.
      [ "$(h_get "$n" argv_separator false)" = true ] && sep='--' ;;
    flag)  [ -n "$pflag" ] || die "harness '$n' uses prompt_mode=flag but declares no prompt_flag"
           prompt="$pflag $prompt" ;;
    stdin) prompt='' ;;
    *)     die "harness '$n' declares unknown prompt_mode '$mode'" ;;
  esac

  [ -n "$sep" ] && prompt="$sep $prompt"

  line=$launch
  line=${line//\{bin\}/$bin}
  line=${line//\{mcp\}/$mcp}
  line=${line//\{dirs\}/$dirs}
  line=${line//\{settings\}/$settings}
  line=${line//\{perm\}/$perm}
  line=${line//\{model\}/$mflag}
  line=${line//\{effort\}/$eflag}
  line=${line//\{prompt\}/$prompt}
  # collapse the gaps left by empty placeholders
  line=$(printf '%s' "$line" | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//')

  local envs=''
  while IFS= read -r e || [ -n "$e" ]; do
    [ -n "$e" ] || continue
    envs="$envs$(printf '%s=%s ' "${e%%=*}" "$(shq "${e#*=}")")"
  done <<EOS
$(h_get "$n" env '')
EOS
  [ -n "$envs" ] && line="env $envs$line"

  if [ "$mode" = stdin ]; then
    line="printf '%s' $(shq "$(pointer_text "$brief")") | $line"
  fi
  printf '%s\n' "$line"
}

harness_detect() {
  local n v
  for n in $(harness_known); do
    while IFS= read -r v || [ -n "$v" ]; do
      [ -n "$v" ] || continue
      if eval "[ -n \"\${$v:-}\" ]"; then printf '%s\n' "$n"; return 0; fi
    done <<EOS
$(h_get "$n" detect_env '')
EOS
  done
  printf 'unknown\n'
}

# --- cli --------------------------------------------------------------------
cmd=${1:-}; shift 2>/dev/null || :
sel='' office='' model='' effort='' settings_path=''
args=()
while [ $# -gt 0 ]; do
  case $1 in
    --harness) sel=${2:-}; shift 2 ;;
    --office)  office=${2:-}; shift 2 ;;
    --model)   model=${2:-}; shift 2 ;;
    --effort)  effort=${2:-}; shift 2 ;;
    --settings) settings_path=${2:-}; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- ${args+"${args[@]}"}

case $cmd in
  resolve) harness_resolve "$sel" "$office" ;;
  get)     n=${1:-}; k=${2:-}
           [ -n "$n" ] && [ -n "$k" ] || die "get needs <harness> <key>"
           h_get "$n" "$k" "${3:-}" ;;
  detect)  harness_detect ;;
  check)   n=${1:-$(harness_resolve "$sel" "$office")}; harness_check "$n" ;;
  render)
    n=${1:-}; [ -n "$n" ] || die "render needs a harness name"
    harness_render "$n" "${2:-}" "$model" "$effort" "$settings_path" ;;
  list)
    printf '%-10s %-10s %-9s %s\n' HARNESS INSTALLED VERIFIED BIN
    for n in $(harness_known); do
      i=no; v=no
      harness_installed "$n" && i=yes
      harness_verified  "$n" && v=yes
      printf '%-10s %-10s %-9s %s\n' "$n" "$i" "$v" "$(h_get "$n" bin "$n")"
    done ;;
  ''|-h|--help) print_help "$0" ;;
  *) die "unknown command '$cmd'. try: resolve, list, check, render, detect" ;;
esac
