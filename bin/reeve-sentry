#!/usr/bin/env bash
# Stand watch over the fleet. Wakes the reeve once per actionable change.
#
# Usage:
#   reeve-sentry [--poll SECONDS] [--timeout SECONDS] [--once] [--no-reap] [--all]
#   reeve-sentry --caretaker [--poll SECONDS]
#
# When an errand finishes it is cleaned up automatically: the session is freed
# always, and the copy is removed only when nothing would be lost. --no-reap
# makes THIS watch free nothing, and a caretaker then frees the hand within one
# poll of the watch ending. To keep a finished hand running for good, which you
# want only while debugging one, dispatch it with REEVE_NO_CARETAKER=1: that
# records keep= on the errand, and no watch or caretaker frees it after that.
# bin/reeve-teardown <id> still does, when you are finished with it.
#
# Prints exactly ONE reason line and exits when something needs the reeve. That
# single line is the whole agent facing payload, so it has to be readable on its
# own. Benign changes are absorbed and the watch continues.
#
# --caretaker splits the cleaning off from the watching. Two jobs live in this
# file and only one of them needs a reeve: telling the reeve something is
# actionable needs a reeve by definition, cleaning up after a finished hand does
# not, because bin/reeve-teardown owns the safety rules and they are mechanical.
# So a caretaker polls and cleans and says nothing at all: it never prints a
# reason line, never exits 0 on an actionable change, and never WRITES a wake
# cursor, because those record what has been reported and it reports nothing.
#
# Silence is not the same as consuming the report, and that distinction was
# missing. Freeing a finished hand's session is the moment its terminal line
# stops being discoverable anywhere but its own status file, so before doing it
# a caretaker leaves that line in the OWNING session's wake spool, which this
# script and bin/reeve-status deliver the next time that reeve runs either. Not
# a reason line and not a report: a note left for the one process that is
# allowed to make one. It reads that errand's cursor to decide whether the note
# is still owed, and where it cannot leave one at all it frees the session and
# stops there, keeping the copy and the errand's place in flight, because a hand
# torn down unreported is the whole defect this exists to close.
#
# bin/reeve-dispatch starts one, which is what makes a finished hand get cleaned
# up even when no reeve is watching. One per home, enforced by a lock; a second
# start is a quiet no-op. It exits when nothing is left to tend, so nothing
# lingers.
#
# A caretaker is a STANDBY, not a peer, towards a watch that is running. While
# an errand's owner is watching, it leaves that errand alone, because cleaning
# up an errand the watch has not yet reported races the watch for it. So each
# foreground watch publishes state/.sentry.watch-<session> while it watches and
# the caretaker stands by for that session's errands for as long as the marker
# is live: still polling, reaping none of them, ready to resume the instant the
# marker goes. Standby rather than exit, because the session holding it is
# routinely killed outright, which is the case that put the caretaker here in
# the first place. An owner that is alive and not watching gets no standby at
# all: its line goes to its spool and the hand is cleaned up, see reap_allowed.
# An errand that names no owner keeps the older blanket rule, any live marker
# at all, since there is no owner's marker to read.
#
# Exit codes:
#   0  something actionable, reason printed on stdout (or: a caretaker already
#      holds this home, so this one did nothing, or stopped doing it)
#   3  nothing in flight, there is nothing to watch
#   4  timed out with nothing actionable
#
# This is the thin sentry. It polls. Polling is the contract and a backend's
# native event wait is only ever a latency optimisation on top, because a herdr
# event subscription can be acknowledged and then silently stop delivering
# (upstream #3124) and a herdr server can force-restart and take every pane with
# it (#3527). Durable files on disk are the source of truth; panes are not.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"
BIN=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

poll=15 timeout=0 once=no reap=yes caretaker=no every=no
while [ $# -gt 0 ]; do
  case $1 in
    --poll)      poll=${2:-15}; shift 2 ;;
    --timeout)   timeout=${2:-0}; shift 2 ;;
    --once)      once=yes; shift ;;
    --no-reap)   reap=no; shift ;;
    --caretaker) caretaker=yes; shift ;;
    --all)       every=yes; shift ;;
    -h|--help)   print_help "$0"; exit 0 ;;
    *) die "unknown option '$1'" ;;
  esac
done

# --all widens what a foreground watch can SEE, and must never widen what it
# touches. AGENTS.md tells the reeve to reach for it only to understand the
# machine, and this household enforces rather than asks: reaping is off whenever
# a watch is looking at errands that are not its own.
[ "$every" = yes ] && [ "$caretaker" != yes ] && reap=no

# A caretaker cleans for the whole home rather than for one session, because it
# exists for errands whose reeve is not watching, gone or merely between
# watches. Ownership still decides what it may touch, in reap_allowed; this only
# lets it SEE the errands it is there to find.
[ "$caretaker" = yes ] && every=yes

# Everything this process prints is the one reason line the reeve reads, so the
# mode that reports nothing has to say nothing: in caretaker mode every line
# below is a no-op rather than something written to a log nobody opens.
say() { [ "$caretaker" = yes ] && return 0; printf "$@"; }

# A bad staleness threshold turns its half of that check off, and the sentry is
# the only thing that would have woken the reeve for it, so the sentry says so
# itself rather than leaving it to a listing the reeve may never run. On stderr,
# so the one reason line on stdout stays one line.
[ "$caretaker" = yes ] || stale_config_warn

# --- markers: who holds this home -------------------------------------------
# Two files in state/, one shape, one line: `<pid> <epoch seconds> <poll>`.
#
#   .sentry.lock   a caretaker saying it is the cleaner for this home
#   .sentry.watch  a foreground watch saying the reeve is watching this home
#
# Both are written and judged by marker_stamp / marker_read / marker_alive in
# bin/reeve-lib.sh, where the staleness rule and the reasoning behind it live.
# They moved there when bin/reeve-dispatch became a second reader: a dispatch
# has to know whether anything at all will report the hand it just sent out, and
# two copies of that rule would drift. Nothing about the rule changed with the
# move. For the lock, believing a stale marker means no caretaker ever starts
# for this home again, silently, because a refused start is exit 0. For the
# watch it would mean cleanup disabled permanently, which is worse than the race
# the watch exists to close. The cost of being wrong is bounded either way, a
# lock reclaimed early or a report lost the way it was lost before any of this.

# --- one caretaker per home -------------------------------------------------
# bin/reeve-dispatch starts one on every dispatch, so a household with four
# hands out would otherwise end up with four cleaners racing each other over the
# same errand. A second start is a no-op and exits 0: not being needed is not a
# failure.
#
# `ln` is the atomic primitive, deliberately, not flock: macOS ships no
# util-linux flock and this household runs on macOS. It is a hard link rather
# than a mkdir because the lock has contents: mkdir is atomic but a directory
# filled afterwards exists empty for an instant, and a second caretaker arriving
# in that instant reads no pid, calls the lock stale and takes it. Writing the
# contents first and linking them into place has no such instant. The link fails
# if the name is taken, which is the whole of the mutual exclusion.
#
# Not lock_acquire from reeve-lib.sh, which is a different contract for a
# different job: it waits for the lock and then dies, and it deliberately never
# breaks a stale one. Both are right for a command a human is watching. A
# caretaker wants neither, because nobody is watching it.
LOCK_F=$(lock_marker)

# What is guaranteed, exactly, since a comment that overstates a guarantee stops
# the next reader looking.
#
# Two caretakers can never both take a FREE home: the link fails for the second,
# and the contents are already inside the file the instant it appears, so there
# is no moment where a lock exists with nothing readable in it to judge.
#
# Two caretakers CAN both reclaim the same STALE lock, and that is the honest
# price of this shape. Judging a lock dead and replacing it is a read and a
# write, and nothing in POSIX makes that pair atomic. It is one rename rather
# than a move aside and a re-create, deliberately: a rename leaves no instant in
# which the home has no lock at all, and a home briefly uncovered is worse than
# a home briefly covered twice, because the second corrects itself on the next
# poll and the first does not. That correction is lock_hold below, and it is
# what bounds the duplicate to one poll interval. A duplicate that short costs
# duplicate teardown work on one errand, which bin/reeve-teardown is already
# safe against, and nothing else.
lock_take() {
  mkdir -p "$REEVE_HOME_D/state" 2>/dev/null || return 1
  local mine="$LOCK_F.new.$$" held
  # Redirections in this order, as everywhere the household writes silently: they
  # apply left to right, so `> "$mine" 2>/dev/null` lets the shell report its own
  # failure to create the file before the thing meant to hide it is in effect,
  # and a caretaker's stderr is state/sentry.log.
  printf '%s %s %s\n' "$$" "$(date +%s)" "$poll" 2>/dev/null > "$mine" || return 1
  if ln "$mine" "$LOCK_F" 2>/dev/null; then rm -f "$mine"; return 0; fi
  held=$(marker_read "$LOCK_F")
  if marker_alive "$held"; then rm -f "$mine"; return 1; fi
  mv "$mine" "$LOCK_F" 2>/dev/null || { rm -f "$mine"; return 1; }
  return 0
}

# Still ours, and said so again. Both answers matter: a caretaker whose lock was
# taken while somebody live holds it stands down rather than becoming the second
# one, and a caretaker whose lock went stale or vanished under it takes the home
# back rather than leaving it with no cleaner. Whichever way a reclaim race went,
# one poll later exactly one of the pair is still running.
lock_hold() {
  marker_mine "$LOCK_F" && { marker_stamp "$LOCK_F" "$poll" || :; return 0; }
  lock_take
}

# Only ever remove a lock this process still holds. It may have been reclaimed
# while this one was dying, and removing the reclaimer's lock would let a third
# caretaker in.
lock_drop() {
  marker_mine "$LOCK_F" && rm -f "$LOCK_F"
  rm -f "$LOCK_F.new.$$"
  return 0
}

# --- the watch marker -------------------------------------------------------
# Published by the foreground watch, read by a caretaker, and nothing else reads
# it. Refreshed every poll, removed on the way out, and never trusted past the
# staleness rule above, because the session running the watch is routinely
# killed outright and a marker that outlived its process must never be able to
# disable cleanup for this home.
# One marker per watching session, never one per home. Two reeves watch at once
# on this machine, and a single filename has them overwrite each other: the
# second publish makes marker_mine false for the first, so that watch stops
# refreshing a marker it no longer owns, the marker goes stale, and a caretaker
# starts reaping out from under a watch that is still running. That is the exact
# failure this marker exists to prevent, reintroduced by sharing the name.
MY_SESSION=$(reeve_session)
# `anon-$$` and not plain `anon`: two watches on a harness that exports no
# session id would otherwise share one filename, the second publish would make
# marker_mine false for the first, and the first would stop refreshing a marker
# it no longer owns. That is precisely the clobbering described above, so a
# process that cannot name its session falls back to naming itself.
WATCH_F=$(watch_marker "${MY_SESSION:-anon-$$}")
watch_publish() { mkdir -p "$REEVE_HOME_D/state" 2>/dev/null && marker_stamp "$WATCH_F" "$poll"; }

# Is ANY session watching this home: watch_live, in bin/reeve-lib.sh. Used for
# one question only: an errand with no recorded owner cannot be judged by its
# owner's own marker, so the blanket answer is the only safe one for those. Owned
# errands are judged per owner in reap_allowed, which is strictly better than a
# blanket standby.
watch_drop() {
  marker_mine "$WATCH_F" && rm -f "$WATCH_F"
  rm -f "$WATCH_F.new.$$"
  return 0
}

# A watch outlives /clear: Claude Code keeps a background command running and
# brings its notification to the session that follows, measured on 2.1.285. Its
# environment still names the session that started it, so on its own it would
# go on watching errands that session no longer owns once the next one adopts
# them, and say `nothing in flight` to a reeve whose errands are all out. So it
# follows the successor record bin/reeve-session-start writes: from the next
# poll on it watches, delivers and publishes its marker as the session that
# carries on. Rc 0 when it moved.
follow_successor() {
  local cur
  [ "$caretaker" != yes ] && [ -n "$MY_SESSION" ] || return 1
  cur=$(session_follow "$MY_SESSION")
  [ -n "$cur" ] && [ "$cur" != "$MY_SESSION" ] || return 1
  watch_drop
  MY_SESSION=$cur
  REEVE_SESSION=$cur; export REEVE_SESSION
  WATCH_F=$(watch_marker "$cur")
  return 0
}

if [ "$caretaker" = yes ]; then
  lock_take || exit 0
  # EXIT and TERM only. A caretaker is started detached from a non-interactive
  # shell, so INT and HUP reach it already ignored and bash cannot trap a signal
  # that was ignored on entry: a trap for either would read as a guard and never
  # once fire. TERM and EXIT do fire, and -9 leaves a lock the staleness rule
  # reclaims.
  trap 'lock_drop' EXIT
  trap 'lock_drop; exit 143' TERM
else
  # The foreground watch is a command the reeve ran, so all four of these are
  # genuinely deliverable here, and the exit codes are the ones the default
  # action would have given: the marker goes, nothing else changes.
  watch_publish || :
  trap 'watch_drop' EXIT
  trap 'watch_drop; exit 130' INT
  trap 'watch_drop; exit 143' TERM
  trap 'watch_drop; exit 129' HUP
fi

# cursor_file is in bin/reeve-lib.sh, beside delivered_file, which records the
# other way this errand's log gets reported. This process is the cursor's only
# writer, and wake_reported is that file's only writer.
# Alongside the cursor, and for the same reason: what this errand looked like
# last time, so a condition that is only interesting once is only reported once.
attn_file() { printf '%s/state/.attn-%s\n' "$REEVE_HOME_D" "$1"; }
# The idle latch, stale_file, lives in bin/reeve-lib.sh with stale_write, as does
# the wedged latch, the same machinery under a kind of its own, and so
# do attn_dwell and attn_now: the listing reads the latch this process writes and
# applies the same dwell to it, so neither can be this file's alone.

# Errands whose idle latch this process could not write, one id per line, so a
# read only home is said once per watch rather than every poll.
unlatched=''
latch_warn() { # latch_warn <id> <message>
  lines_has "$1" "$unlatched" && return 0
  unlatched="$unlatched$1
"
  warn "$2"
}

# Errands this process has already said it cannot judge for staleness, one id
# per line, so a long watch says it once rather than every poll.
unseen=''
# The same, for a working hand whose screen could not be read, so it cannot be
# judged wedged.
blind=''

# Clean up a hand that has finished. An agent does not exit itself, so without
# this every completed errand leaves a session idling at a prompt, holding a
# pane, until a human closes it. That is exactly the babysitting this household
# exists to remove.
#
# reeve-teardown owns the safety rules and is the single owner of them: it
# always frees the session first, then removes the copy only when nothing would
# be lost. So a scout is cleaned up completely, while an artificer keeps its
# branch and copy and only loses its idle session. Output is suppressed because
# the sentry's contract is exactly one line.
# Set by reap_one: whether the teardown reached a decision at all. A refusal is
# a decision and is final until the liege acts, so the errand is done with here.
# Failing to take the lock is not a decision, and treating it as one strands the
# errand: tended drops it from what is left to do, the caretaker then finds
# nothing in flight and exits, and nothing ever cleans it up again.
REAP_UNDECIDED=no
reap_one() {
  local i=$1 wt rc err sess=freed why verb tgt left=''
  REAP_UNDECIDED=no
  if kept "$i"; then say ' [session kept, %s]\n' "$(meta_get "$i" keep '')"; return; fi
  [ "$reap" = yes ] || { say '\n'; return; }
  wt=$(meta_get "$i" worktree '')
  # Its stdout is dropped, its stderr kept: a refusal's reason is the one thing
  # from it the wake line repeats.
  err=$("$BIN/reeve-teardown" "$i" ${2:+"$2"} 2>&1 >/dev/null); rc=$?
  [ "$rc" = 4 ] && REAP_UNDECIDED=yes
  # Freed is read off the record, never assumed: teardown blanks target= once it
  # has closed the session, and a refusal before that point leaves it standing.
  # A target left standing is kept only while there is a session at it:
  # teardown leaves target= on one already closed, which is gone, not kept.
  tgt=$(meta_get "$i" target '')
  if [ -n "$tgt" ]; then
    case $("$BIN/reeve-backend" call agent_state "$tgt" --backend "$(meta_get "$i" backend '')" 2>/dev/null) in
      missing|dead) sess=gone ;;
      *)            sess=kept ;;
    esac
  fi
  # Anything but 0 is said, with its reason: a refusal prints it on the line
  # after `REFUSED`; anything else that failed is named by its own last line,
  # or by its exit status. 4 is the lock not taken, which decided nothing:
  # deferred, not refused. 3 is the one refusal not said: a branch that has not
  # landed yet is the ordinary keep, and the commit count below already says it.
  if [ "$rc" != 0 ] && [ "$rc" != 3 ]; then
    why=$(printf '%s\n' "$err" | sed -n '/REFUSED/{n;s/^ *//p;q;}')
    [ -n "$why" ] || why=$(printf '%s\n' "$err" | sed '/^ *$/d' | tail -1)
    [ -n "$why" ] || why="exit $rc"
    if [ "$rc" = 4 ]; then verb=deferred; else verb=refused; fi
    left=", cleanup $verb: $why"
  fi
  # A 3 is a branch kept whether or not its copy is still on disk.
  if { [ -n "$wt" ] && [ -d "$wt" ]; } || [ "$rc" = 3 ]; then
    local br ahead
    br=$(meta_get "$i" branch '')
    if [ -n "$br" ]; then
      ahead=$(git -C "$(meta_get "$i" repo '')" rev-list --count "$(meta_get "$i" base main)..$br" 2>/dev/null || echo '?')
      say ' [session %s, %s kept with %s commit(s)%s]\n' "$sess" "$br" "$ahead" "$left"
    else
      say ' [session %s, copy kept%s]\n' "$sess" "$left"
    fi
  elif [ "$rc" = 0 ]; then
    say ' [session freed, copy removed]\n'
  else
    say ' [session %s%s]\n' "$sess" "$left"
  fi
}

# Kept: dispatched with REEVE_NO_CARETAKER=1, which records keep= on the errand
# itself. Per errand and on disk, never a property of whichever process happens
# to run: the opt-out promises a finished hand stays up for debugging, and a
# switch read only by the caretaker its own dispatch did not start stopped
# working the moment any other dispatch's caretaker held the home. No watch and
# no caretaker frees a kept hand; bin/reeve-teardown <id> still does, by hand.
kept() { [ -n "$(meta_get "$1" keep '')" ]; }

# The one rule for whether a finished hand may be cleaned up, so the watch and
# the caretaker can never disagree about it. Both halves are load bearing: a
# `blocked:` hand is not finished and can still be steered, and a hand that
# reported done with a question never answered is not finished whatever it says,
# so neither is ever reaped. Reached with the reconciled verdict, never with the
# last line of a status file.
# May THIS process clean this errand up. Separate from reapable(), which asks
# whether the hand is FINISHED: this asks whether it is ours to touch.
#
# A foreground watch only ever sees errands it owns, so the answer is yes.
#
# A caretaker sees the whole home, because it exists for errands whose reeve is
# not watching, and there it must not act against an owner that is. Tearing an
# errand down under its owner's watch races that watch for the report: the watch
# is about to say `is done` and clean up itself, and two cleaners on one errand
# is one too many.
#
# WATCHING, not alive, and the difference is the whole of the rule. It used to
# yield to an owner whose session was alive, and a reeve's session is alive for
# its whole working day while its watch is a one shot that prints one line and
# exits. So a finished hand sat idle at its prompt for however long that reeve
# took between one watch and the next: measured at four minutes and at fourteen,
# in one home on one day, with a caretaker holding the lock throughout and
# deliberately standing aside. An owner that is not watching loses nothing to a
# cleanup, because the line is left in its spool first, which is what its next
# watch or listing delivers.
#
# Proved by the owner's own marker, watch_live_for in bin/reeve-lib.sh, under
# the staleness rule every marker answers to: published by its watch, refreshed
# every poll, removed on the way out. Another session's marker is no evidence
# either way, because that watch neither sees nor reaps this errand.
reap_allowed() { # reap_allowed <id>
  local own
  [ "$caretaker" = yes ] || return 0
  own=$(meta_get "$1" session '')
  # No recorded owner: nothing can be proved either way, so fall back to the
  # blanket rule, which is whether anybody at all is watching this home.
  [ -n "$own" ] || { [ "$standby" = no ]; return; }
  ! watch_live_for "$own"
}

reapable() { # reapable <state> <divergence>
  case $1 in
    failed) return 0 ;;
    done)   [ "${2:-no}" = yes ] || return 0 ;;
  esac
  return 1
}

# Errands this watch is responsible for. Ownership, not the whole home: the
# home is shared by every reeve on this machine, and a sentry that lists them
# all reports another reeve's errand as its own and then reaps it. A scout is
# the case that cannot survive that, because it commits nothing, so the
# landed-work guard in reeve-teardown has nothing to refuse over and the copy
# goes for good.
#
# An errand briefed before ownership existed, or by a harness that exports no
# session id, carries an empty session=. That matches a watch that cannot name
# itself either, which is what keeps a single-harness machine working exactly
# as it did. It is honest degradation, not isolation: with no ids there is
# nothing to tell two reeves apart, and --all is the way to see everything.
#
# In flight means SENT OUT and not yet torn down, which is two questions and
# neither of them is "where is it running right now". `target=` answers only the
# second: reeve-teardown blanks it the moment it frees a finished hand's
# session, and leaves tornDown= unset when the landed-work guard then refuses
# over an unmerged branch. Read as the in-flight test, that blanking dropped the
# errand out of every watch, before and after, while its `done:` line had
# reached nobody at all. That is how the report went missing rather than late:
# no watch started afterwards could see the errand to report it, and no cursor
# for it was ever written. `dispatched=` is the durable record that it went out
# and nothing ever clears it; an errand briefed before that stamp existed still
# carries a target, so either one proves it.
live_errands() {
  local mine own; mine=$(reeve_session)
  ls "$REEVE_HOME_D/state"/*.meta 2>/dev/null | while read -r f; do
    i=$(basename "$f" .meta)
    [ -n "$(meta_get "$i" target '')" ] || [ -n "$(meta_get "$i" dispatched '')" ] || continue
    [ -z "$(meta_get "$i" tornDown '')" ] || continue
    if [ "$every" != yes ]; then
      own=$(meta_get "$i" session '')
      [ "$own" = "$mine" ] || [ -z "$own" ] || continue
    fi
    [ "$caretaker" = yes ] || ! reported_done "$i" || continue
    printf '%s\n' "$i"
  done
}

# A terminal errand whose whole log has already been reported is no longer work
# in flight for a WATCH, whatever is still on disk: an artificer keeps its copy
# and branch until the liege lands them, and that wait is the liege's, not
# something to keep polling over.
#
# Two records answer that, and they are two different facts:
#
#   its cursor covers the log      a watch read it and said so, here in check_one
#   its delivered file covers it   the caretaker's line about it was handed to
#                                  this session's spool and taken from there
#
# Either alone is enough, and a delivery writes only the second. The first is a
# READ position and a delivery reads no log: written from there it marked every
# earlier line reported too, and it silenced the errand for good on a `printf`
# whose far end may have been a `grep` that threw the line away.
#
# A caretaker still makes no reports, and WRITES neither record. It reads them,
# for the single question below: whether a report is still owed. It did not, and
# so it re-announced an errand the reeve had reported long ago, once per
# caretaker process, for as long as the branch went unlanded.
#
# This is the lifetime that keying in-flight off `target=` used to give a watch
# by accident, restored deliberately: it ends the watch once it has said its
# piece, instead of ending it the moment a cleanup blanked a field.
reported_done() { # reported_done <id>
  local i=$1 total seen
  case $(status_field "$i" state) in done|failed) ;; *) return 1 ;; esac
  total=$(status_lines "$(status_file "$i")")
  seen=$(cat "$(cursor_file "$i")" 2>/dev/null | tr -d '[:space:]')
  case $seen in ''|*[!0-9]*) ;; *) [ "$seen" = "$total" ] && return 0 ;; esac
  # delivered_get is the one reader of that file, and it answers absent,
  # unreadable and malformed the same way: nothing reported here.
  seen=$(delivered_get "$i") || return 1
  [ "$seen" = "$total" ]
}

# Does this errand still owe its owner a wake. Two ways it does not, and they
# are two different facts:
#
#   a wake was already left for it   `woke=` in its record, written by whichever
#                                    caretaker left it, durable and home wide
#   the owner already reported it    its cursor covers the whole log, so the
#                                    reeve has said this out loud already
#
# Either one alone is enough, and without them a false wake is the result. Both
# were measured: three successive caretakers left three identical lines about
# one errand the watch had already reported, and every dispatch starts a
# caretaker. A false alarm is worse than no guard at all, which is what the
# errand that built this channel was told in the first place.
wake_owed() { # wake_owed <id>
  [ -z "$(meta_get "$1" woke '')" ] || return 1
  ! reported_done "$1"
}

# Absorb or escalate. One errand, one verdict.
check_one() {
  local i=$1 f seen now again st open div bk tgt live
  local attn af since woke nowsec last stale how mark latch wedge prc w why

  # Counted BEFORE the verdict is read, and again after. The cursor is what says
  # a line has been dealt with, so advancing it past a line the verdict did not
  # include loses that line for good: reconciling this errand takes long enough
  # to read its log three times, and a `done:` appended inside that gap was
  # counted as seen while the verdict still said `working`, so the case below
  # fell through, the cursor moved, and no later poll ever looked at it again.
  # The log only ever grows, so two equal counts around the read prove nothing
  # landed inside it. Two different ones mean look again next poll: one poll of
  # latency, against a wake lost permanently.
  f=$(status_file "$i")
  now=$(status_lines "$f")

  st=$(status_field "$i" state)
  open=$(status_field "$i" open); open=${open:-0}
  div=$(status_field "$i" divergence)

  # A caretaker asks two questions and no others: is this hand finished and safe
  # to clean up, and is the reeve watching this home right now, in which case the
  # answer is nothing this tick whatever the first one said. The CLEANUP is never
  # read off a cursor: a caretaker started after the `done:` line was written
  # would then never clean it up. Whether a wake is still owed is a third
  # question, asked separately in wake_owed, and the cursor is evidence for that
  # one. Not the attention probe either: a hand stalled at a dialog is never
  # reaped by either mode, and only the reeve can answer it. And never a
  # return 0, because an actionable event is the reeve's business, not this
  # process's.
  if [ "$caretaker" = yes ]; then
    # A kept errand is never this process's to touch, finished or not, so it is
    # tended from the first look: no line in a spool, since the errand stays in
    # flight for its owner's watch to report, and no reason to keep polling it,
    # which is what lets a caretaker end while a kept hand sits there.
    if kept "$i"; then
      tended="$tended$i
"
      return 1
    fi
    if reap_allowed "$i" && reapable "$st" "$div"; then
      if wake_owed "$i"; then
        # Hand the report over before destroying the evidence for it. Freeing
        # the hand's session and blanking its target is the moment this line
        # stops being discoverable by anything: the pane is gone and, until the
        # in-flight rule above was corrected, so was the errand. A caretaker has
        # no watching reeve to tell, but it knows which one briefed this
        # errand, and a line left in that session's spool is delivered by the
        # next bin/reeve-sentry or bin/reeve-status that reeve runs. Silent as
        # ever on stdout: leaving a note is not printing a reason line.
        #
        # Only on the reap path. That is the one place the report is destroyed
        # rather than delayed; an errand this caretaker may not touch keeps its
        # session, its status file and its place in the watch, and its owner's
        # own watch will report it with a cursor to de-duplicate against.
        #
        # A wake it could not leave stops the REMOVAL. An errand whose record
        # names no session, which is every errand of a harness that exports no
        # session id, has nowhere for the line to go, and the old code ignored
        # the refusal and tore the hand down regardless: the report then existed
        # in its status file and nowhere any watch would look, which is the
        # reviewed bug intact for those homes.
        #
        # So it takes the half of the cleanup that costs nothing and leaves the
        # half that destroys the report. Freeing an idle session loses nothing
        # while `dispatched=` is there to hold the errand in live_errands
        # without the target: every watch on this home still finds it, and the
        # first reeve that actually watches reports it and then tears it down
        # properly. Deliberately NOT the blanket refusal the review asked for,
        # which would have left an idle pane per hand on every home that has no
        # session ids at all, a supported configuration.
        #
        # Without that stamp, on an errand briefed before it existed, blanking
        # the target IS what drops it out of every watch, so then nothing is
        # touched at all. The rule underneath both is one rule: never make an
        # unreported errand harder to find.
        if wake_leave "$(meta_get "$i" session '')" \
             "$(printf 'signal: %s is %s and its session was cleaned up with no reeve watching - %s' \
                  "$i" "$st" "$(status_field "$i" last)")" \
             "$i" "$now"; then
          # Once per errand, for the whole home and not for this process. The
          # only thing that used to stop a second caretaker re-announcing a
          # finished errand was tornDown=, which the landed-work guard never
          # writes over an unlanded branch, so every later dispatch started a
          # caretaker that left the same line again, its text false by then.
          meta_set "$i" woke "$(date +%Y-%m-%dT%H:%M:%S)"
        else
          [ -n "$(meta_get "$i" dispatched '')" ] && reap_one "$i" --dismiss-only
          tended="$tended$i
"
          return 1
        fi
      fi
      reap_one "$i"
      # Tended once. A teardown that refused has said all it is going to say,
      # and retrying it every poll would hammer git over a decision that is now
      # the reeve's. This is also what lets the process end: an errand nothing
      # can do anything more about stops counting as work in flight.
      #
      # Unless it never got as far as deciding. A lock it could not take means
      # somebody else is mid-teardown, or a previous one was killed holding it,
      # and both are worth another look next poll.
      [ "$REAP_UNDECIDED" = yes ] || tended="$tended$i
"
    fi
    return 1
  fi

  again=$(status_lines "$f")
  [ "$now" = "$again" ] || return 1

  seen=$(cat "$(cursor_file "$i")" 2>/dev/null || echo 0)
  seen=$(printf '%s' "$seen" | tr -d '[:space:]'); seen=${seen:-0}

  if [ "$now" -gt "$seen" ]; then
    printf '%s\n' "$now" > "$(cursor_file "$i")"
    # The reconciled note, never the raw line: no state word, no stamp, the
    # same form the caretaker leaves. Read only when there is news to tell.
    last=$(status_field "$i" last)
    # A `working:` line is progress, not news. Absorb it and keep watching:
    # waking the reeve for progress is how a supervisor becomes noise.
    case $st in
      needs-decision) printf 'signal: %s needs a decision (%s open) - %s\n' "$i" "$open" "$last"; return 0 ;;
      blocked)
        # Blocked is not finished: leave the session alone so it can be steered.
        printf 'signal: %s is blocked - %s\n' "$i" "$last"
        return 0 ;;
      failed)
        printf 'signal: %s failed - %s' "$i" "$last"
        reap_one "$i"
        return 0 ;;
      done)
        if reapable "$st" "$div"; then
          printf 'signal: %s is done - %s' "$i" "$last"
          reap_one "$i"
        else
          # Never reap a divergence. The errand is not finished whatever it says,
          # and its session may still be the only place to find out why.
          printf 'signal: %s reported done with %s question(s) never answered, treat as unfinished\n' "$i" "$open"
        fi
        return 0 ;;
    esac
  fi

  tgt=$(meta_get "$i" target ''); bk=$(meta_get "$i" backend herdr)

  # A hand suspended at a permission dialog cannot tell anyone: it is stopped
  # inside a tool call, so no line ever reaches its status file, the session
  # looks healthy from outside, and the household reads that silence as
  # progress. It happened, and it cost the liege ten minutes of answering
  # dialogs by hand before a screenshot showed why.
  #
  # So police the invariant rather than detect a dialog: an errand whose
  # reported state is `working` must have a session that is working. That holds
  # for a dialog nobody has seen yet as well as for the two known kinds, which
  # is the whole reason it is not a list of prompts to keep up to date.
  #
  # Reported state has to be exactly `working`. Every other state is either
  # already escalated or already the liege's, and re-reporting it would turn one
  # stall into a wake per poll.
  attn=''
  af=$(attn_file "$i")
  [ "$st" = working ] && attn=$("$BIN/reeve-backend" call attention_state "$tgt" --backend "$bk" 2>/dev/null || echo unknown)
  # The turn is over, so a wedge in it is too: the wedged latch, below.
  case $attn in settled|waiting) rm -f "$(stale_file "$i" wedged)" ;; esac
  if [ "$attn" = waiting ]; then
    since=''; woke=no
    [ -f "$af" ] && read -r since woke < "$af"
    nowsec=$(attn_now)
    case ${since:-} in ''|*[!0-9]*) since=$nowsec; woke=no; printf '%s %s\n' "$since" no > "$af" ;; esac
    # Two guards, and they are different guards. The dwell is against a reading
    # taken in the instant between two tool calls. The latch is against saying
    # the same thing every poll for as long as the dialog stands: one stall is
    # one wake. Both live in this one file, and any value other than `waiting`
    # deletes it, so a hand that gets answered and stalls again is reported
    # again.
    if [ "${woke:-no}" != yes ] && [ $(( nowsec - since )) -ge "$attn_dwell" ]; then
      printf '%s yes\n' "$since" > "$af"
      last=$(status_field "$i" last)
      # Never reaped, for the reason `blocked:` is never reaped: it can still be
      # steered, and the session is the only place the question exists.
      printf 'signal: %s is waiting for an answer in its session and cannot report it, last said %s\n' \
        "$i" "${last:-nothing}"
      return 0
    fi
  else
    rm -f "$af"
  fi

  # A hand that vanished without a terminal line is the failure mode that would
  # otherwise wait forever, so it is worth a wake on its own.
  live=$("$BIN/reeve-backend" call agent_state "$tgt" --backend "$bk" 2>/dev/null || echo unreadable)
  case "$live:$st" in
    dead:done|dead:failed|missing:done|missing:failed) : ;;
    dead:*|missing:*)
      # A hand opens inside its reeve's workspace, so closing that workspace
      # takes every hand in it. Said, so each one lost that way is named with
      # its cause rather than only as vanished.
      why=''
      [ "$live" = missing ] && "$BIN/reeve-backend" call group_gone "$tgt" --backend "$bk" >/dev/null 2>&1 \
        && why=", closed with its reeve's workspace"
      printf 'stale: %s left no result and its session is %s%s, last reported %s\n' "$i" "$live" "$why" "$st"
      return 0 ;;
  esac

  # The converse of the case above: a hand still there, idle at its prompt, that
  # has said nothing for longer than any turn should take. stale_silence in
  # bin/reeve-lib.sh owns which signals make that; this process owns the clock.
  # The first such reading only starts the dwell, in the latch, and a `working`
  # reading deletes the latch and so stops it, which is also what re-arms it
  # after a steer. stale_write says why at length.
  #
  # One silence, one wake. The latch's last field says whether this silence was
  # already reported. Only this process writes it, so the listing, which reads
  # it, calls a hand idle on the same second this wakes for it and not before.
  #
  # A latch that cannot be written is said on stderr, once per watch: the first
  # write failing means the dwell never starts and no idle wake will come, the
  # second means the wake will come again. A duplicate is acceptable; silence
  # about why is not.
  [ "$attn" = working ] && rm -f "$(stale_file "$i")"
  if [ "$live" = alive ] && stale=$(stale_silence "$i" "$st" "$attn" "$tgt" "$bk" "$BIN"); then
    mark=$(stale_mark "$i"); nowsec=$(attn_now)
    if latch=$(stale_latch "$i" "$mark"); then
      since=${latch% *}; woke=${latch#* }
    else
      since=$nowsec; woke=no
      # With no dwell there is no clock to start, and the write below says it.
      stale_write "$i" "$since" "$mark" no || [ "$attn_dwell" -le 0 ] \
        || latch_warn "$i" "cannot write $(stale_file "$i"), so $i's silence of $(silence_say "${stale%% *}") cannot start its dwell and no idle wake will come for it"
    fi
    if [ $(( nowsec - since )) -ge "$attn_dwell" ]; then
      [ "$woke" = yes ] && return 1
      stale_write "$i" "$since" "$mark" yes \
        || latch_warn "$i" "cannot write $(stale_file "$i"), so $i's idle wake is not recorded as reported and will be said again"
      last=$(status_field "$i" last)
      case ${stale#* } in
        error) how='idle after an API error' ;;
        *)     how='idle at its prompt' ;;
      esac
      # Reported and nothing more. Never reaped, never prodded: whether a paused
      # hand is resumed, re-sent or abandoned is the reeve's call, and the
      # session is still holding whatever context it had.
      #
      # `idle:`, not `stale:`, which the case above already uses for a session
      # that is gone. The two want different things done, so one line has to
      # say which it is.
      printf 'idle: %s has been silent for %s with its session %s, last said %s\n' \
        "$i" "$(silence_say "${stale%% *}")" "$how" "${last:-nothing}"
      return 0
    fi
  fi

  # The hand the case above cannot see, because it never reads `settled`: one
  # still `working`, frozen inside a single command. wedge_probe in
  # bin/reeve-lib.sh owns the rule and pane_print the fingerprint; this process
  # owns the clock, the wedged latch, which starts the first time a print is seen
  # over a status file and starts again whenever either changes. That is what
  # re-arms it after a hand writes a line or its screen moves, and bin/reeve-steer
  # deletes it as it does the idle latch. A `settled` or `waiting` reading is the
  # turn over, so it deletes this latch as `working` deletes the idle one, and
  # `unknown` re-arms nothing, for the same reason. That deletion sits beside the
  # attention probe above, because a `waiting` reading wakes before it gets here.
  #
  # One silence, one wake, reported and nothing more: whether a frozen command
  # is killed, waited on or steered past is the reeve's call, made by looking.
  # No dwell either, since the window is two hours of the screen holding still.
  #
  # A pane that cannot be read cannot be judged, so it never wakes, and once the
  # silence is past the window that is said on stderr, once per watch, rather
  # than left to read as quiet. A capture that fails leaves the latch as it was.
  if [ "$live" = alive ]; then
    wedge=$(wedge_probe "$i" "$st" "$attn" "$tgt" "$bk" "$BIN"); prc=$?
    if [ "$prc" = 0 ]; then
      mark=$(wedge_mark "$i" "${wedge#* }"); nowsec=$(attn_now)
      if latch=$(stale_latch "$i" "$mark" wedged); then
        since=${latch% *}; woke=${latch#* }
      else
        since=$nowsec; woke=no
        stale_write "$i" "$since" "$mark" no wedged \
          || latch_warn "wedged:$i" "cannot write $(stale_file "$i" wedged), so $i's screen cannot start its clock and no wedged wake will come for it"
      fi
      if wedge_due "${wedge%% *}" "$since"; then
        [ "$woke" = yes ] && return 1
        stale_write "$i" "$since" "$mark" yes wedged \
          || latch_warn "wedged:$i" "cannot write $(stale_file "$i" wedged), so $i's wedged wake is not recorded as reported and will be said again"
        last=$(status_field "$i" last)
        # `wedged:`, a word of its own: `idle:` is a turn that ended and this is
        # one that never does, and the two want different things looked at.
        printf 'wedged: %s has been silent for %s with its session working and its screen unchanged for %s, last said %s\n' \
          "$i" "$(silence_say "${wedge%% *}")" "$(silence_say $(( nowsec - since )))" "${last:-nothing}"
        return 0
      fi
    elif [ "$prc" = 2 ] && ! lines_has "$i" "$blind" \
         && w=$(stale_after hand-wedged 7200) && [ "$wedge" -ge "$w" ]; then
      blind="$blind$i
"
      warn "$i has been silent for $(silence_say "$wedge") while its session works, but its screen could not be read on backend $bk, so it cannot be judged wedged and no wedged wake will come for it"
    fi
  fi

  # The one case the probe is blind to, said rather than left to read as quiet:
  # a backend or harness that cannot tell idle from busy never reads `settled`
  # nor `working`, so neither the idle nor the wedged wake above can ever come
  # for this hand. Stderr, once per watch.
  if [ "$live" = alive ] && ! lines_has "$i" "$unseen" \
     && stale=$(stale_unseen "$i" "$st" "$attn"); then
    unseen="$unseen$i
"
    warn "$i has been silent for $(silence_say "$stale") but its session reads unknown on backend $bk, so it cannot be judged stale or wedged and no idle or wedged wake will come for it"
  fi
  return 1
}

# The blind sleep between polls, as a seam, for the same reason attn_now is one.
# What the guard at the bottom of the loop decides is whether to sleep at all,
# but a test that has to sit through a real sleep can only observe that decision
# as elapsed time, and elapsed time is what a loaded machine takes away: the
# timeout and this sleep are two exits from the same loop, and a pass slow enough
# to reach the deadline leaves before it ever sleeps, so the reading comes out at
# nothing and the case fails with the guard perfectly intact. Recording the sleep
# instead of taking it puts the decision itself on disk, with no clock in the
# way. Overridable only so the test suite can drive it: unset, which is every run
# outside that suite, this is exactly `sleep`.
poll_sleep() {
  [ -n "${REEVE_SENTRY_SLEEPS:-}" ] && { printf '%s\n' "$1" >> "$REEVE_SENTRY_SLEEPS"; return 0; }
  sleep "$1"
}

# Errands this caretaker has already cleaned up after, one id per line. Empty
# in every other mode.
tended=''

# Whether a foreground watch holds this home right now. Re-read every tick, and
# only ever yes in caretaker mode.
standby=no

# What is left for this caretaker to do. An errand it has already tended is no
# longer work in flight from where it stands, whatever the record still says,
# which is what gives this process a lifetime: the last job finishing ends it.
untended() { # untended <newline-separated ids>
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    lines_has "$line" "$tended" || printf '%s\n' "$line"
  done <<EOS
${1:-}
EOS
}

start=$(date +%s)
while :; do
  if [ "$caretaker" = yes ]; then
    # Say this process is still here, and find out whether it is still the one
    # holding this home. Both readings are one poll old at most, which is what
    # bounds every window either marker leaves open.
    lock_hold || exit 0
    standby=no; watch_live && standby=yes
  else
    follow_successor || :
    watch_publish || :
    # Keep this session's own heartbeat fresh. Sourcing reeve-lib.sh stamped it
    # once, but a watch runs for minutes without calling another tool, and a
    # session that goes stale while it is still watching is one whose errands a
    # caretaker would judge orphaned and reap.
    session_touch
    # A report a caretaker took over while this reeve had nothing watching. It
    # is delivered before anything else and before the nothing-in-flight exit,
    # because the errand it is about has usually been cleaned up already and so
    # is not in flight by any reading. One line per exit, like every other wake.
    #
    # wake_deliver writes that line itself rather than handing it back to be
    # printed here, which is what lets the spool entry survive a write that does
    # not land. It also marks the errand reported, so the next tick does not say
    # the same thing again off live_errands.
    #
    # On stdout, unlike the same delivery in bin/reeve-status: a watch prints one
    # line and that line is the report, so there is no listing around it for a
    # filter to keep and nothing for one to throw away.
    #
    # A spool that holds something it will not give up is the third answer, and
    # it is the reeve's business rather than this loop's: said out loud once, here,
    # instead of falling through to "nothing in flight" while the records say
    # otherwise.
    wake_deliver; wrc=$?
    [ "$wrc" = 0 ] && exit 0
    # Its own word: `stale:` is a session that is gone and `idle:` one that is
    # silent, and this is about neither, only a line this reeve has not been
    # given.
    if [ "$wrc" = 2 ]; then
      printf 'undeliverable: a pending notification cannot be delivered, check %s\n' \
        "$(wake_dir "$(reeve_session)")"
      exit 0
    fi
  fi

  ids=$(live_errands)
  [ "$caretaker" = yes ] && [ -n "$tended" ] && ids=$(untended "$ids")
  if [ -z "$ids" ]; then
    # Adopted away by a successor between the follow above and this listing.
    follow_successor && continue
    say 'nothing in flight\n'
    exit 3
  fi

  hit=no
  while IFS= read -r i || [ -n "$i" ]; do
    [ -n "$i" ] || continue
    if check_one "$i"; then hit=yes; break; fi
  done <<EOS
$ids
EOS
  [ "$hit" = yes ] && exit 0

  [ "$once" = yes ] && { say 'quiet: %s errand(s) working, nothing to report\n' "$(printf '%s\n' "$ids" | grep -c .)"; exit 4; }

  if [ "$timeout" -gt 0 ]; then
    [ $(( $(date +%s) - start )) -lt "$timeout" ] || { say 'quiet: timed out after %ss with nothing actionable\n' "$timeout"; exit 4; }
  fi

  # Prefer the backend's bounded native wait over a blind sleep, but treat its
  # answer as a hint only. Exit 2 means this backend cannot wait at all, which
  # is a perfectly good answer: fall back to sleeping.
  #
  # A wait that returns instantly is not a wait. herdr waits on `blocked` and
  # `done` and both are LATCHED, so the moment one hand sits at a prompt the
  # wait returns 0 immediately and goes on doing so; skipping the sleep on that
  # answer spun this loop at a full core for as long as the hand sat there:
  # measured over one 12 second window against a real suspended pane, 12.73s of
  # CPU for 11.86s of wall clock before this guard and 0.28s after it. So the
  # sleep is owed unless the wait actually spent time, which is what the clock
  # below asks, and the latency optimisation survives where it is real, on a
  # pane genuinely working, where the wait blocks for its whole timeout. The
  # threshold is two seconds rather than one because `date +%s` has one second
  # granularity, and an instant wait that straddles a tick reads as one. That
  # also means a wait that genuinely ran for about a second and a half reads as
  # instant and still buys a full sleep. Left as a chosen edge, not an
  # oversight: the price is a second or two of extra latency before a wake,
  # never a missed one, and closing it means sub-second arithmetic in a shell
  # or a new dependency, spent on latency nobody can perceive against a signal
  # whose own dwell is ninety seconds.
  waited=no
  t0=$(date +%s)
  while IFS= read -r i || [ -n "$i" ]; do
    [ -n "$i" ] || continue
    tgt=$(meta_get "$i" target ''); bk=$(meta_get "$i" backend herdr)
    "$BIN/reeve-backend" call wait_change "$tgt" "$((poll * 1000))" --backend "$bk" >/dev/null 2>&1
    rc=$?
    [ "$rc" -eq 2 ] || waited=yes
    break
  done <<EOS
$ids
EOS
  spent=$(( $(date +%s) - t0 ))
  if [ "$waited" = no ] || [ "$spent" -lt 2 ]; then poll_sleep "$poll"; fi
done
