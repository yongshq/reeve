#!/usr/bin/env bash
# Send an errand out. Creates the worktree, opens a session endpoint, launches
# the hand, records where it went.
#
# Usage:
#   reeve-dispatch <id> [--backend NAME] [--harness NAME] [--model M] [--effort E]
#                       [--allow-unverified] [--dry-run]
#
# --dry-run prints every command it would run and changes nothing. Use it when
# you are unsure: this is the one script in the household that mutates a repo.
#
# Run again on a hall errand whose copy already exists, it relaunches: a fresh
# hand in that copy, its commits and uncommitted work kept, only when the old
# session reads missing or dead, the copy is the errand's own on its branch, and
# the errand is this session's. Otherwise it refuses, naming why. A herdr
# errand's copy refuses as it always did.
#
# --model and --effort are optional: without them the office's own default
# applies, from the table in offices/README.md, and without that the harness
# decides. reeve-status reports which of the three it was.
#
# A successful launch also leaves a caretaker running (bin/reeve-sentry
# --caretaker, detached, one per home), so a hand that finishes is cleaned up
# even when no reeve session is alive, and the line it reported is left where
# the reeve that briefed it will find it. Set REEVE_NO_CARETAKER=1 to skip it,
# which you want while debugging a hand you do not want torn down: it also
# records keep= on the errand, so no watch and no caretaker, this home's or one
# another dispatch started, frees the finished hand. bin/reeve-teardown <id>
# frees it when you are done.
#
# A caretaker is not a watch, though. Nothing reports a finished hand to a reeve
# except bin/reeve-sentry run by that reeve, so this says NOTHING IS WATCHING,
# out loud, when neither a caretaker nor a foreground watch is there. A dispatch
# that reports a clean launch over a household with nobody watching is how a
# hand came to work for an hour, finish, and tell no one.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"
BIN=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

case ${1:-} in -h|--help) print_help "$0"; exit 0 ;; esac
id=${1:-}; shift 2>/dev/null || :
backend='' harness='' model='' effort='' allow_unverified=no dry=no
while [ $# -gt 0 ]; do
  case $1 in
    --backend) backend=${2:-}; shift 2 ;;
    --harness) harness=${2:-}; shift 2 ;;
    --model)   model=${2:-}; shift 2 ;;
    --effort)  effort=${2:-}; shift 2 ;;
    --allow-unverified) allow_unverified=yes; shift ;;
    --dry-run) dry=yes; shift ;;
    -h|--help) print_help "$0"; exit 0 ;;
    *) die "unknown option '$1'" ;;
  esac
done
require_id "$id"

run() { if [ "$dry" = yes ]; then printf '  would run: %s\n' "$*"; else "$@"; fi; }

# --- the brief must be complete -------------------------------------------
brief=$(brief_file "$id")
[ -f "$brief" ] || die "no brief for '$id'. write one first: reeve-brief $id <holding> --office <office>"
for seam in '{INTENT}' '{SPEC}'; do
  if grep -qF -- "$seam" "$brief" 2>/dev/null; then
    die "brief still has the $seam seam unfilled. a hand must never be sent a half written brief: $brief"
  fi
done

office=$(meta_get "$id" office)
holding=$(meta_get "$id" holding)
repo=$(meta_get "$id" repo)
worktree=$(meta_get "$id" worktree)
branch=$(meta_get "$id" branch)
base=$(meta_get "$id" base main)
writes=$(meta_get "$id" writes yes)
[ -n "$office" ] && [ -n "$repo" ] || die "errand '$id' has no usable metadata at $(meta_file "$id")"

# A copy that already exists relaunches only for an errand sent out on hall, the
# backend whose restart drops a hand and keeps its copy. Any other errand keeps
# the refusal it always had, word for word: herdr is left exactly as it was.
rec_backend=$(meta_get "$id" backend herdr)
hall_copy=no
[ "$rec_backend" = hall ] && [ "$writes" != home ] && [ -n "$worktree" ] && [ -e "$worktree" ] \
  && hall_copy=yes

# One dispatch of a hall errand at a time. A relaunch has no `git worktree add`
# to refuse a second one, so two at once would both read the old session lost
# and put two hands in one copy. Held from the state read below until the new
# target is recorded and launched, and refused, never waited on, when held.
# mkdir, the household's lock. One left by a run that was killed outright, its
# pid dead past config/lock-stale, is broken: a dead holder is no dispatch
# running, and the next one still reads the recorded session's state below.
# A first dispatch on hall takes it too, since it records its session before
# its launch and a relaunch could otherwise read that session mid start. Which
# backend this run will use is only read here, resolved for real below.
dispatch_lock='' launch_open=''
# dispatch_exit   the EXIT trap of a hall dispatch. A run stopped by a signal
# (TERM, INT, HUP) mid launch left its new session under `launching=`, which
# only dispatch reads: the watch called the hand lost, or saw nothing in flight,
# and teardown removed the copy under it. So that session is recorded as the
# errand's, as a launch that returned would record it, and never closed: the
# hand may be coming up, and a stale line for a pane still starting is the
# honest cost of an interrupted dispatch. SIGKILL runs no trap; teardown reads
# `launching=` for that one. Every field a returned launch records is recorded,
# `place=` above all: a relaunch from another hall session checks it, and a
# blank one let that relaunch through onto a copy a live hand may hold. The run
# starts no caretaker, so with nothing watching the home it says so, in the
# line the run would have ended on.
dispatch_exit() {
  local hand_place
  if [ -n "$launch_open" ]; then
    hand_place=$("$BIN/reeve-backend" call place --backend "$backend" 2>/dev/null | head -n 1) || hand_place=''
    if [ -n "$hand_place" ]; then meta_set "$id" place "$hand_place"
    elif [ -n "$(meta_get "$id" place '')" ]; then meta_set "$id" place ''
    fi
    meta_set "$id" target "$launch_open"; meta_set "$id" launching ''; launch_open=''
    meta_set "$id" harness "$harness"
    meta_set "$id" cwd "$cwd"
    [ -n "$model" ]  && meta_set "$id" model "$model"
    [ -n "$effort" ] && meta_set "$id" effort "$effort"
    meta_set "$id" model_from "$model_from"
    meta_set "$id" effort_from "$effort_from"
    meta_set "$id" dispatched "$(date +%Y-%m-%dT%H:%M:%S)"
    meta_set "$id" browser "$browser_say"
    if [ -n "${REEVE_NO_CARETAKER:-}" ]; then meta_set "$id" keep REEVE_NO_CARETAKER
    else meta_set "$id" keep ''; fi
    touch "$(status_file "$id")"
    [ "$relaunch" = yes ] && "$BIN/reeve-say" "$(status_file "$id")" working "$relaunch_note"
    caretaker_live || watch_live \
      || warn "NOTHING IS WATCHING $id. It will finish, report into its status file, and tell nobody."
  fi
  lock_release "$dispatch_lock"
}
if [ "$dry" = no ] && { [ "$rec_backend" = hall ] \
     || [ "$("$BIN/reeve-backend" resolve ${backend:+--backend "$backend"} 2>/dev/null)" = hall ]; }; then
  lock_stale=$(config_get lock-stale 10)
  dispatch_lock=$(lock_acquire "dispatch-$id" 1 "$lock_stale") \
    || die "errand '$id' is being dispatched by another run right now, or by one stopped outright under ${lock_stale}s ago, holding $REEVE_HOME_D/state/.lock-dispatch-$id, which is broken once its holder is dead past that. let it finish, then look at its state before dispatching again"
  trap dispatch_exit EXIT
fi

# already out? A relaunch onto an existing copy asks more of this answer than a
# steward's does: see relaunch_refusal. A hall session still under `launching=`
# is the newest one, left by a run stopped mid launch, so it is the one read.
existing=$(meta_get "$id" launching '')
[ -n "$existing" ] || existing=$(meta_get "$id" target '')
prev_state=''
if [ -n "$existing" ]; then
  prev_state=$("$BIN/reeve-backend" call agent_state "$existing" --backend "$rec_backend" 2>/dev/null || echo unreadable)
  case $prev_state in
    alive) die "errand '$id' is already running at $existing. steer it or tear it down; do not dispatch twice onto one worktree" ;;
    unreadable) die "errand '$id' has an endpoint at $existing whose state cannot be read. investigate before dispatching again: a second hand on a live worktree is the one failure that loses work" ;;
  esac
  # A hall copy says so only once relaunch_refusal lets it through.
  [ "$hall_copy" = yes ] || warn "errand '$id' had a previous endpoint ($existing, now $prev_state), relaunching"
fi

# relaunch_refusal   why this errand's existing copy may NOT take a fresh hand,
# one line, or nothing when it may. A hall restart drops a hand's pane and
# leaves its copy and branch behind, so sending it out again from the same
# brief means a new hand in that same copy. Every condition is proof that no
# other hand is in it and that it is the copy this errand made: the record
# names the path and branch, the copy is a worktree of this holding on that
# branch (a detached one for an office with no branch), the hand that was in
# it reads missing or dead, and the errand neither was torn down nor reported
# done or failed with nothing open. And it is this reeve's to send: the session
# that owns the errand, on the backend and hall session the hand was made on,
# since a pane id read against another server proves nothing about this one.
# Anything less is today's refusal. Asked only of an errand sent out on hall.
# Status 2 when the line itself names the move: adopt, or the right backend or
# session.
relaunch_refusal() {
  local st open head top common own mine place now
  [ -z "$(meta_get "$id" tornDown '')" ] \
    || { echo "the errand was torn down"; return; }
  st=$(status_field "$id" state); open=$(status_field "$id" open)
  case $st in
    done|failed) [ "${open:-0}" -gt 0 ] 2>/dev/null \
                   || { echo "it reported $st with nothing open, and a finished errand is not sent out again"; return; } ;;
  esac
  [ -n "$existing" ] \
    || { echo "no earlier session is recorded for it, so nothing shows that no hand is working in it"; return; }
  case $prev_state in
    missing|dead) ;;
    *) echo "its earlier session at $existing reads ${prev_state:-nothing}, not missing or dead"; return ;;
  esac
  own=$(meta_get "$id" session ''); mine=$(reeve_session)
  [ -n "$mine" ] && [ "$own" = "$mine" ] \
    || { echo "it belongs to session ${own:-none}, not this one (${mine:-no id}); adopt it first: reeve-adopt $id"; return 2; }
  [ "$backend" = "$rec_backend" ] \
    || { echo "it was sent out on $rec_backend, and this dispatch is on $backend"; return 2; }
  place=$(meta_get "$id" place '')
  if [ -n "$place" ]; then
    now=$("$BIN/reeve-backend" call place --backend "$rec_backend" 2>/dev/null | head -n 1) || now=''
    [ "$now" = "$place" ] \
      || { echo "its hand was made on $rec_backend session '$place', and this reeve talks to '${now:-none}', where its session cannot be read"; return 2; }
  fi
  [ -d "$worktree" ] || { echo "it is not a directory"; return; }
  top=$(git -C "$worktree" rev-parse --show-toplevel 2>/dev/null) && top=$(cd -P "$top" && pwd -P) \
    && [ "$top" = "$(cd -P "$worktree" && pwd -P)" ] \
    || { echo "it is not the top of a git checkout"; return; }
  common=$(cd "$worktree" && cd -P "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P) \
    && [ "$common" = "$(cd "$repo" && cd -P "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P)" ] \
    || { echo "it is not a worktree of $repo"; return; }
  head=$(git -C "$worktree" symbolic-ref -q --short HEAD 2>/dev/null) || head=''
  if [ -n "$branch" ]; then
    [ "$head" = "$branch" ] \
      || { echo "it is on ${head:-a detached HEAD}, not the errand's branch '$branch'"; return; }
  else
    [ -z "$head" ] \
      || { echo "it is on branch '$head', while this errand's copy is a detached checkout"; return; }
  fi
}

# --- resolve the two axes, and refuse rather than substitute ---------------
backend=$("$BIN/reeve-backend" resolve ${backend:+--backend "$backend"}) || exit 1
harness=$("$BIN/reeve-harness" resolve ${harness:+--harness "$harness"} --office "$office") || exit 1

if ! out=$("$BIN/reeve-backend" call available --backend "$backend" 2>&1); then
  die "backend '$backend' is not usable: $out"
fi
if ! out=$("$BIN/reeve-harness" check "$harness" 2>&1); then
  if [ "$allow_unverified" = yes ]; then
    warn "dispatching on UNVERIFIED harness '$harness' because you asked. If it misbehaves, that is the reason."
    warn "$(printf '%s' "$out" | head -2 | tr '\n' ' ')"
  else
    printf '%s\n' "$out" >&2
    exit 1
  fi
fi

# --- the tier: flag, then office, then harness ------------------------------
# The office knows its own tier in most cases, so a dispatch that names neither
# flag is not a request for the richest thing available: it is a request for
# whatever this office usually costs. Resolved here rather than in the render so
# that the meta records what actually went out, origin included.
tier=$(tier_resolve "$office" model "$model")   || exit 1
model=${tier%%|*}; model_from=${tier##*|}
tier=$(tier_resolve "$office" effort "$effort") || exit 1
effort=${tier%%|*}; effort_from=${tier##*|}

# An empty flag template renders away to nothing and the hand runs on the
# harness default. Silent is the problem: the meta would record a tier the
# command line never carried. Say it once, here, while it can still be acted on.
for axis in model effort; do
  case $axis in
    model)  tier_val=$model;  tier_from=$model_from ;;
    effort) tier_val=$effort; tier_from=$effort_from ;;
  esac
  [ -n "$tier_val" ] || continue
  if [ -z "$("$BIN/reeve-harness" get "$harness" "${axis}_flag" '')" ]; then
    warn "harness '$harness' declares no ${axis}_flag, so $axis=$tier_val (from the $tier_from) will not reach the command line. The errand runs on the harness default for it."
  fi
done

# --- preflight: will this harness actually be able to start here -----------
# claude keys folder trust to the git repository, so a worktree of an untrusted
# repository raises a dialog no hand can answer. Refusing here costs a second;
# discovering it later costs a hand that looks alive forever. Under a root the
# liege trusted in config/trusted-roots, the grant is already theirs, so it is
# made here instead.
if [ "$harness" = claude ] && [ "$writes" != home ]; then
  if ! "$BIN/reeve-trust" --check "$repo" >/dev/null 2>&1; then
    if ! trust_root=$("$BIN/reeve-trust" --root-for "$repo" 2>/dev/null); then
      printf 'reeve: refusing to dispatch into %s\n' "$repo" >&2
      "$BIN/reeve-trust" --check "$repo" 2>&1 >/dev/null | sed 's/^/  /' >&2
      exit 1
    elif [ "$dry" = yes ]; then
      printf '  would grant trust: %s, under trusted root %s\n' "$repo" "$trust_root"
    elif granted=$("$BIN/reeve-trust" --grant "$repo" 2>&1); then
      info "trust granted: $repo, under trusted root $trust_root ($(printf '%s\n' "$granted" | sed -n 's/^  backup: /backup /p'))"
    else
      printf 'reeve: refusing to dispatch into %s: granting trust under %s failed\n' "$repo" "$trust_root" >&2
      printf '%s\n' "$granted" | sed 's/^/  /' >&2
      exit 1
    fi
  fi
fi

# --- the worktree ----------------------------------------------------------
# Created with git, not with the backend. `git worktree` behaves identically
# everywhere, and herdr's own worktree command defaults to its own directory
# with a random branch name, which is not the household's convention.

relaunch=no made_copy=no made_branch=no
if [ "$writes" = home ]; then
  cwd=$REEVE_HOME_D          # the steward works in the home, it has no worktree
elif [ "$hall_copy" = yes ]; then
  # A copy already there: the hand that was in it is gone, or this is refused.
  # A reason that carries its own move (status 2: adopt it, or dispatch from
  # the right backend or session) is not followed by the generic one, which
  # would contradict it.
  why=$(relaunch_refusal); [ $? -eq 2 ] && why_next='' || why_next='. pick another errand id or clean that up first'
  [ -z "$why" ] || die "worktree path already exists: $worktree, and it cannot take a fresh hand: $why$why_next"
  warn "errand '$id' had a previous endpoint ($existing, now $prev_state), relaunching"
  relaunch=yes
  cwd=$worktree
  info "relaunching onto the existing copy $worktree (${branch:-detached}): its session $existing reads $prev_state"
  [ "$dry" = yes ] && printf '  would keep: the copy, its branch, its commits and any uncommitted work, untouched\n'
  # A dead session is a shell still open in the copy, under the hand's own
  # label. Closed first, by its identity, so the liege never sees two tabs of
  # one hand. One that will not close may still be starting a hand, so that is
  # a refusal, never a second endpoint beside it.
  if [ "$prev_state" = dead ]; then
    run "$BIN/reeve-backend" call kill "$existing" --backend "$rec_backend" \
      || die "errand '$id' had a session at $existing that reads dead and could not be closed. look at it before dispatching again: it may still be starting a hand in $worktree"
  fi
else
  [ -n "$worktree" ] || die "errand '$id' has no worktree path recorded"
  [ -e "$worktree" ] && die "worktree path already exists: $worktree. pick another errand id or clean that up first"
  git -C "$repo" rev-parse --verify --quiet "$base" >/dev/null \
    || die "base ref '$base' does not exist in $repo"
  if [ -n "$branch" ]; then
    git -C "$repo" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null \
      && die "branch '$branch' already exists in $repo. git refuses the same branch in two worktrees, which is the collision guard; pick another errand id"
  fi
  run mkdir -p "$(dirname "$worktree")"
  if [ -n "$branch" ]; then
    run git -C "$repo" worktree add "$worktree" -b "$branch" "$base" || die "git worktree add failed"
    made_copy=yes made_branch=yes
    # The household made this branch, said the moment it exists and before
    # anything below can fail. `--prove-landed` counts only a record carrying
    # it, and only for the ref born then: a brief alone names a branch that may
    # be the liege's own, and a later branch of the same name is another ref.
    # No identity to record means the grant never covers it, said here once.
    if [ "$dry" = no ]; then
      made=$(branch_birth "$repo" "$branch")
      if [ -n "$made" ] && [ "${made%% *}" = "$(git -C "$repo" rev-parse --verify --quiet \
           "refs/heads/$branch^{commit}" 2>/dev/null)" ]; then
        meta_set "$id" branchMade "$made"
      else
        warn "no reflog entry for '$branch' in $repo, so the proven delete will never cover it"
      fi
    fi
  else
    # read-only offices get a detached checkout so an investigation never
    # leaves a branch behind that nobody will ever merge
    run git -C "$repo" worktree add --detach "$worktree" "$base" || die "git worktree add failed"
    made_copy=yes
  fi
  cwd=$worktree

  # Optional warm-up. A fresh worktree has no ignored files: no installed
  # dependencies, no build output, no env file. On this machine that costs
  # almost nothing, because pnpm hardlinks from a content addressed store and a
  # full install in a cold worktree measured 184ms. Other holdings will not be
  # so lucky, so a holding may declare `setup:` in manors.md and dispatch runs
  # it here, before the hand ever sees the directory.
  #
  # This is deliberately not a pool of pre-warmed leased worktrees. A pool buys
  # back only this step, and costs a cwd discovery race, residue leaking between
  # errands, paths that ignore the household's convention, and another tool to
  # keep working. Run the setup command instead.
  setup=$(holding_field "$holding" setup '')
  if [ -n "$setup" ]; then
    info "warming the copy: $setup"
    if [ "$dry" = yes ]; then
      printf '  would run: (cd %s && %s)\n' "$worktree" "$setup"
    elif ! ( cd "$worktree" && eval "$setup" ) >"$(errand_dir "$id")/setup.log" 2>&1; then
      warn "the setup command failed. Its output is in $(errand_dir "$id")/setup.log"
      warn "dispatching anyway: the hand is told to expect an unset copy, and a"
      warn "setup failure is often the very thing worth investigating."
    fi
  fi
fi

# --- endpoint and launch ---------------------------------------------------
# The label names the office and the reeve that sent the hand, so the liege
# reads `Scout of Aldric` on a tab and knows whose it is. The errand id is
# on the line under it, from the terminal title. config/hand-label overrides
# the shape, with {reeve} {Office} {office} {id}; a reeve with no name gets
# `Scout: fix-auth`.
#
# The name is the one the brief recorded, the reeve that briefed the errand, and
# else this session's stored name, read and never assigned: a dry run promises
# to change nothing.
#
# The label is presentation only. An errand's meta records the target the
# backend returned, never the label, and nothing ever finds a session by it, so
# sessions already running under an older label keep working untouched. It is
# passed as one quoted argument, so its spaces are safe, and a dry run prints it
# inside double quotes, which hand_label keeps out of it.
rname=$(meta_get "$id" reeve '')
valid_reeve_name "$rname" || rname=$(reeve_name_peek)
label=$(hand_label "$office" "$id" "$rname")

# The hand opens inside its reeve's group, the workspace labelled with the
# reeve's own name, as a tab. The group is this session's,
# so it takes this session's name, read and never assigned. No session, no
# name, a backend with no ensure_group, or one that failed: no group, and the
# hand opens where it always did. A dry run prints the call and makes none.
group=''
gsid=$(reeve_session); gname=$(reeve_name_peek)
if [ -n "$gsid" ] && [ -n "$gname" ]; then
  if [ "$dry" = yes ]; then
    # The same arguments reeve_group would pass: the known id, quoted and
    # possibly empty, then each id another reeve holds.
    gargs=$(group_args "$gsid" "$backend" "$gname")
    gknown=$(printf '%s\n' "$gargs" | head -n 1)
    gheld=$(printf '%s\n' "$gargs" | sed 1d | tr '\n' ' ' | sed 's/ $//')
    gline="$gname"
    [ -n "$gknown$gheld" ] && gline="$gline \"$gknown\""
    [ -n "$gheld" ] && gline="$gline $gheld"
    printf '  would run: reeve-backend call ensure_group %s --backend %s\n' "$gline" "$backend"
    group='<group>'
  elif ! group=$(reeve_group "$BIN" "$backend" "$gname"); then
    group=''
    warn "backend '$backend' gave $gname no group, so this hand opens on its own"
  fi
fi
# rollback_copy   undo exactly the copy and branch this run made, when no
# endpoint could be opened for it. On hall this fails after the copy exists (a
# server still running a build from before --no-agent-resume refuses every
# create), and a copy with no session recorded never relaunches, so the id was
# stuck for good, with an empty branch behind it. Nothing has run in the copy
# but setup. Never --force and never -D: a copy git will not remove as clean, or
# a branch ahead of its base, is left as it is and said. A copy or branch that
# was there before this run is never touched. herdr is left as it was.
#
# The branch goes first, from inside the copy with HEAD detached at its tip, so
# `branch -d` measures it against itself: from the holding it is measured
# against whatever the primary checkout has out, and refuses an empty branch
# whose base that checkout lacks. The copy is checked clean beforehand, so a
# copy git would not remove keeps its branch too.
rollback_copy() {
  local ahead
  [ "$backend" = hall ] && [ "$made_copy" = yes ] || return 0
  if [ "$made_branch" = yes ]; then
    ahead=$(git -C "$repo" rev-list --count "$base..refs/heads/$branch" 2>/dev/null) || ahead=''
    [ "$ahead" = 0 ] || {
      warn "the copy $worktree and branch '$branch' were kept: the branch is ${ahead:-not readably} ahead of $base, so they are not this dispatch's alone to remove"
      return 0; }
  fi
  [ -z "$(git -C "$worktree" status --porcelain 2>/dev/null || echo unreadable)" ] || {
    warn "the copy $worktree and its branch were kept: git would not remove the copy as clean. look at it before dispatching '$id' again"
    return 0; }
  if [ "$made_branch" = yes ]; then
    if git -C "$worktree" checkout -q --detach && git -C "$worktree" branch -d "$branch" >/dev/null; then
      meta_set "$id" branchMade ''
    else
      git -C "$worktree" checkout -q "$branch" 2>/dev/null || :
      warn "the copy $worktree and branch '$branch' were kept, with no commits of its own: git would not delete the branch. a dispatch of '$id' refuses until it is gone"
      return 0
    fi
  fi
  git -C "$repo" worktree remove "$worktree" || {
    warn "the copy $worktree was kept${branch:+, though its empty branch '$branch' was removed}: git would not remove the copy as clean. look at it before dispatching '$id' again"
    return 0; }
  warn "removed what this dispatch made, the copy${branch:+ and branch '$branch'}, so '$id' can be dispatched again once the backend is fixed"
}

if [ "$dry" = yes ]; then
  printf '  would run: reeve-backend call create_endpoint %s "%s"%s --backend %s\n' \
    "$cwd" "$label" "${group:+ \"$group\"}" "$backend"
  target='<target>'
else
  target=$("$BIN/reeve-backend" call create_endpoint "$cwd" "$label" ${group:+"$group"} --backend "$backend") \
    || { rollback_copy; die "could not open a session endpoint on backend '$backend'"; }
  [ -n "$target" ] || { rollback_copy; die "backend '$backend' returned an empty target"; }
fi

# A sibling is a REFERENCE, so the grant is paired with a deny that keeps it one.
# `--add-dir` grants read and write together and there is no read-only form, so
# the write half is taken back by a path-scoped deny written into this errand's
# own settings file below. Verified against the installed harness: deny is
# evaluated before allow in every scope and overrides `defaultMode: acceptEdits`,
# and `Edit(path)` is one of only two rules the harness actually consults, so
# this is enforcement rather than an office-text request.
#
# Registered checkouts, never worktrees: a sibling is somewhere to read, not
# somewhere this errand has any business working.
sib_args=()
manor=$(meta_get "$id" manor '')
for sib in $(manor_holdings "$manor"); do
  [ "$sib" = "$holding" ] && continue
  sib_path=$(holding_field "$sib" path '') || continue
  [ -n "$sib_path" ] && [ -d "$sib_path" ] || continue
  # The launch line is one string the backend word-splits, so a path holding
  # whitespace cannot survive the trip and would arrive as two broken
  # arguments. Said out loud and skipped rather than rendered wrong: a hand
  # would otherwise start believing it had a grant it does not have.
  case $sib_path in
    *[[:space:]]*)
      warn "holding '$sib' sits at a path containing whitespace, so it cannot be granted: $sib_path"
      continue ;;
  esac
  sib_args+=(--add-dir "$sib_path")
done
[ ${#sib_args[@]} -gt 0 ] \
  && info "granting read access to $(( ${#sib_args[@]} / 2 )) other holding(s) in manor '$manor'"

# Per-errand permissions, copied from the office's own declaration into the
# errand directory. Copied rather than referenced so that changing an office
# later cannot retroactively alter what an errand already in flight may do.
#
# Through run(), like every other mutation here, because --dry-run promises to
# change nothing and this was the one write that escaped it: a dry run left a
# settings.json behind and then printed "nothing was changed". The variable still
# carries the path afterwards, so the launch line a dry run prints is unchanged;
# reeve-harness render only substitutes that path into a flag and never reads the
# file, so the line stays true about what would run.
office_settings="$REEVE_ROOT_D/offices/$office.settings.json"
errand_settings="$(errand_dir "$id")/settings.json"
if [ -f "$office_settings" ]; then
  run cp "$office_settings" "$errand_settings"
else
  warn "office '$office' declares no settings.json, the hand will run on harness defaults and may stall on a permission prompt"
  errand_settings=''
  # The sibling grant and the deny that bounds it are one thing, so they travel
  # together or not at all. With nowhere to write the deny, `--add-dir` would
  # hand out read AND write into another holding's real checkout, which is hard
  # rule 2 broken by an office that merely forgot a file.
  if [ ${#sib_args[@]} -gt 0 ]; then
    warn "  so the manor grant is withheld: there is nowhere to write the deny that keeps it read-only"
    sib_args=()
  fi
fi

# Take the write half of every sibling grant back, in this errand's own copy of
# the office settings. Written here rather than declared in the office, because
# the paths are not known until an errand names its manor.
#
# `//abs/path` with TWO leading slashes is the absolute form. One slash anchors
# the pattern at the settings file's own directory instead, which would silently
# match nothing and leave the grant unguarded. The rule is `Edit(...)`: the
# harness consults `Edit(path)` and `Read(path)` and no others, and accepts a
# `Write(path)` or `Glob(path)` rule while never once checking it.
#
# Bash is a separate matter and is not narrowed by this. It never was: a hand
# has always been able to write anywhere a shell can reach, which is why
# offices/README.md says a hand that writes where it should not is caught by
# teardown rather than prevented. This closes the tool-shaped route that the
# grant itself opens, and claims nothing beyond that.
# Checked BEFORE anything is opened. This used to run after create_endpoint, so
# a machine without python3 got a session nobody could reach: the die fired
# before meta_set recorded the target, and an endpoint with no recorded target
# cannot be found or killed by anything in the household.
if [ ${#sib_args[@]} -gt 0 ] && [ -n "$errand_settings" ]; then
  command -v python3 >/dev/null 2>&1 \
    || die "the manor grant needs python3 to write its deny rules, and it is not on PATH. install it, or unregister the sibling holdings in manors.md"
fi

if [ -n "$errand_settings" ] && [ ${#sib_args[@]} -gt 0 ] && [ "$dry" = no ]; then
  sib_only=()
  for a in ${sib_args+"${sib_args[@]}"}; do
    [ "$a" = "--add-dir" ] || sib_only+=("$a")
  done
  python3 - "$errand_settings" ${sib_only+"${sib_only[@]}"} <<'DENY' \
    || die "could not write the sibling deny rules into $errand_settings"
import json, sys, os
path, dirs = sys.argv[1], sys.argv[2:]
with open(path) as fh:
    cfg = json.load(fh)
perms = cfg.setdefault("permissions", {})
deny = perms.setdefault("deny", [])
for d in dirs:
    # Two leading slashes is the absolute form. One would anchor the pattern at
    # this settings file's own directory and match nothing.
    rule = "Edit(//%s/**)" % os.path.abspath(d).lstrip("/")
    if rule not in deny:
        deny.append(rule)
tmp = path + ".new"
with open(tmp, "w") as fh:
    json.dump(cfg, fh, indent=2)
    fh.write("\n")
os.replace(tmp, path)
DENY
fi

# The rest of the manor, so a hand can read the repositories its own question
# actually spans. A manor is one project that may span several repositories, and
# until now a hand could reach its own copy and its errand directory and nothing
# else. A scout asked why the web app mishandles a response from the API could
# not open the API repository at all, and because it stalls INSIDE a tool call
# it never appends `blocked:`: its last line stays `working:` and the watch
# reads it as a healthy hand. That is the same silent class of stall the MCP
# flags exist to close, arriving through a different door.
#

# --- the household browser -------------------------------------------------
# A hand whose office allows the browser gets the household's own: one MCP
# server that launches its own headless Chrome with a throwaway profile, and
# nothing else, since it rides next to the flags that shut every other MCP tool
# off. The allow rule is in the office's settings, copied above, so no consent
# dialog can stand in front of it. See offices/README.md.
#
# Never a reason to refuse. A machine with no Chrome, or a harness with no way
# to pass the server, sends the hand out without it, says so here, and the hand
# reports what it could not check rather than stalling over it.
browser_cfg='' browser_say=''
if browser_wanted "$office"; then
  if [ -z "$("$BIN/reeve-harness" get "$harness" browser_flag '')" ]; then
    browser_say="none: harness $harness declares no browser_flag"
  elif chrome=$(browser_check); then
    browser_cfg="$(errand_dir "$id")/browser.json"
    run browser_config_write "$browser_cfg" "$chrome"
    browser_say="$BROWSER_SERVER, headless and isolated, launching $chrome"
  else
    browser_say="none: $chrome"
  fi
  case $browser_say in
    none:*)
      warn "no household browser for this hand: ${browser_say#none: }"
      warn "  it will verify nothing visually, and its done line will say so" ;;
  esac
fi

cmdline=$(REEVE_BACKEND=$backend "$BIN/reeve-harness" render "$harness" "$brief" --hand "$id" \
            ${errand_settings:+--settings "$errand_settings"} \
            ${browser_cfg:+--browser "$browser_cfg"} \
            $([ "$relaunch" = yes ] && echo --relaunch) \
            ${sib_args+"${sib_args[@]}"} \
            ${model:+--model "$model"} ${effort:+--effort "$effort"}) \
  || die "could not render a launch line for harness '$harness'"

relaunch_note='relaunched onto existing copy after its session was lost'
if [ "$dry" = yes ]; then
  printf '  would run: reeve-backend call launch %s <cmdline> --backend %s\n' "$target" "$backend"
  [ -n "${REEVE_NO_CARETAKER:-}" ] \
    || printf '  would run: bin/reeve-sentry --caretaker, detached, appending to %s\n' \
              "$REEVE_HOME_D/state/sentry.log"
  [ "$relaunch" = yes ] \
    && printf '  would run: reeve-say %s working %s\n' "$(status_file "$id")" "'$relaunch_note'"
  printf '\ncmdline:\n  %s\n' "$cmdline"
  printf '\ntier: model %s, effort %s\n' "$(tier_say "$model" "$model_from")" "$(tier_say "$effort" "$effort_from")"
  [ -n "$browser_say" ] && printf '\nbrowser: %s\n' "$browser_say"
  printf '\nnothing was changed.\n'
  exit 0
fi

# On hall a dispatch again relaunches into the copy, so the new session is
# recorded before the launch: a retry then reads THIS session's state, alive if
# the hand came up after all, never the lost one's. It is recorded under
# `launching=`, which only dispatch reads, and moves to `target=` once the
# launch returns: until the harness is up, hall reads the pane as a shell with
# no agent, and a watch reading `target=` would call a starting hand lost. A
# launch that reports failure may still be starting the hand, so the endpoint
# this run opened is closed, by its identity, and a retry finds it missing and
# sends out one hand. One that will not close stays recorded, and a retry
# refuses on it. herdr's order is left as it was.
if [ "$backend" = hall ]; then
  meta_set "$id" backend "$backend"
  meta_set "$id" launching "$target"; launch_open=$target
  if ! "$BIN/reeve-backend" call launch "$target" "$cmdline" --backend "$backend"; then
    if "$BIN/reeve-backend" call kill "$target" --backend "$backend"; then
      meta_set "$id" target "$target"; meta_set "$id" launching ''; launch_open=''
      die "endpoint opened at $target but the launch line could not be submitted. that session was closed and is recorded, so dispatching '$id' again sends out one fresh hand into $cwd"
    fi
    meta_set "$id" target "$target"; meta_set "$id" launching ''; launch_open=''
    die "endpoint opened at $target but the launch line could not be submitted, and that session could not be closed. it is recorded as the errand's session: look at it before retrying, it may still be starting a hand in $cwd"
  fi
else
  "$BIN/reeve-backend" call launch "$target" "$cmdline" --backend "$backend" \
    || die "endpoint opened at $target but the launch line could not be submitted. investigate before retrying: the worktree exists and a second attempt could start two hands on it"
fi

meta_set "$id" backend "$backend"
# Which of the backend's sessions the hand is in, for bin/reeve-listing, when
# the backend can say: hall can, herdr has no `place`, so a herdr record reads
# exactly as before. One left from a relaunch on another backend is blanked.
hand_place=$("$BIN/reeve-backend" call place --backend "$backend" 2>/dev/null | head -n 1) || hand_place=''
if [ -n "$hand_place" ]; then meta_set "$id" place "$hand_place"
elif [ -n "$(meta_get "$id" place '')" ]; then meta_set "$id" place ''
fi
meta_set "$id" harness "$harness"
meta_set "$id" target "$target"
[ "$backend" = hall ] && meta_set "$id" launching ''
meta_set "$id" cwd "$cwd"
# The value and where it came from, one key each. No second copy of the value:
# an absent model key with model_from=harness is the harness deciding, which is
# the one case where the household does not know the value and must not pretend.
[ -n "$model" ]  && meta_set "$id" model "$model"
[ -n "$effort" ] && meta_set "$id" effort "$effort"
meta_set "$id" model_from "$model_from"
meta_set "$id" effort_from "$effort_from"
meta_set "$id" dispatched "$(date +%Y-%m-%dT%H:%M:%S)"
# What the hand was sent out with, so a done line saying it verified nothing
# visually can be checked against the reason dispatch already knew. Blank for
# an office with no browser, and on a relaunch that no longer has one.
meta_set "$id" browser "$browser_say"
# The opt-out belongs to the errand, not to this process. Skipping the caretaker
# alone kept nothing up: any other dispatch's caretaker on this home freed the
# hand within one poll of it finishing. Recorded here, it is read by every
# cleaner, see kept() in bin/reeve-sentry. Blanked on a dispatch without it, so a
# relaunch of the same errand is tended again rather than kept by the last one.
if [ -n "${REEVE_NO_CARETAKER:-}" ]; then meta_set "$id" keep REEVE_NO_CARETAKER
else meta_set "$id" keep ''; fi
touch "$(status_file "$id")"
# Recorded in full: a signal from here on leaves the trap nothing to record.
launch_open=''
# Said in the errand's own log, so the reeve and any reviewer read that this
# hand started in a copy that was already worked in.
[ "$relaunch" = yes ] && "$BIN/reeve-say" "$(status_file "$id")" working "$relaunch_note"
# The new session is recorded and launched: a dispatch after this reads it.
if [ -n "$dispatch_lock" ]; then lock_release "$dispatch_lock"; dispatch_lock=''; fi

# --- the caretaker ---------------------------------------------------------
# A hand does not exit itself, so a finished one sits at a prompt holding a
# session until something tears it down, and until now the only thing that ever
# did was a reeve running bin/reeve-sentry in the foreground. Terminate or
# refresh that session and there is no cleaner at all: every hand already out
# idles forever. Cleaning up does not need a live reeve, because
# bin/reeve-teardown owns the safety rules and they are mechanical, so a
# dispatch starts a caretaker of its own. Notification is untouched and still
# needs a reeve: the status files are the durable truth and a fresh session
# reads every errand at startup.
#
# Started unconditionally rather than after a check of its own: the lock inside
# reeve-sentry is the single owner of "is one already running", and a second
# start is a quiet no-op there. Two answers to that question would drift.
#
# Below the dry run's exit, not guarded by it, so the promise that a dry run
# changes nothing is kept by construction rather than by a condition somebody
# has to remember. Never fatal either: a dispatch that worked is not a failure
# because the cleaner did not come up.
#
# It is also half of what will ever report this hand. A caretaker cleans up
# silently, but on the way it leaves the terminal line in the owning session's
# wake file, which bin/reeve-sentry and bin/reeve-status deliver. So a dispatch
# that leaves no caretaker AND no foreground watch leaves a hand that will
# finish into silence, and that is checked and said out loud below rather than
# assumed: reporting a clean dispatch over a household with nothing watching is
# the exact shape of the bug this guard exists for.
caretaker_log="$REEVE_HOME_D/state/sentry.log"
caretaker_advice="Finished hands will keep their sessions until a reeve runs bin/reeve-sentry."
caretaker_started=no
if [ -n "${REEVE_NO_CARETAKER:-}" ]; then
  :
elif [ ! -x "$BIN/reeve-sentry" ]; then
  warn "no caretaker started: $BIN/reeve-sentry is not executable. $caretaker_advice"
elif ! { mkdir -p "$(dirname "$caretaker_log")" && : >> "$caretaker_log"; } 2>/dev/null; then
  # The guard writes rather than asks. `mkdir -p` on a directory that already
  # exists succeeds whatever its permissions, so the older form could not tell
  # an unwritable state/ from a healthy one and said nothing at all about the
  # one case it was there to name: the caretaker simply never appeared, and the
  # liege was told a dispatch had gone perfectly. Appending to the log is the
  # first thing the caretaker itself does, so doing it here asks exactly the
  # question that matters, and leaves behind exactly the empty file the start
  # below would have created anyway.
  warn "no caretaker started: $caretaker_log cannot be written. $caretaker_advice"
else
  # nohup, both streams redirected and stdin closed, so it outlives this session
  # and holds none of its terminal open. A caretaker still attached to the
  # dispatching shell dies with that shell, which is the whole defect being
  # fixed here. REEVE_HOME is passed explicitly rather than inherited: this
  # process resolved it once already and the caretaker must tend that same home.
  # The poll seam is overridable only so the test suite can drive it.
  REEVE_HOME="$REEVE_HOME_D" nohup "$BIN/reeve-sentry" --caretaker \
      ${REEVE_CARETAKER_POLL:+--poll "$REEVE_CARETAKER_POLL"} \
      >>"$caretaker_log" 2>&1 </dev/null &
  { disown; } 2>/dev/null || :
  caretaker_started=yes
fi

# Did anything actually come up. Starting a process and never looking is how a
# dispatch reported perfect success over a household where nothing was watching:
# the launch line was printed, the caretaker was started, and the liege was told
# it had all gone well. A live lock is the proof, and it is the right proof in
# both directions, because a second caretaker exits 0 without creating anything
# while the first one's lock stands.
#
# Bounded and short. Taking the lock is the first thing a caretaker does, so a
# second is generous, and waiting longer than that would put a delay on every
# dispatch to catch a case that is already lost.
if [ "$caretaker_started" = yes ]; then
  n=0
  while [ "$n" -lt 20 ] && ! caretaker_live; do sleep 0.05; n=$((n + 1)); done
fi

info "dispatched $id"
info "  office   $office on $harness via $backend"
info "  tier     model $(tier_say "$model" "$model_from"), effort $(tier_say "$effort" "$effort_from")"
info "  copy     $cwd"
[ "$relaunch" = yes ] && info "  relaunch the copy and its work were kept, the last hand's session was $prev_state"
[ -n "$branch" ] && info "  branch   $branch (from $base)" || info "  branch   none, detached at $base"
info "  running  $target"
[ -n "$browser_say" ] && info "  browser  $browser_say"
info "  status   $(status_file "$id")"

# The last word, and loud, because a hand nobody will report is worse than a
# hand that failed to launch: it looks exactly like a working one, forever. A
# caretaker leaves the terminal line in this session's wake file and a
# foreground watch reads the status file directly, so either one is a route
# home. Neither is the failure.
if caretaker_live; then
  :
elif watch_live; then
  info "  watching a foreground sentry, no caretaker needed"
else
  warn "NOTHING IS WATCHING $id. It will finish, report into its status file, and tell nobody."
  warn "  no caretaker holds $(lock_marker) and no foreground watch has published a marker."
  warn "  start one now: bin/reeve-sentry"
fi
