#!/usr/bin/env bash
# Generate the per-harness skill adapters from one table.
#
# Usage: reeve-adapters [--check]
#
# The method file `skills/<name>/<name>.md` is the source of truth and is
# vendor neutral. An adapter is a thin wrapper that makes one harness discover
# and load it. Generating them means an adapter cannot drift from its method,
# and adding a harness is a row here rather than eight hand written files.
#
# The claude adapter is written to `skills/<name>/SKILL.md`, which is the one
# path that serves both ways of finding it: this repo's own .claude/skills links
# to the skill directory, and a plugin manifest at the repository root discovers
# exactly that layout. One generated file, so the two can never drift apart.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"

case ${1:-} in -h|--help) print_help "$0"; exit 0 ;; esac
check=no
[ "${1:-}" = "--check" ] && check=yes

# name|user-invocable|one-line description
SKILLS="
start|true|Become the reeve in this session: load the contract, take up the errands in flight. Run this first, from any directory.
court|true|Recap where the household stands, then settle whatever is waiting on the liege, one question at a time.
muster|true|Full accounting of every errand in flight, blocked ones first.
errand|true|Send work out to a hand. Load before dispatching anything.
inscribe|true|Record something the liege told you to remember, in the right scope and tier.
strike|true|Retire a fact the liege says to forget, to the cold archive.
recall|true|Read back what the household remembers, scoped, with dates.
glean|true|End of session sweep: harvest what was actually learned, then report the budget.
self-update|true|Change how every reeve behaves, not just this one, by updating the contract itself.
survey|true|Meet an unfamiliar repository and propose which project it belongs to.
handoff|true|Write down the part of this session that will not survive a reset, so the next reeve resumes instead of restarting.
memory|false|How the reeve decides what to remember and where. Load before writing any memory file.
"

n=0; drift=0
printf '%s\n' "$SKILLS" | while IFS='|' read -r name inv desc; do
  [ -n "$name" ] || continue
  method="$REEVE_ROOT_D/skills/$name/$name.md"
  [ -f "$method" ] || { warn "no method file for '$name' at $method"; continue; }
  out="$REEVE_ROOT_D/skills/$name/SKILL.md"
  mkdir -p "$(dirname "$out")"
  tmp="$out.$$"
  {
    printf -- '---\n'
    printf 'name: %s\n' "$name"
    printf 'description: %s\n' "$desc"
    printf 'user-invocable: %s\n' "$inv"
    printf 'allowed-tools: Bash, Read, Glob, Grep, Write, Edit\n'
    printf -- '---\n\n'
    printf '<!-- GENERATED by bin/reeve-adapters. Edit skills/%s/%s.md instead. -->\n\n' "$name" "$name"
    cat "$method"
  } > "$tmp"
  if [ "$check" = yes ]; then
    if [ -f "$out" ] && cmp -s "$tmp" "$out"; then rm -f "$tmp"
    else rm -f "$tmp"; printf 'DRIFT: %s is stale or missing\n' "$out"; fi
  else
    mv "$tmp" "$out"
    # Project scoped discovery, for a session started in this clone. The link
    # is relative and committed, so it travels with a clone and needs no install
    # step. Installing the plugin is the other way in, for a session started
    # anywhere else, and both land on this same SKILL.md.
    mkdir -p "$REEVE_ROOT_D/.claude/skills"
    ln -sfn "../../skills/$name" "$REEVE_ROOT_D/.claude/skills/$name"
    printf 'generated %s\n' "${out#"$REEVE_ROOT_D"/}"
  fi
done
