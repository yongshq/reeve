#!/usr/bin/env bash
# Write and find reeve handoffs. Single owner of the handoff format.
#
# Usage:
#   bin/reeve-handoff new <manor>      scaffold one, print its path
#   bin/reeve-handoff newest [manor]   path of the most recent, if any
#   bin/reeve-handoff list [manor]
#
# A handoff exists because of a specific gap. Nearly everything the reeve knows
# already survives a reset: errand records, briefs, reports, status logs and
# memory are all on disk, and `bin/reeve-status --all` rebuilds the fleet from them.
# What does NOT survive is the conversation: the goal above the individual
# errands, threads raised but not yet dispatched, and decisions made in chat
# that never reached a brief. That is about one page, and this is where it goes.
#
# The factual sections are filled in from disk. The judgement sections are left
# as seams for the reeve, the same way a brief leaves {INTENT} and {SPEC},
# because a handoff written by a script is a status report and not a handoff.
#
# For the same reason `## In flight` carries a count and the live rows only, not
# the whole fleet table: an errand that finished and was cleaned up is already
# rebuilt by `bin/reeve-status --all`, and copying it in here buries the part that
# is not.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reeve-lib.sh"
BIN=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

handoffs_dir() { printf '%s/handoffs\n' "$REEVE_HOME_D"; }

# Which errands the session was still holding.
#
# Live means NOT terminal-and-cleaned-up. A finished errand whose copy and
# session are gone is pure record: it rebuilds from disk and listing it here
# only buries the four things a handoff exists to carry. A finished errand that
# still has a branch or a copy is not that, because somebody still has to decide
# what happens to it, so it stays.
#
# Both halves are asked of their existing owner. status_reconcile in
# reeve-lib.sh is the only thing allowed to turn a status log into a verdict,
# and the tornDown stamp is written by reeve-teardown when it removes a copy.
# Nothing is reconciled a second time here.
live_ids() {
  ls "$REEVE_HOME_D/state"/*.meta 2>/dev/null | while read -r f; do
    i=$(basename "$f" .meta)
    case $(status_field "$i" state) in
      done|failed) [ -z "$(meta_get "$i" tornDown '')" ] || continue ;;
    esac
    printf '%s\n' "$i"
  done
}

# The `## In flight` block, whole. The rows come from `reeve-status --all`
# verbatim, header included, so this file never learns to render an errand on
# its own: it only drops the rows live_ids did not name.
in_flight() {
  local ids n table line first
  ids=$(live_ids)
  n=$(printf '%s' "$ids" | grep -c . 2>/dev/null) || n=0
  n=$(printf '%s' "$n" | tr -d '[:space:]'); n=${n:-0}

  if [ "$n" -eq 0 ]; then
    printf 'Nothing still live at the time of writing. `bin/reeve-status --all` is the live truth.\n\n'
    return 0
  fi

  printf '%s errand(s) still live at the time of writing. Finished and cleaned up ones are\n' "$n"
  printf 'left out: they rebuild from disk, and `bin/reeve-status --all` is the live truth for\n'
  printf 'all of them.\n\n'
  table=$("$BIN/reeve-status" --all 2>/dev/null) || table=''
  printf '```\n'
  printf '%s\n' "$table" | while IFS= read -r line; do
    first=${line%% *}
    if [ "$first" = ERRAND ] || lines_has "$first" "$ids"; then printf '%s\n' "$line"; fi
  done
  printf '```\n\n'
}

cmd=${1:-}; manor=${2:-}

case $cmd in
  list)
    d=$(handoffs_dir); [ -d "$d" ] || { info "no handoffs yet"; exit 0; }
    ls "$d"/${manor:+$manor-}*.md 2>/dev/null | sort -r | while read -r f; do
      printf '  %-44s %s\n' "$(basename "$f")" "$(grep -m1 '^- \*\*Status:\*\*' "$f" 2>/dev/null | sed 's/.*Status:\*\* //')"
    done
    ;;

  newest)
    d=$(handoffs_dir); [ -d "$d" ] || exit 1
    f=$(ls "$d"/${manor:+$manor-}*.md 2>/dev/null | sort | tail -1)
    [ -n "$f" ] || exit 1
    printf '%s\n' "$f"
    ;;

  new)
    [ -n "$manor" ] || die "which manor? bin/reeve-handoff new <manor>"
    d=$(handoffs_dir); mkdir -p "$d"
    stamp=$(date +%Y-%m-%d-%H%M)
    f="$d/$manor-$stamp.md"
    [ -e "$f" ] && die "a handoff for this minute already exists: $f"

    prev=$("$0" newest "$manor" 2>/dev/null || true)

    {
      printf '# Handoff: {TITLE}\n\n'
      printf -- '- **Written:** %s · **Manor:** %s · **Reeve home:** `%s`\n' \
        "$(date '+%Y-%m-%d %H:%M')" "$manor" "$REEVE_HOME_D"
      printf -- '- **Status:** open\n'
      printf -- '- **Supersedes:** %s\n' "$([ -n "$prev" ] && basename "$prev" || printf '_None._')"
      printf -- '- **Resume with:** {RESUME}\n\n'

      printf '## The goal\n\n'
      printf '{GOAL}\n\n'

      printf '## In flight\n\n'
      in_flight

      printf '## Open with the liege\n\n'
      printf 'Raised in conversation, not yet an errand. This is the part that does not survive a\n'
      printf 'reset on its own, so be specific: a vague line here is the same as no line.\n\n'
      printf '{OPEN}\n\n'

      printf '## Decided this session\n\n'
      printf 'Choices made in chat that are not yet written into a brief, a memory entry or the\n'
      printf 'repository. Anything durable enough to outlive the next few days belongs in memory\n'
      printf 'instead, through `/inscribe`, and should be listed here only as a pointer.\n\n'
      printf '{DECIDED}\n\n'

      printf '## Next\n\n'
      printf 'The specific next action, and whose move it is. Never leave this as "continue".\n\n'
      printf '{NEXT}\n'
    } > "$f"

    info "handoff scaffolded: $f"
    info "seams to fill: {TITLE} {RESUME} {GOAL} {OPEN} {DECIDED} {NEXT}"
    # `[ ... ] && info ...` here would make a missing predecessor the script's
    # own exit status, because this is the last command in the arm.
    if [ -n "$prev" ]; then info "supersedes: $(basename "$prev")"; fi
    ;;

  ''|-h|--help) print_help "$0" ;;
  *) die "unknown command '$cmd'. try: new, newest, list" ;;
esac
